{
    // Server listener for Docker: bind all interfaces inside the container (host port mapping decides exposure)
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": 9960,
            "https": false,
            "use_old_tls": true,
            "key": "bf.pem",
            "cert": "bf.crt"
        }
    ],
    // Drogon app configuration
    "app": {
        // One IO thread per vCPU (4 since 2026-10-19): replies are encrypted and gzipped on
        // these threads, not on the single SQLite thread (ticket #71).
        "number_of_threads": 4,
        "log": {
            "log_level": "INFO"
        },
        // session
        "enable_session": true,
        "session_timeout": 1200,
        // document root
        "document_root": "./game_content",
        // game_content is mounted read-only; keep drogon's upload scratch dir elsewhere
        "upload_path": "/tmp/bf-uploads"
    },
    // Configure sqlite database
    "db_clients": [
        {
            "name": "default", // DO NOT CHANGE THIS NAME OR THE CODE MIGHT NOT WORK!!
            "rdbms": "sqlite3", // you can use pgsql or mysql if you want a complex deploy
            "host": "127.0.0.1",
            "port": 0,
            "dbname": "gme",
            "user": "",
            "passwd": "",
            "is_fast": false, // use DbClient
            "connection_numbr": 1,
            "filename": "/data/gme.sqlite"
        }
    ],
    "plugins": [
        {
            // main plugin: the game server (do not remove this one)
            "name": "GimuServer",
            "dependencies": [],
            "config": {
                "extra_log": { 
                    "enable": false, // per-request dump files are for local debugging only
                    "directory": "/data/log",
                    "http_log_prefix": "http_log",
					"http_log_suffix": ".log",
                    "dlc_error_log_name": "dlc_404.log"
                },
                "server": {
                    "wallpaper_banner": "/wallpaper/title5_logo.jpg", // login wallpaper (regular title; title_logo20151028 = Halloween 2015)
                    "game_version": 21900, // game version (must be this one or it might cry about an update)
                    // Host[:port] the client is told to use in /dls (Android: via adb reverse, or the Mac's LAN IP)
                    "public_host": "api.example.com",
                    // Assets come from the Cloudflare R2 CDN Worker (cdn-worker/), not this server
                    "resource_host": "cdn.example.com",
                    "notice_url": "http://ios21900.bfww.gumi.sg/pages/versioninfo", // notice url (this points to a drogon orm page)
                    "mst_root": "./mst", // Decoded MST tables (read-only reference data)
                    "system_root": "./system", // Server config + response fixtures that are NOT MSTs
                    "archive_root": "./archive", // Server-owned curated archive data directory
                    // Optional overlay folder (server/docs/features/BALANCE_FORGE_OVERLAYS.md): host
                    // /opt/bf/prod/balance mounted read-only at /app/balance. Remove to turn off.
                    "balance_root": "./balance",
					"initial_level": 1,
					"initial_free_gems": 5,
					"initial_zel": 10000000,
					"initial_karma": 10000000,
					"initial_bcoins": 0,
					// Client render-loop cap delivered to the offline-proxy via
					// GET /offline_mod/fps_cap. 0 disables the client-side cap.
					"fps_cap": 60,
					// Vortex weekday rotation: when true, Sat/Sun open every
					// weekday dungeon instead of only 100300 "Garden of God".
					// The shipped MST only describes the latter, so this is off
					// by default -- flip it for the remembered live behaviour.
					"vortex_weekend_opens_all": false
                }
            }
        }
    ]
}
