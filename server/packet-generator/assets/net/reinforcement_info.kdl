// ReinforcementInfo (response_class=ReinforcementInfoResponse, response_key=xZH6EIQ7,
// func_addr 0x13eb29c).  Drives the "borrow a friend's unit" reinforce slot shown
// during MissionStart / CampaignBattleStart squad selection.
//
// 47 fields per response_mappings.json; readparam_analysis.json only types
// HandleName (B5JQyV8j) and MissionID (Ge8Yo32T) — the other 45 are reachable
// via the hand-coded getValue() path (handbook section 3.2), so member_name is
// the only signal in the typed dump.  Many keys overlap with UserUnitInfo
// (stat/skill fields) — see user.kdl for canonical meaning.
json ReinforcementInfo {
    doc "Reinforce-friend unit info — 47-field payload under response_key xZH6EIQ7."

    field user_id type=str {
        key "h7eY3sAK"
        doc "Friend's user_id.  First param in response_mappings.json's params list."
    }

    field handle_name type=str {
        key "B5JQyV8j"
        doc "setHandleName.  Friend's display name shown on the reinforce slot card."
    }

    field team_lv type="i32::str" {
        key "2Fh3J7ng"
        doc "setTeamLv (per IDA audit tools/ida/audits/xZH6EIQ7_audit.txt). Friend's account level."
    }

    field target_lv type="i32::str" {
        key "4A6LzBxr"
        doc "Friend's unit level (vtable+184 setter — unnamed in pseudocode but matches UnitMix's MixReinforceEntry.target_lv at the same key)."
    }

    field friend_type type="i32::str" {
        key "q9Arz8Jv"
        doc "setFriendType.  EFFECTIVELY BINARY: 1 means 'a friend', anything else does not. Resolved 2026-09-15 by reading ALL FOUR consumers -- getFriendType is non-virtual, so its 66 xrefs are conclusive -- and every one of them tests `cmp w0, #1` and nothing else: FriendInfoList::existTypeOK @0x12607CC (returns true only on ==1; this is the test ReinforcementInfo::getFriendPoint uses to pick the friend vs normal Honor amount), FriendListUtils::setFriendIcon @0x11735E4 (draws the friend badge only on ==1), FriendListUtils::getFriendList @0x11695D8, and GameUtils::getReinforcementListValue. There is NO evidence in this build for a distinct guild-member or stranger value -- the earlier guess of 0=stranger/1=friend/2=guild was speculation. Send 1 for a helper the player should be paid friend Honor for."
    }

    field last_login_date type="i32::str" {
        key "0CAQ6wUe"
        doc "setLastLoginDate (per IDA audit). Unix timestamp of friend's last login."
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "Friend's unit MST id.  Same key as UserUnitInfo.unit_id."
    }

    field base_hp type="i32::str" {
        key "e7DK0FQT"
        doc "Base HP — same as UserUnitInfo.base_hp."
    }

    field base_atk type="i32::str" {
        key "67CApcti"
        doc "Base ATK."
    }

    field base_def type="i32::str" {
        key "q08xLEsy"
        doc "Base DEF."
    }

    field base_heal type="i32::str" {
        key "PWXu25cg"
        doc "Base REC."
    }

    field add_hp type="i32::str" {
        key "cuIWp89g"
        doc "IMP add_hp."
    }

    field ext_hp type="i32::str" {
        key "TokWs1B3"
        doc "ext_hp."
    }

    field add_atk type="i32::str" {
        key "RT4CtH5d"
        doc "IMP add_atk."
    }

    field ext_atk type="i32::str" {
        key "t4m1RH6Y"
        doc "ext_atk."
    }

    field add_def type="i32::str" {
        key "GcMD0hy6"
        doc "IMP add_def."
    }

    field ext_def type="i32::str" {
        key "e6mY8Z0k"
        doc "ext_def."
    }

    field add_heal type="i32::str" {
        key "C1HZr3pb"
        doc "IMP add_heal."
    }

    field ext_heal type="i32::str" {
        key "X6jf8DUw"
        doc "ext_heal."
    }

    field friend_point type="i32::str" {
        key "J3stQ7jd"
        doc """
        setFriendPoint @0x126DEE4.  NOT a cost -- this is the Honor the player
        EARNS for borrowing this helper, and on this row it works as a GATE
        rather than as the number shown.

        ReinforcementInfo::getFriendPoint @0x126DDA8 returns 0 whenever this is
        < 1, and otherwise ignores it and returns the global FriendPointInfo
        (6e4b7sQt) amount -- friend_point_num when FriendInfoList::existTypeOK
        says the helper is a friend, normal_point_num when it is not.  So any
        value >= 1 opens the gate and the amount comes from that block; leaving
        it 0, as this server did until 2026-09-13, pinned every helper card to
        "Honor +0" no matter what else was sent.

        The client stores it obfuscated: the setter draws a random byte r in
        [2,254] into +0x30c and writes value^r to +0x308, keeping the plaintext
        at +0x310; the getter re-XORs the pair.  Same key as
        MissionStartInfo.friend_point, whose getter has zero callers.
        """
    }

    field normal_friend_point type="i32::str" {
        key "w28VsQ7h"
        doc "setNormalFriendPoint @0x126DF80 -- a plain store to +0x314 with no obfuscation and, unlike friend_point, no reader in this build.  Kept in step with friend_point so the row is self-consistent."
    }

    field skill_id type="i32::str" {
        key "nj9Lw7mV"
        doc """
        BB (Brave Burst) skill id.

        ⚠ THE FIELD NAME LIES -- FILL THIS FROM `user_units.bb_id`, NOT
        `user_units.skill_id`.  This key is UserUnitInfo's bb_id (net/user.kdl),
        and UnitArchiver records that "bb_id is unit_mst's skill_id
        (nj9Lw7mV)".  The user_units column literally called skill_id is a
        different thing and is 0 on every row in this save.  Reading it by name
        is what sent the borrowed helper into battle with no Brave Burst, so its
        gauge never filled -- fixed in FriendGet and CampaignBattleStart
        2026-09-14.  The name is kept only because UnitEvo/UnitMix already build
        this struct under it.
        """
    }

    field skill_lv type="i32::str" {
        key "3NbeC8AB"
        doc "BB skill level -- `user_units.bb_lvl`, not skill_lv.  See skill_id above."
    }

    field unit_type_id type="i32::str" {
        key "nBTx56W9"
        doc "Unit type id (1-6: Lord/Anima/Breaker/Guardian/Oracle/Rex)."
    }

    field extra_skill_id type="i32::str" {
        key "iEFZ6H19"
        doc "SBB (Super Brave Burst) id -- `user_units.sbb_id`, NOT extra_skill_id.  Same trap as skill_id above."
    }

    field extra_skill_lv type="i32::str" {
        key "RQ5GnFE2"
        doc "SBB level -- `user_units.sbb_lvl`, not extra_skill_lv.  See skill_id above."
    }

    field user_unit_id type="i32::str" {
        key "edy7fq3L"
        doc "Friend's user_unit DB row id."
    }

    field equipitem_id type="i32::str" {
        key "Ge8Yo32T"
        doc """
        The helper's equipped SPHERE, slot 1.  Not a mission id.

        CORRECTED 2026-09-15.  This was documented as setMissionID and sent as
        an empty string, so every borrowed helper fought with no sphere
        passives -- the same shape of bug as the missing Brave Burst above.

        Verified three independent ways, because the previous reading also
        looked convincing:
          1. ReinforcementInfoResponse::readParam @0x13EB29C dispatches this key
             to vtable +0x1e8 = UserUnitInfoBase::setEquipItemID.  There is no
             setMissionID anywhere in ReinforcementInfo's vtable; setMissionID
             belongs to FixedReinforcementInfo, under key j28VNcUW.
          2. FriendListUtils::setSphereIcon/setSphereName @0x116E0C0 call
             getEquipItemID (+0x1e0) and getEquipItemID2 (+0x200) on a
             ReinforcementInfo* as their first act -- the helper list's sphere
             icon and name.
          3. BattleUnit::initializeBaseStatus @0x10F1438 stores both into
             BattleUnit+0x260/+0x278, which BattleUnit::setEquipPassive reads
             and feeds to ItemMstList::getObject -> getProcessParam ->
             buffManipParser -> setPassiveParam.  That is the sphere's stat
             effect being applied.

        Fill from `user_units.eqip_item_id`.  0 is fine when nothing is
        equipped: the id fails the ItemMst lookup and no passive is applied.
        """
    }

    field equipitem_id2 type="i32::str" {
        key "mZA7fH2v"
        doc "The helper's equipped SPHERE, slot 2 -- readParam sends it to vtable +0x208, UserUnitInfoBase::setEquipItemID2.  Fill from `user_units.eqip_item_id2`.  See equipitem_id above."
    }

    field friend_message type=str {
        key "bM7RLu5K"
        doc "setFriendMessage.  The helper's profile message, the same one FriendInfo carries. Named 2026-09-15 from ReinforcementInfoResponse::readParam @0x13EB29C itself (tools/readparam_map.py)."
    }

    field arena_rank_id type="i32::str" {
        key "JmFn3g9t"
        doc "setArenaRankID.  Arena rank badge shown on the helper card. Named 2026-09-15 from ReinforcementInfoResponse::readParam @0x13EB29C itself (tools/readparam_map.py).  Arena is deferred, so this stays unfilled by decision."
    }

    field friend_id type="i32::str" {
        key "98WfKiyA"
        doc "setFriendID.  The shareable in-game friend id, as in FriendInfo.friend_id. Named 2026-09-15 from ReinforcementInfoResponse::readParam @0x13EB29C itself (tools/readparam_map.py)."
    }

    field extra_passive_skill_id type="i32::str" {
        key "cP83zNsv"
        doc "Extra passive skill id (matches UserUnitInfo.extra_passive_skill_id)."
    }

    field extra_passive_skill_id2 type="i32::str" {
        key "LjY4DfRg"
        doc "Extra passive skill id 2."
    }

    field unit_img_type type="i32::str" {
        key "2pAyFjmZ"
        doc "Unit image variant (matches UserUnitInfo.unit_img_type)."
    }

    field fe_skill_info type=str {
        key "Fnxab5CN"
        doc "FE (frontier element) skill info string."
    }

    field deck_no type="i32::str" {
        key "zsiAn9P1"
        doc "setDeckNo(int).  Which of the helper's decks this leader came from. Named 2026-09-15 from ReinforcementInfoResponse::readParam @0x13EB29C itself (tools/readparam_map.py)."
    }

    field priority type="i32::str" {
        key "yu18xScw"
        doc "setPriority(int).  Sort weight in the helper picker. Named 2026-09-15 from ReinforcementInfoResponse::readParam @0x13EB29C itself (tools/readparam_map.py)."
    }

    field ep3_flg type="i32::str" {
        key "jkldTrhL"
        doc "setEp3Flg(int) -- member +0x250. Named 2026-09-15.  ReinforcementInfoResponse stores this key INLINE at the member offset noted below, so it has no setter symbol of its own; the name comes from a sibling response class that accepts the same key through a named setter.  Strong lead, not proof -- confirm before relying on it."
    }

    field sex type="i32::str" {
        key "9i2xhMaJ"
        doc "Gender id (matches UnitMst.sex)."
    }

    field element type=str {
        key "iNy0ZU5M"
        doc "Element string (fire/water/earth/thunder/light/dark).  Matches UserUnitInfo.element."
    }

    field hair_id type="i32::str" {
        key "btZizNep"
        doc "setHairID -- member +0x260, an inlined STRING assign.  Summoner avatar hair. Named 2026-09-15.  ReinforcementInfoResponse stores this key INLINE at the member offset noted below, so it has no setter symbol of its own; the name comes from a sibling response class that accepts the same key through a named setter.  Strong lead, not proof -- confirm before relying on it."
    }

    field arm_id type="i32::str" {
        key "RVVgyuor"
        doc "setArmID -- member +0x278, an inlined STRING assign.  The helper's equipped SUMMONER ARM. Named 2026-09-15.  ReinforcementInfoResponse stores this key INLINE at the member offset noted below, so it has no setter symbol of its own; the name comes from a sibling response class that accepts the same key through a named setter.  Strong lead, not proof -- confirm before relying on it.  Worth following up: summoner arms are already implemented on this server, so this is fillable."
    }

    field arm_lv type="i32::str" {
        key "U8FCB2Wj"
        doc "setArmLv(int) -- member +0x290.  Summoner arm level. Named 2026-09-15.  ReinforcementInfoResponse stores this key INLINE at the member offset noted below, so it has no setter symbol of its own; the name comes from a sibling response class that accepts the same key through a named setter.  Strong lead, not proof -- confirm before relying on it."
    }

    field arm_exp type="i32::str" {
        key "NqVAPbLC"
        doc "setArmExp(int) -- member +0x294.  Summoner arm experience. Named 2026-09-15.  ReinforcementInfoResponse stores this key INLINE at the member offset noted below, so it has no setter symbol of its own; the name comes from a sibling response class that accepts the same key through a named setter.  Strong lead, not proof -- confirm before relying on it."
    }

    field ability_info type="i32::str" {
        key "mgNdrCEe"
        doc "Inlined store to member +0x298 -- ReinforcementInfoResponse::readParam accepts this key but writes it directly, so there is no setter symbol to name.  Sibling classes (RaidRoomPartyInfo, SummonerFriendInfo) call it setAbilityInfo.  Note: an earlier pass here claimed this key was NOT accepted by ReinforcementInfoResponse::readParam.  That was a tool blind spot, not a fact -- readParam has two dispatch shapes (`cbz w0,<handler>` and `cbnz w0,<skip>`) and only the first was being parsed, so keys in the second form went unseen.  It IS accepted."
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildID(int) -- confirmed 2026-09-15 in ReinforcementInfoResponse::readParam itself, not inferred from a sibling.  Guild is deferred, so this stays unfilled by decision.  Note: an earlier pass here claimed this key was NOT accepted by ReinforcementInfoResponse::readParam.  That was a tool blind spot, not a fact -- readParam has two dispatch shapes (`cbz w0,<handler>` and `cbnz w0,<skip>`) and only the first was being parsed, so keys in the second form went unseen.  It IS accepted."
    }

    field omni_level type="i32::str" {
        key "49sa3sld"
        doc "Omni evolution level (matches UserUnitInfo.omni_level)."
    }
}


// FixedReinforcementInfo (response_class=FixedReinforcementInfoResponse,
// response_key=T_FIXED_REINFORCEMENT, func_addr 0xee13fc).  Server-supplied
// reinforce unit for missions that fix the reinforce (tutorial / specific
// campaign missions / event-locked battles) rather than letting the player
// pick a friend.  21 fields per response_mappings.json, all overlapping with
// ReinforcementInfo.  Per readparam_analysis only HandleName and MissionID
// have typed setters; the rest go through the getValue() path.
json FixedReinforcementInfo {
    doc "Server-fixed reinforce unit info under response_key T_FIXED_REINFORCEMENT."

    field handle_name type=str {
        key "B5JQyV8j"
        doc "Display name for the fixed reinforce (typically NPC-style, e.g. \"Vargas\")."
    }

    field target_lv type="i32::str" {
        key "4A6LzBxr"
        doc "Fixed reinforce unit level."
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "Fixed reinforce unit MST id."
    }

    field base_hp type="i32::str" {
        key "e7DK0FQT"
        doc "Base HP."
    }

    field base_atk type="i32::str" {
        key "67CApcti"
        doc "Base ATK."
    }

    field base_def type="i32::str" {
        key "q08xLEsy"
        doc "Base DEF."
    }

    field base_heal type="i32::str" {
        key "PWXu25cg"
        doc "Base REC."
    }

    field add_hp type="i32::str" {
        key "cuIWp89g"
        doc "IMP add_hp."
    }

    field ext_hp type="i32::str" {
        key "TokWs1B3"
        doc "ext_hp."
    }

    field add_atk type="i32::str" {
        key "RT4CtH5d"
        doc "IMP add_atk."
    }

    field ext_atk type="i32::str" {
        key "t4m1RH6Y"
        doc "ext_atk."
    }

    field add_def type="i32::str" {
        key "GcMD0hy6"
        doc "IMP add_def."
    }

    field ext_def type="i32::str" {
        key "e6mY8Z0k"
        doc "ext_def."
    }

    field add_heal type="i32::str" {
        key "C1HZr3pb"
        doc "IMP add_heal."
    }

    field skill_id type="i32::str" {
        key "nj9Lw7mV"
        doc "BB skill id."
    }

    field skill_lv type="i32::str" {
        key "3NbeC8AB"
        doc "BB skill level."
    }

    field unit_type_id type="i32::str" {
        key "nBTx56W9"
        doc "Unit type id."
    }

    field extra_skill_id type="i32::str" {
        key "iEFZ6H19"
        doc "Extra skill id."
    }

    field extra_skill_lv type="i32::str" {
        key "RQ5GnFE2"
        doc "Extra skill level."
    }

    field reinforce_mission_id type=str {
        key "Ge8Yo32T"
        doc "setMissionID.  Mission this fixed reinforce belongs to (typed setter)."
    }

    field mission_id type=str {
        key "j28VNcUW"
        doc "Mission id (carried in addition to Ge8Yo32T in this response per response_mappings.params)."
    }
}
