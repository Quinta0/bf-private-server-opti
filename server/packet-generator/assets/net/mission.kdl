json MissionReward {
    doc "MissionRewardResponse (response key F5Vs19mb). Drives the 'Quest Clear Reward' screen and the post-mission level-up animation. All 19 fields decoded from MissionRewardResponse::readParam pseudocode at func_addr 0x13E3C34 in libgame.so (arm64 APK) via a private IDA audit. See gimuserver/gme/MissionEnd.cpp for the audit story.  SUPERSEDED: MissionEnd sends MissionRewardInfo (below), whose clear_mission_id / clear_dungeon_id / clear_area_id docs record the decoded first-clear-only semantics; the field notes here are the older reading."

    field clear_bonus type=str {
        key "92ms7J5M"
        doc "setClearBonus. First-clear bonus indicator. Treated as std::string by readParam. // UNVERIFIED format — captured idle value is empty string."
    }

    field lvup_flg type="i32::str" {
        key "wPb5uMR9"
        doc "setLvupFlg. Level-up animation flag. 0=no animation; non-zero plays the 'You reached Lv N' animation from before_lv up to UserTeamInfo.level. Combined with before_lv, this is the actual control surface for the level-up cascade — earlier MissionEnd code left it at 0 with before_lv=0, which made the client animate from 0 up to whatever team_info.level said (the 'Lv 1, 2, 3, then 900' bug)."
    }

    field before_lv type="i32::str" {
        key "81CsGAR9"
        doc "setBeforeLv. The player's level BEFORE this mission. Paired with lvup_flg to drive the level-up animation: the client animates from before_lv to UserTeamInfo.level when lvup_flg is set. Always pass the player's pre-mission level here; on no-level-up missions, lvup_flg should be 0 and before_lv should equal team_info.level."
    }

    field inc_exp type="i32::str" {
        key "d96tuT2E"
        doc "setIncExp. 'XP Obtained' value displayed on the result screen. This is NOT a cascade trigger (the cascade comes from lvup_flg + before_lv); send the actual exp gained this mission so the player sees a real number."
    }

    field rein_req_state type="i32::str" {
        key "0egM9p7I"
        doc "setReinReqState. Reinforce-request state code. // UNVERIFIED meaning; idle value 0 — likely tracks the reinforce/friend-request UI prompt at result screen."
    }

    field clear_dungeon_id type=str {
        key "4sQ8vBXm"
        doc "setClearDungeonID. The dungeon ID of the mission just cleared. The result-screen header reads from this to render 'Adventurer's Prairie' / 'St. Lamia Palace' / etc. Server should populate from F_MISSION_MST lookup by mission_id, but mission_mst.json isn't decoded yet — currently sent empty so the client falls back to its cached current-dungeon state."
    }

    field clear_area_id type=str {
        key "NgPQbA46"
        doc "setClearAreaID. Area ID of the cleared mission. Same source as clear_dungeon_id (F_MISSION_MST lookup, currently empty)."
    }

    field clear_mission_id type=str {
        key "mauD5qZ1"
        doc "setClearMissionID. Mission ID of the cleared mission. Needs MissionStart to persist active_mission_id to userinfo first so MissionEnd can read it back. Currently empty — the client uses its own cached mission state."
    }

    field reward_units type=str {
        key "3MAT6quo"
        doc "setRewardUnits. Comma-separated unit-drop list (unit_id:rarity:flag triples). Echoed from MissionEndReqBattleResult.unit_drops in the request. Same wire format as the request's 3MAT6quo."
    }

    field zel type="i32::str" {
        key "Najhr8m6"
        doc "setZel. 'Zel Obtained' on the result screen. Set from MissionEndReqBattleResult.earn_zel. IDA setter previously documented in readparam_analysis as 'ActualZel'."
    }

    field karma type="i32::str" {
        key "HTVh8a65"
        doc "setKarma. 'Karma Obtained' on the result screen. Set from MissionEndReqBattleResult.earn_karma. IDA setter previously documented in readparam_analysis as 'ActualKarma'."
    }

    field exp_up_type type=str {
        key "3vXLQFjt"
        doc "setExpUpType. Exp-bonus type indicator (string, e.g. multiplier code or boost-source tag). // UNVERIFIED format; idle value is empty string. Likely populated during event campaigns to show 'x2 EXP' style badges next to the obtained value."
    }

    field zel_up_type type=str {
        key "k6MynZkg"
        doc "setZelUpType. Zel-bonus type indicator. Same shape as exp_up_type."
    }

    field karma_up_type type=str {
        key "J1MwgxCL"
        doc "setKarmaUpType. Karma-bonus type indicator. Same shape as exp_up_type."
    }

    field exp_guild type="i32::str" {
        key "b8D18b7e"
        doc "setExpGuild. Guild-membership exp bonus (additive). 0 when not in a guild — current server has no guild system."
    }

    field karma_guild type="i32::str" {
        key "7adBa819"
        doc "setKarmaGuild. Guild-membership karma bonus. Same as exp_guild."
    }

    field zel_guild type="i32::str" {
        key "gzs3Bw10"
        doc "setZelGuild. Guild-membership zel bonus. Same as exp_guild."
    }

    field e_token type="i32::str" {
        key "03fFk30f"
        doc "setEToken. Event token reward (event-currency drops). 0 when no event is active. Ties into F_ET_MISSION_MST when the event system is implemented."
    }

    field repeat_clear_bonus type=str {
        key "S2ChOKo6"
        doc "setRepeatClearBonus. Bonus payload for repeat clears (e.g. first-clear vs replay rewards differ for some campaign missions). // UNVERIFIED format — idle value empty string. The same hash also appears as a placeholder field in MissionMst (mst/mission.kdl) with idle empty value, suggesting the response copies through some MST-stored bonus string."
    }
}

// =============================================================================
//  MissionBreak  (an interrupted battle, and the offer to resume it)
// =============================================================================
//
// The whole subsystem, end to end:
//
//  1. A squad wipes.  MissionGameOverScene offers CONTINUE for DefineMst
//     continu_dia_cnt (QW3HiNv8, 1 gem), and initContinue @0x17FB3C0 fires
//     MissionContinue -- tracked as the analytics event "Revival in Quest" /
//     "Gems", which is what pins down what this request IS.  It carries the
//     battle's freshly built suspend blob.
//  2. If the player instead quits, or the client dies, the server record of
//     that blob is the only thing that remembers the battle happened.
//  3. At the NEXT LOGIN the server sends this block.  LoginScene::
//     changeNextScene @0x174C544 reads getState(): zero means nothing pending
//     and login proceeds normally; NON-ZERO calls SaveData::setLoginState(5),
//     checks DataMstManager::existBattleMstFiles for the serial, and changes to
//     scene 0x53 -- MissionRestartScene -- when the battle assets are still
//     cached (0x3b6 mid-tutorial, Home otherwise).
//  4. MissionRestartScene::initialize @0x17FC7A8 then reads the blob back out
//     of its OWN SaveData (existMissionSuspendData / decodeMissionSuspendData),
//     feeds THAT to setMissionBreakInfo, and fires MissionRestart.
//
// So the battle state is CLIENT-AUTHORITATIVE, exactly like Grand Quest's
// campaignEncodeSuspendData: the server stores and echoes the blob but the
// client reloads its own copy.  What the server owns is the TRIGGER -- without
// a non-zero state at login the resume screen is never reached at all.
//
// The client degrades gracefully when the two disagree: no local suspend data
// means UserState::setMissionRestartFlg(false) and the scene carries on without
// restarting, so a stale record costs a wasted screen rather than a wedged
// login.

json MissionBreakInfo {
    doc "MissionBreakInfoResponse (response key 5PR2VmH1), readParam @0x13E20B4 -- a SINGLETON (MissionBreakInfo::shared(), no list operations), so send one full row.  The interrupted battle the client should be offered at login."

    field mission_serial_id type=str {
        key "k9cxD7Ba"
        doc "setMissionSerialID. Battle session serial. Same wire key appears in MissionEndReqMissionInfo as battle_serial — they're the same opaque token. Treat as a session-scoped string."
    }

    field state type="i32::str" {
        key "j0Uszek2"
        doc """
        setState -- the RESUME TRIGGER, and the earlier "0=paused, 1=cleared"
        reading was backwards.

        CONFIRMED at both readers: LoginScene::changeNextScene @0x174C548
        branches on `cbz w0` -- zero means nothing is pending and login goes to
        Home, anything non-zero diverts to the restart screen.
        MissionBreakInfo::isMissionBreak @0x1265FB4 is literally `state != 0`,
        and MissionScene::isRestart @0x180B300 ands the same test with
        UserState::getMissionRestartFlg.

        Nothing compares it against a specific value, so what goes back is the
        MissionStatus the interruption carried: MissionContinueRequest sends 4
        normally and 6 under Quest Repeat's auto-continue, MissionRestartRequest
        sends 5.  0 is this server's "no open battle".
        """
    }

    field mission_break_info type=str {
        key "K2gIYm0h"
        doc "setMissionBreakInfo. The opaque blob MissionScene::createSuspendData builds; the server stores and echoes it unchanged and never parses it.  Its only visible grammar constraint is MissionBreakInfo::isEnableBreakInfo @0x1265FC4, which asks whether the string contains an '@' that is neither its first nor its last character -- so an empty blob is not a resumable one.  The client prefers its own SaveData copy anyway (see the note above)."
    }
}

// MissionContinue (p8B2i9rJ / G3FwvQfy5hcxHMen) -- "Revival in Quest".
//
// createBody @0x13A7528 sends two groups: Kz7qfSs5 with the serial and a
// MissionStatus of 4 (or 6 when Quest Repeat auto-continue is on), and
// 5PR2VmH1 with the serial and the suspend blob.
//
// No MissionContinueResponse class exists in the binary, so this is an
// acknowledge-and-refresh reply in the ShopUse mould.  Nothing client-side
// deducts the gem -- UserTeamInfo has no setDia/decDia caller anywhere in the
// binary -- so the charge is the server's, and team_info is the only way the
// HUD learns about it.
//
// THE REPLY DECIDES THE REVIVAL.  When a request finishes, GameScene::update
// @0x1601470 calls the scene's checkConnectResult (slot +0x310) before
// clearing the in-flight bit; MissionGameOverScene inherits GameScene's, which
// shows any error through checkResponseMessage.  With no error, loopContinue
// @0x17FB474 calls MissionScene::requestContinue and pops the scene: an
// ordinary reply IS the revival.  An error with GmeErrorCommand::Retry (2)
// shows its message as notice -4000, and MissionGameOverScene::noticeOK
// @0x17FB62C sends the scene back to initContinueConfirm -- the client's own
// refusal path (Close would exit the app, ReturnToGame abandon the battle).
// That the scene does not run loopContinue under the notice is inferred from
// that handler, not traced through the scene manager.
//
// RETRY IDENTITY.  The body is built once (BaseRequest::create -> createBody)
// and both retry paths re-send that same object (WrapAsyncHttpConnector::retry
// @0x1005ED8 re-serialises it, NetworkManager::OnErrorRetryPressed @0xF5DCCC
// re-sends the CCHttpRequest), so a retry repeats serial, status and blob byte
// for byte; a later revival carries a new blob (turn counters, HP, logs).
// There is no nonce: the signal key is the server's own echoed token and
// F4q6i9xe.aV6cLn3v a per-process object counter handlers never see.  The
// server keeps a receipt per run and revival (SHA-256 of "status:blob") in
// user_mission_continue_receipts -- see gme/handlers/MissionBreak.cpp.

json MissionContinueReq {
    doc "MissionContinue (p8B2i9rJ) request -- the revival tap, carrying the battle to be remembered."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key request block."
    }

    field mission_num type="[MissionNumInfo]::size(1)" {
        key "Kz7qfSs5"
        doc "The serial being continued and the MissionStatus for it -- 4, or 6 under auto-continue."
    }

    field mission_break type="[MissionBreakInfo]::size(1)" {
        key "5PR2VmH1"
        doc "The suspend blob for that battle.  Sent up here and handed back at the next login; see MissionBreakInfo."
    }
}

json MissionContinueResp {
    doc "MissionContinue response, sent only for a revival the server accepted (or a repeat of one): the client revives on any ordinary reply.  No response class exists for it, so this carries only the refreshed header -- the gem the revival cost has already left the balance and team_info is the client's only way to see that.  A refused revival gets a GmeErrorCommand::Retry error instead."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key echoed back."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Post-charge header state."
    }
}

// MissionRestart (IP96ys7T / 0Zy3G9eD) -- the resume screen's own request.
//
// createBody @0x13AABF8 sends one group, Kz7qfSs5, with the serial taken out of
// MissionBreakInfo and a MissionStatus of 5.  The battle itself is rebuilt from
// the client's local suspend data, so there is nothing for the reply to carry;
// MissionRestartScene::checkConnectResult @0x17FEAF8 only looks for an error
// and offers RETRY_CONTINUE_MISSION when it finds one.

json MissionRestartReq {
    doc "MissionRestart (IP96ys7T) request -- resume the battle named by the login's MissionBreakInfo."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key request block."
    }

    field mission_num type="[MissionNumInfo]::size(1)" {
        key "Kz7qfSs5"
        doc "The serial being resumed, with MissionStatus 5."
    }
}

json MissionRestartResp {
    doc "MissionRestart response -- an acknowledgement.  Carries the signal key and the header so the resumed battle starts from a current HUD."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key echoed back."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Current header state."
    }
}

json MissionNumInfo {
    doc "Mission serial state required by the battle scene."

    field serial_id type="u32::str" {
        key "k9cxD7Ba"
        doc """
        The BATTLE's serial, not the mission id.  MissionNumResponse::readParam
        @0x13E39C8 stores it (MissionInfo::setMissionSerialID) and the client
        only ever echoes it: MissionEnd, MissionContinue and the raid requests
        send it back, MissionScene::initBattle @0x18040AC seeds BattleState's
        RNG from it, and the start scenes tag the saved battle files and helper
        record with it; the mission travels separately
        (UserState::getLastMissionID).  MissionStart issues a fresh one per
        battle from 1000000001 up (gimuserver/gme/common/MissionRuns.hpp); a
        value below that is the mission id an older server sent.
        """
    }

    field drop_info type="str" {
        key "LE6JkUp7"
        doc """
        Packed waves: battleOrder|unitDrops|treasureDrops, separated by '@'.
        Treasure entries split on '-' then '/' @0x1266644:
        monsterOrder/chestType/params. isMimic @0x12699DC is chestType != 1;
        the emitter uses 1 for ordinary rewards and 2 for Mimics.
        Mimic params split on ':' in BattleTreasure::create @0x10E7AAC.
        [0] is BattleMonsterGroupMst group id. A single token is valid and
        leaves capture unset. If more than one token is present, the client
        unconditionally reads [3] unit id, [4] level, [5] type: lengths 2-5
        are unsafe. Slots [1]/[2] are not read there; [6] is optional extra skill.
        MonsterParty::entryMimic @0x10C218C enters this group separately from
        the ordered waves and flags its first monster as a Mimic.
        Server emits six tokens only on a successful capture roll, otherwise one. Slots 1/2 are authored zero placeholders, unused by this consumer. APPX spawn/warning confirmed; capture still requires client confirmation.
        """
    }

    field mission_status type="i32::str" {
        key "j3g5P4cq"
        doc "REQUEST ONLY (MissionEnd, createBody @0x13A7998): UserState::getMissionState — 2 when the battle was won.  A Frontier Gate battle ends with MissionEnd win or lose (FrontierGateBattleEndScene), so this is how the server tells a floor cleared from a run lost."
        optional #true
    }
}

json MissionBattleResultInfo {
    doc "Client-reported mission reward/result values sent when a mission ends."

    field use_item_log type="str" {
        key "47cJBUxz"
        doc "Battle item usage log."
    }

    field zel type="u32::str" {
        key "Najhr8m6"
        doc "Zel earned during the mission."
    }

    field karma type="u32::str" {
        key "HTVh8a65"
        doc "Karma earned during the mission."
    }

    field item_rewards type="str" {
        key "4T0Q2Bh5"
        doc "APK BattleRewardList::getItemCsv @0x10DFA24: comma-separated itemId:count. MissionEndRequest sends it under 4T0Q2Bh5 @0x13A7AE4."
    }

    field unit_rewards type="str" {
        key "3MAT6quo"
        doc "APK BattleRewardList::getUnitCsv @0x10DFBA4: comma-separated unitId:level:type, optionally followed by extra skill. MissionEndRequest emits 3MAT6quo @0x13A7B18. Mimic capture attaches BattleDropUnit @0x10C2314; initDead forwards that attachment through BattleItemList::setUnit @0x10FD514. Current Mimic emitter leaves extra skill unset."
    }

    field battle_crystal_num type="i32::str" {
        key "hoG2ieT5"
        doc "Battle crystals that appeared THIS BATTLE -- BattleLog::getBattleCrystalNum.  Archive setBCrystal, trophy 100310 累計バトルクリスタル出現数: CUMULATIVE, so the server sums it."
    }

    field heart_crystal_num type="i32::str" {
        key "6PLsn8xo"
        doc "Heart crystals that appeared THIS BATTLE -- BattleLog::getHeartCrystalNum.  Archive setHCrystal, trophy 100320 累計ハートクリスタル出現数: CUMULATIVE."
    }

    // ---------------------------------------------------------------------
    // TROPHY COUNTERS (added 2026-08-24 by the audit campaign).
    //
    // These six keys were already on the wire and already modelled on the
    // parallel MissionEndReqBattleResult struct, which no handler references --
    // so MissionEnd parsed rXvA1E5y through THIS struct and never saw them.
    // Verified present with real values in a captured request
    // (deploy/log/http_log_9TvyNR5H_20260823_165415.log).
    //
    // Every one is byte-identical with a UserTeamArchive setter key, and each
    // comes from BattleLog -- i.e. THIS BATTLE's value, not a running total, so
    // the server accumulates.  Whether a counter sums or maxes is taken from
    // its trophy label in deploy/mst/trophy_mst.json, not from its name:
    // 累計/総合 ("cumulative"/"total") sums, 最大 ("maximum") maxes.
    // ---------------------------------------------------------------------

    field max_turn_damage type="i32::str" {
        key "5NRJQ1LU"
        doc "Highest damage dealt in a single turn THIS BATTLE -- BattleLog::getMaxTurnDamage.  Archive setBattleTurnMaxDamage, trophy 100330 戦闘1ターン最大ダメージ数: a MAXIMUM, so the server keeps the greater of old and new."
    }

    field max_turn_spark_cnt type="i32::str" {
        key "XP06YWdT"
        doc "Highest spark count in a single turn THIS BATTLE -- BattleLog::getMaxTurnSparkCnt.  Archive setBattleTurnMaxSpark, trophy 100340 戦闘1ターン最大スパーク回数: a MAXIMUM."
    }

    field spark_cnt type="i32::str" {
        key "U8uZLA34"
        doc "Sparks this battle -- BattleLog::getSparkCnt.  Archive setBattleSparkCnt, trophy 100350 累計スパーク回数: CUMULATIVE, so the server sums it."
    }

    field skill_use_cnt type="i32::str" {
        key "rZQJF5G9"
        doc "Brave Bursts used this battle -- BattleLog::getSkillUseCnt.  Archive setBattleSkillCnt, trophy 100360 累計BB使用回数: CUMULATIVE."
    }

    field mimic_cnt type="i32::str" {
        key "TW1Mrtp5"
        doc "Mimics that appeared this battle -- BattleLog::getMimicCnt.  Archive setQuestMimicCnt, trophy 200040 総合ミミック出現数: CUMULATIVE."
    }

    field one_attack_damage type="i32::str" {
        key "e6BKoYy9"
        doc "Highest single-unit damage THIS BATTLE -- BattleLog::getOneAttackDamage.  Archive setTurnMaxUnitDamage, trophy 100325 ユニット単体最大ダメージ数: a MAXIMUM."
    }
}


json MissionRewardInfo {
    // AUDIT 2026-08-24: readParam @0x13E3C34, dispatch strcmp @0x139285C,
    // singleton.  19 fields and this KDL matches the map exactly.  Two of them
    // are UNREAD despite confident docs (wPb5uMR9, 0egM9p7I), and 92ms7J5M is a
    // structured triple list rather than the "flags" it was documented as.
    //
    // getBeforeExp has 4 consumers but NO setter in readParam -- it is derived
    // client-side.  Do not add it as a field.
    //
    // Full audit: tools/SERVER_COMPONENT_AUDIT.md.
    doc "Mission reward values consumed by the result scenes."

    field clear_bonus type="str" {
        key "92ms7J5M"
        doc """
        NOT FLAGS -- a DELIMITED LIST OF TRIPLES, "<type>:<a>:<b>" per element.

        MissionResultBaseScene::getRewardBonusZel @0x18B9780 takes this as a
        STRING, runs CommonUtils::parseList @0x18B9804, splits each element on
        ":" @0x18B9850, requires exactly 3 parts @0x18B98A4, StrToInts them and
        selects on the first field: cmp #3 @0x18B98C8.  Its siblings select
        different constants -- getRewardBonusKaruma @0x18B9998 uses #0xb, and
        getRewardBonusSp @0x18B9B80 uses #0x11.

            type 3  = zel
            type 11 = karma
            type 17 = summoner SP

        Those are the SAME numbers as the present box's 30Kw4WBa present_type
        (3 zel, 11 karma, 17 summoner sp) -- a reward-entity enum shared across
        subsystems.  Do not invent a private one.

        We send this empty, which is correct: getRewardBonusZel early-outs on
        the length check @0x18B97BC, so no bonus is displayed.
        """
    }

    field lvlup_flag type="i32::str" {
        key "wPb5uMR9"
        doc "UNREAD.  setLvupFlg @0x13E3D40 stores it and MissionRewardInfo::getLvupFlg has ZERO call sites.  (The previous doc claimed it signalled a player level-up; nothing reads it -- the result screen derives level-up from 81CsGAR9 setBeforeLv instead, which has 14 consumers.)"
    }

    field before_level type="i32::str" {
        key "81CsGAR9"
        doc "Player level BEFORE the mission.  setBeforeLv @0x13E3D6C; 14 consumers, top MissionResultScene::updateEvent and CampaignResultScene::main.  This is what the result screen uses to detect a level-up -- see wPb5uMR9, which is unread."
    }

    field inc_exp type="i32::str" {
        key "d96tuT2E"
        doc "EXP gained by this mission.  setIncExp @0x13E3D98; 7 consumers incl. CampaignResultScene::getRewaedExe."
    }

    field reinforcement_request_state type="i32::str" {
        key "0egM9p7I"
        doc "UNREAD.  setReinReqState @0x13E3DC4 stores it and getReinReqState has ZERO call sites.  (The previous doc claimed it was the friend/reinforcement request state shown after the mission.)"
    }

    field clear_dungeon_id type="str" {
        key "4sQ8vBXm"
        doc """
        The dungeon this result COMPLETED for the first time, else "".
        setClearDungeonID @0x13E3E58.  MissionResultFriendRequestScene::
        changeNextScene @0x18C301C plays that dungeon's end script whenever
        GameUtils::existDungeonEvent(id, "1") holds (map1-ending.txt on dungeon
        80), with no once-only check, and GameUtils::getAppearDungeon @0x1196FE4
        animates DungeonMstList::getNext of it on the dungeon list.  "" is the
        client's own empty value: GameUtils::deleteAppearDungeon @0x1197188
        writes it after the animation.  MissionRewardInfo::init leaves the field
        alone, so an omitted key keeps the PREVIOUS result's id.
        """
    }

    field clear_area_id type="str" {
        key "NgPQbA46"
        doc """
        The area of a first clear that OPENED another story area (85 -> Morgan),
        else "0".  setClearAreaID @0x13E3EFC; read by changeNextScene and
        CoopRaidResultScene::initialize.  Anything but the one-character "0" --
        an empty string included -- makes changeNextScene reset UserState's last
        area (setLastAreaID("")), so the map opens on the new area; "0" is the
        only neutral value.
        """
    }

    field clear_mission_id type="u32::str" {
        key "mauD5qZ1"
        doc """
        The mission this result cleared for the FIRST time, else 0.
        setClearMissionID @0x13E3FA0; read only by changeNextScene, which
        offers the Randall presentation for "12" and otherwise PLAYS the
        mission's end script whenever GameUtils::existMissionEvent(id, "1")
        holds -- unconditionally, so a repeat clear must not name it.  Mission
        10's script (map1-dungeon0-1end.txt, the Farm announcement) ends on
        script op 41 = 0: return point 0, which MissionEventScene::updateEvent
        maps to HomeScene2.  Sending it on every clear replayed that scene and
        sent the player Home after each repeat (2026-10-02).  Mission row 0
        has no script, so 0 is neutral.  With all three ids neutral a story
        result goes to scene 61, DungeonSelectScene2 (the area's dungeon list).
        """
    }

    field reward_units type="str" {
        key "3MAT6quo"
        doc "setRewardUnits @0x13E4044; read by MissionResultSummonerDropScene::setUnitList and the MissionResultUnitScene / CoopRaidResultUnitScene ctors."
    }

    field zel type="u32::str" {
        key "Najhr8m6"
        doc "Zel earned from the mission."
    }

    field karma type="u32::str" {
        key "HTVh8a65"
        doc "Karma earned from the mission."
    }

    field exp_up_type type="str" {
        key "3vXLQFjt"
        doc "setExpUpType @0x13E4140; 3 consumers, all MissionResultScene::updateEvent."
        optional #true
    }

    field zel_up_type type="str" {
        key "k6MynZkg"
        doc "setZelUpType @0x13E41E4; 3 consumers, all MissionResultScene::updateEvent."
        optional #true
    }

    field karma_up_type type="str" {
        key "J1MwgxCL"
        doc "setKarmaUpType @0x13E4288; 3 consumers, all MissionResultScene::updateEvent."
        optional #true
    }

    field guild_exp type="i32::str" {
        key "b8D18b7e"
        doc "setExpGuild @0x13E42C4; 5 consumers, MissionResultScene::updateEvent / guildBonusDraw."
    }

    field guild_karma type="i32::str" {
        key "7adBa819"
        doc "setKarmaGuild @0x13E42F0; 7 consumers, MissionResultScene::guildBonusDraw."
    }

    field guild_zel type="i32::str" {
        key "gzs3Bw10"
        doc "setZelGuild @0x13E431C; 7 consumers, MissionResultScene::guildBonusDraw."
    }

    field event_token type="i32::str" {
        key "03fFk30f"
        doc "setEToken @0x13E4348; read by MissionResultScene::scoreDraw."
    }

    field repeat_clear_bonus type="str" {
        key "S2ChOKo6"
        doc "setRepeatClearBonus @0x13E43DC; read by MissionResultRepeatingBonusScene::initialize."
    }
}

