
json FriendGetReq {
    doc "Request for FriendGet (friend-list / friend-slot fetch).  The client sends only the standard login-info identity tag; the server derives everything from the resolved user, so this carries loginInfo only."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json FriendPointInfo {
    doc """
    How much Honor ("Friend Point") one borrowed Summoner Helper is worth, as
    the global pair the helper cards read.  Wrapper 6e4b7sQt,
    FriendPointInfoResponse::readParam @0x13DA7CC.

    A SINGLETON, not a list: readParam writes straight into
    FriendPointInfo::shared() with no row-0 clear, so one full row must be
    sent -- the same discipline as n5mdIUqj.  The ctor @0x1260DD8 assigns BOTH
    strings the literal "0", which is why every helper card read "Honor +0"
    until this block was emitted.

    ReinforcementInfo::getFriendPoint @0x126DDA8 is the only reader:
      1. it returns 0 outright unless that ROW's own friend_point is >= 1
         (stored XOR-obfuscated -- setFriendPoint @0x126DEE4 keeps rand at
         +0x30c and value^rand at +0x308, and the getter re-XORs them), then
      2. it asks FriendInfoList::existTypeOK(row.user_id) whether the helper is
         on the player's friend list, and returns getFriendPointNum() when it
         is, getNormalPointNum() when it is not.
    So the row gates and THIS block gives the amount.  Consumers:
    FriendListUtils::setFriendPoint (draws REINFORCEMENT_SELECT_FRIEND_POINT,
    "Honor +<param=num>"), MissionCheckScene::setPreparation / updateEvent,
    MissionBattleUnitInfoScene::updateEvent and
    MissionResultRepeatCheckScene::resetFriendUnit.
    """

    field friend_point_num type="str" {
        key "4vamo28W"
        doc """
        setFriendPointNum -- Honor earned when the helper IS on the player's
        friend list.  The client help text says as much: "You can get more
        Honor Pts when you hire a friend as a Summoner Helper"
        (MST_HELP_SUBTOPIC_300_1_DESCRIPTION).

        A COMMA-SEPARATED LIST, not a number.  getFriendPointNum(int i)
        @0x1261020 splits on "," and takes element i, falling back to element 0
        when the list is shorter; the no-arg overload the helper cards use is
        index 0.  SummonerReinforcementInfo::getFriendPoint is the one caller
        that passes a real index.  `str` because the setter takes the whole
        std::string and the split happens on read.
        """
    }

    field normal_point_num type="str" {
        key "KgbM81wd"
        doc "setNormalPointNum -- the same comma-separated list for a helper who is NOT a friend.  Same grammar and same index-0 read as friend_point_num."
    }
}

// FriendInfo (response_class=FriendInfoResponse, response_key=tojMy68W,
// readParam at 0x13D93C0).  Per the IDA audit
// (tools/ida/audits/tojMy68W_audit.txt) this populates the FriendInfoList
// singleton — the same singleton the squad-selection screen reads from
// when rendering the reinforce friend picker.
//
// 50 fields total.  Field set decoded from:
//   1. bfdata/responses/Friend/FriendInfoResponse.hpp (typed setter names)
//   2. readParam dispatch at 0x13D93C0 (confirms strcmp-keyed setters)
//   3. GuildRaidFriendSelectRequest::createBody at 0x1C5B388 (confirms
//      wire-side field order via JsonNode::addParam calls)
//
// 2Fh3J7ng genuinely overloads: unrelated in UserUnitInfo (qC2tJs4E),
// TeamLv here.  Same wire key, different semantic, depending on which
// response class deserialises it.
//
// Ge8Yo32T DOES NOT.  This comment used to claim it meant MissionID in
// ReinforcementInfo (xZH6EIQ7) — it does not; readParam sends it to
// UserUnitInfoBase::setEquipItemID there exactly as it does here, and that
// mistake left every borrowed helper with no sphere.  It is equipitem_id in
// all three contexts.  Verified with tools/readparam_map.py; see the
// corrected note on ReinforcementInfo.equipitem_id.
//
// iNy0ZU5M is uint32_t (element ID as int) here, NOT a string like in
// UserUnitInfo — FriendInfo's typed setter takes int.
json FriendInfo {
    doc "Friend-list entry — 50-field payload under response_key tojMy68W. Populates the FriendInfoList singleton the squad-select reinforce picker reads from."

    field user_id type=str {
        key "h7eY3sAK"
        doc "setUserID.  Friend's user_id.  No '0' early-return like xZH6EIQ7's setUserID — empty / 0 user_ids still process."
    }

    field handle_name type=str {
        key "B5JQyV8j"
        doc "setHandleName.  Friend's display name."
    }

    field team_lv type="i32::str" {
        key "2Fh3J7ng"
        doc "setTeamLv.  Friend's account level."
    }

    field friend_type type="i32::str" {
        key "96Nxs2WQ"
        doc "setFriendType.  EFFECTIVELY BINARY: 1 means 'a friend', anything else does not. Resolved 2026-09-15 by reading ALL FOUR consumers -- getFriendType is non-virtual, so its 66 xrefs are conclusive -- and every one of them tests `cmp w0, #1` and nothing else: FriendInfoList::existTypeOK @0x12607CC (returns true only on ==1; this is the test ReinforcementInfo::getFriendPoint uses to pick the friend vs normal Honor amount), FriendListUtils::setFriendIcon @0x11735E4 (draws the friend badge only on ==1), FriendListUtils::getFriendList @0x11695D8, and GameUtils::getReinforcementListValue. There is NO evidence in this build for a distinct guild-member or stranger value -- the earlier guess of 0=stranger/1=friend/2=guild was speculation. Send 1 for a helper the player should be paid friend Honor for."
    }

    field last_login_date type="i32::str" {
        key "0CAQ6wUe"
        doc "setLastLoginDate.  Unix timestamp of friend's last login."
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "Friend's leader unit MST id.  vtable+152 setter (unnamed in pseudocode but matches UserUnitInfo.unit_id meaning)."
    }

    field unit_lv type="i32::str" {
        key "4A6LzBxr"
        doc "Friend leader unit's level.  vtable+184 setter; same key in ReinforcementInfo where it was also unit/target level."
    }

    field base_hp type="i32::str" {
        key "e7DK0FQT"
        doc "Base HP.  vtable+280 setter."
    }

    field base_atk type="i32::str" {
        key "67CApcti"
        doc "Base ATK.  vtable+296."
    }

    field base_def type="i32::str" {
        key "q08xLEsy"
        doc "Base DEF.  vtable+312."
    }

    field base_heal type="i32::str" {
        key "PWXu25cg"
        doc "Base REC.  vtable+328."
    }

    field add_hp type="i32::str" {
        key "cuIWp89g"
        doc "IMP add_hp.  vtable+344."
    }

    field ext_hp type="i32::str" {
        key "TokWs1B3"
        doc "ext_hp.  vtable+360."
    }

    field add_atk type="i32::str" {
        key "RT4CtH5d"
        doc "IMP add_atk.  vtable+376."
    }

    field ext_atk type="i32::str" {
        key "t4m1RH6Y"
        doc "ext_atk.  vtable+392."
    }

    field add_def type="i32::str" {
        key "GcMD0hy6"
        doc "IMP add_def.  vtable+408."
    }

    field ext_def type="i32::str" {
        key "e6mY8Z0k"
        doc "ext_def.  vtable+424."
    }

    field add_heal type="i32::str" {
        key "C1HZr3pb"
        doc "IMP add_heal.  vtable+440."
    }

    field ext_heal type="i32::str" {
        key "X6jf8DUw"
        doc "ext_heal.  vtable+456."
    }

    field today_yale type="i32::str" {
        key "a1Jp3TVb"
        doc "setTodayYale.  Daily friend-point yield this friend has produced today. // UNVERIFIED."
    }

    field want_gift type=str {
        key "s2WnRw9N"
        doc "setWantGift.  Free-form gift-request string set by the friend."
    }

    field favorite type="i32::str" {
        key "5JbjC3Pp"
        doc "setFavorite.  1=marked-favorite, 0=normal.  Same key as UnitFavoriteRequest.favorite_flg in a different context."
    }

    field equipitem_id type=str {
        key "Ge8Yo32T"
        doc "Friend leader unit's sphere/equipment slot 1.  vtable+488 setter (string).  Overloaded key: in ReinforcementInfo this is MissionID; in UserUnitInfo it's also equipitem_id."
    }

    field equipitem_id2 type=str {
        key "mZA7fH2v"
        doc "Friend leader unit's equipment slot 2.  vtable+512 (string)."
    }

    field friend_id type=str {
        key "98WfKiyA"
        doc "setFriendID.  In-game friend ID string the player shares to add this friend."
    }

    field friend_message type=str {
        key "bM7RLu5K"
        doc "setFriendMessage.  Profile / status message the friend has set."
    }

    field friend_message_change_time type="i32::str" {
        key "8DtoZdXE"
        doc "setFriendMessageChangeTime.  Unix timestamp of when the friend last changed their message."
    }

    field arena_rank_id type=str {
        key "JmFn3g9t"
        doc "setArenaRankID.  Their current arena rank tier."
    }

    field ranking_point type="i32::str" {
        key "U4pMNjy0"
        doc "setRankingPoint.  Arena ranking points."
    }

    field unit_type_id type="i32::str" {
        key "nBTx56W9"
        doc "Friend leader unit's type (1-6 Lord/Anima/etc)."
    }

    field skill_id type=str {
        key "nj9Lw7mV"
        doc "Friend leader unit's BB skill id (string)."
    }

    field skill_lv type="i32::str" {
        key "3NbeC8AB"
        doc "Friend leader unit's BB skill level."
    }

    field extra_skill_id type=str {
        key "iEFZ6H19"
        doc "Friend leader unit's SBB / extra skill id (string)."
    }

    field extra_skill_lv type="i32::str" {
        key "RQ5GnFE2"
        doc "Extra skill level."
    }

    field req_time type=str {
        key "3InKeya4"
        doc "setReqTime.  Timestamp the friend request was sent (string)."
    }

    field elapsed_agree_time type="i32::str" {
        key "paND1zM8"
        doc "setElapsedAgreeTime.  Seconds since friend agreement was made."
    }

    field unk_7x3pPB2C type="i32::str" {
        key "7x3pPB2C"
        doc "// UNVERIFIED — no exported setter name."
    }

    field unk_Sv80kL5r type="i32::str" {
        key "Sv80kL5r"
        doc "// UNVERIFIED — no exported setter name."
    }

    field extra_passive_skill_id type=str {
        key "cP83zNsv"
        doc "Extra passive skill id (string).  Same key as UserUnitInfo.extra_passive_skill_id."
    }

    field extra_passive_skill_id2 type=str {
        key "LjY4DfRg"
        doc "Extra passive skill id 2."
    }

    field unit_img_type type="i32::str" {
        key "2pAyFjmZ"
        doc "setUnitImgType.  Image variant id for the friend leader's unit art."
    }

    field deck_no type="i32::str" {
        key "zsiAn9P1"
        doc "setDeckNo.  Which of the friend's saved decks this snapshot is from."
    }

    field priority type="i32::str" {
        key "yu18xScw"
        doc "setPriority.  Display-order priority on the friend list (favorites first)."
    }

    field unk_jkldTrhL type="i32::str" {
        key "jkldTrhL"
        doc "// UNVERIFIED — same key appears as constant 0 in many MissionEnd request / UserTeamInfo / ReinforcementInfo positions."
    }

    field sex type="i32::str" {
        key "9i2xhMaJ"
        doc "Friend leader unit's gender id (matches UnitMst.sex)."
    }

    field element type="i32::str" {
        key "iNy0ZU5M"
        doc "Friend leader unit's element ID (int).  IMPORTANT: this is i32 in FriendInfo, NOT a string like in UserUnitInfo — the typed setter takes uint32_t."
    }

    field unk_btZizNep type=str {
        key "btZizNep"
        doc "// UNVERIFIED — string-typed in bfdata typed handler."
    }

    field unk_RVVgyuor type=str {
        key "RVVgyuor"
        doc "// UNVERIFIED — string-typed in bfdata typed handler."
    }

    field unk_U8FCB2Wj type="i32::str" {
        key "U8FCB2Wj"
        doc "// UNVERIFIED — int-typed in bfdata typed handler."
    }

    field unk_NqVAPbLC type="i32::str" {
        key "NqVAPbLC"
        doc "// UNVERIFIED — int-typed in bfdata typed handler."
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildID.  ID of the friend's guild (0 if none).  FriendInfoResponse::readParam @0x13d983c sends sD73jd20 to setGuildID @0x13da730 (binary-confirmed 2026-10-17; until then this was modelled as mgNdrCEe).  Not 0 shows the profile's View Guild button, which sends GuildMemberGuildInfo (38bSeq81)."
    }

    field ability_info type="str" {
        key "mgNdrCEe"
        doc "A std::string member at +0x278 (@0x13d982c -> 0x13da6d8), the key reinforcement_info.kdl names ability_info.  Sent as \"0\", the value it carried while it was mis-modelled as the guild id."
    }
}
