json UserEquipBoostItemInfo {
    doc """
    One BONUS-item slot of the quest-prep loadout (wrapper nAligJSQ).

    The prep screen has two item bars: the battle items (71U5wzhI,
    UserEquipItemInfo) and these bonus slots, which the client carries into the
    fight as well -- MissionStartRequest::createBody @0x13AB3C4 reads the same
    UserEquipBonusItemInfoList, and GameUtils::createUserWarehouseInfoList
    subtracts them from the warehouse listing so an equipped item is not offered
    twice.

    Field map from UserEquipBoostItemInfoResponse::readParam @0x13FE0D8, which
    fills UserEquipBonusItemInfoList (yes: the response class says Boost and the
    list says Bonus) and calls removeAllObjects() first -- a FULL REPLACE.

    // REVERTED FROM a single `unk1` keyed Kn51uR4Y: that is the signal-key hash
    // and appears nowhere in this class; the real fields are the three below.
    """

    field item_id type="i32::str" {
        key "kixHbe54"
        doc "setItemID.  ItemMst id in this slot."
    }

    field disp_order type="i32::str" {
        key "XuJL4pc5"
        doc "setDispOrder.  Slot number, stored verbatim (ItemEdit writes a second run at slot+100, the same convention as the battle-item bar)."
    }

    field item_num type="i32::str" {
        key "wgV86x1q"
        doc "setItemNum.  How many of it are in the slot."
    }
}

