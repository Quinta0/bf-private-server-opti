json UserUnitDictionary {
	doc """
    Discovered unit entries used by the client unit dictionary.

    UserUnitDictionaryResponse::readParam @0x1404ABC feeds TWO lists:

      UserUnitDictionaryList           MERGE.  Each row replaces any entry with
                                       the same unit id (getObjectWithUnitID,
                                       erase, addObject).  The Unit Guide
                                       (UnitDictionaryScene::setUnitDictionary)
                                       and unit asset loading read this one.
      UserUnitDictionaryReferenceList  REPLACED BY EVERY RESPONSE: row 0 /
                                       field 0 calls removeAllObjects, then
                                       every row is added.  Its only reader is
                                       the summon lineup — SummonsListScene's
                                       ctor stores existUnitID's answer per
                                       unit (@0x16D4200 -> [entry+0x30]).

    So ALWAYS SEND THE WHOLE DICTIONARY.  Only the newly obtained species is
    harmless to the Unit Guide but leaves the lineup knowing just those
    species until the next UserInfo.  The scene loads question_frame beside
    unit_thum, which is presumably how it draws a unit it does not know
    (UNVERIFIED in-client).

    // WAS: "a response-local reference list used by result screens".  The
    // xrefs show no result-screen reader; the lineup is the only one.
    """

	field user_id type="str" {
		key "h7eY3sAK"
		doc "User id that owns this dictionary entry."
	}

	field unit_id type="u32::str" {
		key "pn16CNah"
		doc "Discovered unit id."
	}

	field img_type_flag type="i32::str" {
		key "2pAyFjmZ"
		doc """
		ALTERNATE ART, and the only thing that unlocks it.

		readParam @0x1404D60 sends this key straight to
		UserUnitDictionary::setImgTypeFlg (+0x48), and
		UserUnitDictionaryList::isUnitImgType @0x12B1D80 -- the test behind the
		art-swap arrow on the unit page, the Unit Guide, the summon lineup and
		the event-token shop's "already owned" check -- is exactly
		`getImgTypeFlg() == 1`.  Nothing else writes that member.

		WHICH illustration is showing does not travel: unitImgTypeSet stores it
		in a second member (+0x4c) that readParam never touches, and
		UserUnitDictionaryList::unitImgTypeSave / unitImgTypeLoad persist it on
		the device.  getUnitImgType() returns that member only while this flag
		is 1, which is how one server bit gates a purely local preference, and
		GameUtils::getUnitCutinImage @0x117D694 appends "_<n>" for n >= 2 --
		unit_ills_full_<id>_2.png, which ships with the client for 60 species.

		1 for a species whose alternate art this player has bought (Merit shop
		reward type 15), 0 otherwise; see gme::loadUnitDictionary.
		"""
	}
}

json UserFavorite {
	doc "Favorited/locked unit entry in UserInfo (list key 3kcmQy7B).  Same wire triple as UnitFavoriteEntry — the UnitFavorite handler persists user_units.favorite_flg and UserInfo reports the locked set back here so locks survive a reload."

	field user_unit_id type="i32::str" {
		key "edy7fq3L"
		doc "Locked unit's user_units.user_unit_id.  Quoted decimal integer on the wire."
	}

	field favorite type="i32::str" {
		key "5JbjC3Pp"
		doc "Favorite/lock flag, always \"1\" for reported entries (unfavorited units are simply absent)."
	}

	field unit_img_type type="i32::str" {
		key "2pAyFjmZ"
		doc """
		The same hash the unit dictionary carries, on a per-UNIT row rather than
		per-species.  Sent 0: the alternate-art unlock is species-wide and rides
		the dictionary (see UserUnitDictionary.img_type_flag), and the favourite
		list's copy has no traced reader.
		"""
	}
}

json UserClearMissionInfo {
	doc "Per-mission clear-history record (UserInfo list key UT1SVg59).  All 7 fields decoded via the UT1SVg59 readParam audit (handbook §8.27, tools/ida/audits/UT1SVg59_audit.txt).  THE progression driver: the client evaluates feature unlocks against this list — F_FUNCTION_RELEASE_MST rows condition type 2 = 'mission <param> cleared' (functions 8-19), and hardcoded early-feature gates (town etc.) key off the same set.  Backed by user_campaign_missions rows with state=2."

	field user_id type="str" {
		key "h7eY3sAK"
		doc "Owning user id (setUserID — the one typed setter in readparam_analysis)."
	}

	field mission_id type="i32::str" {
		key "j28VNcUW"
		doc "Cleared mission's F_MISSION_MST id."
	}

	field clear_date type="str" {
		key "JATWnN57"
		doc "setClearDate — last-clear datetime string, formatted \"YYYY-MM-DD hh:mm:ss\" from user_campaign_missions.last_cleared_at.  // UNVERIFIED: exact client-expected format; std::string setter per audit."
	}

	field clear_cnt type="i32::str" {
		key "HIQoGb10"
		doc "setClearCnt — lifetime clear count for this mission."
	}

	field most_time type="i32::str" {
		key "Wi4EFe6f"
		doc "setMostTime — fastest clear (seconds).  Not tracked yet; sent as 0."
	}

	field get_bc type="i32::str" {
		key "RWX38boG"
		doc "setGetBc — lifetime battle crystals from this mission.  Not tracked yet; sent as 0."
	}

	field get_hc type="i32::str" {
		key "bGx5ku0F"
		doc "setGetHc — lifetime heart crystals from this mission.  Not tracked yet; sent as 0."
	}
}
json UserWarehouseInfo {
    doc "One owned item stack in the player's warehouse (potions, materials, spheres).  Response key 9wjrh74P (UserWarehouseInfoResponse).  Params per response_mappings.json: n6E8iMf3, kixHbe54, wgV86x1q, dJNpLc81, DbMVG16I."

    field instance_id type="u32::str" {
        key "n6E8iMf3"
        doc "Warehouse row instance id (distinct from item_id): user_warehouse_rows.instance_id.  The client's getItemIndex; a unit's equipitem_frame_id/2 names the row of the sphere copy it wears by this id."
    }

    field item_id type="u32::str" {
        key "kixHbe54"
        doc "Item master id (joins to ItemMst.id)."
    }

    field item_num type="u32::str" {
        key "wgV86x1q"
        doc """
        Quantity held in this stack.  AN EQUIPPED SPHERE COPY IS 1, not 0.

        The client never changes a count when it equips or unequips: "equipped"
        is only the unit's frame id naming this row (UserUnitInfo.
        equipitem_frame_id).  And it reads equipped copies as ordinary rows --
        the sphere picker skips a sphere row whose count is 0 (setSphereList
        @0x172F264, getItemNum then cbz), decWarehouseItem protects the rows a
        unit wears, and GameUtils::incWarehouseItem tops up any row below its
        max stack, so a worn copy sent as 0 would vanish from the picker and
        could even absorb the next crafted copy.  The server keeps
        user_warehouse_rows.item_num 0 for a worn copy (user_items excludes it);
        gme::loadWarehouseSnapshot puts 1 on the wire.
        """
    }

    field new_flg type="i32::str" {
        key "dJNpLc81"
        doc """
        setNewFlg -- the NEW badge on a warehouse stack.  NOT the lock/favorite
        flag, which is what this field used to be called.

        CORRECTED 2026-09-15.  UserWarehouseInfoResponse::readParam @0x14060E0
        sends this key to UserWarehouseInfo::setNewFlg, and the KDL doc here
        already admitted it was unconfirmed.  It was mapped in
        PacketInterfaceSchemas to the `user_items.favorite_flg` COLUMN, so
        locking an item would have made the client draw a NEW badge on it.
        Latent rather than live only because every row in the save is still 0.

        Locks have their own round trip and do not belong here: ItemFavorite
        (`5JbjC3Pp` -> setFavorit) carries them, and UserInfo reports them back
        through UserInfoResp.item_favorite.  So this is no longer fed from the
        lock column and goes out as 0 -- nothing on this server tracks
        item newness yet.
        """
    }

    field disp_order type="i32::str" {
        key "DbMVG16I"
        doc "Display order in the item list.  // UNVERIFIED: see favorite_flg note."
    }
}

// UserGiftInfo — one entry in the PLAYER-TO-PLAYER gift inbox.
//
// Every field below was `unk<N>` with a `TODO` doc until 2026-09-15.  The
// names are not guesses: `UserGiftInfoResponse::readParam` @0x13FE4E8 was
// mapped key-by-key with tools/readparam_map.py, and each one dispatches to a
// UserGiftInfo setter by name.  Re-run that tool rather than editing these by
// hand.
//
// GIFTS ARE NOT THE PRESENT BOX.  user_id_from / user_id_to make that plain:
// this is one player sending another a gift, which needs a friend system this
// server does not have.  The present box (`user_presents`) is the separate,
// working thing that mission rewards and purchases land in.
//
// Nothing fills this struct yet — GetGiftInfo (ifYoPJ46) deliberately answers
// with an empty object so that opening the gift screen cannot close the
// session.  This schema is what a real implementation would fill.
json UserGiftInfo {
	doc "One entry in the player-to-player gift inbox (response key 30uygM9m).  Distinct from the present box; not yet implemented server-side."

    field gift_identify_id type="i32::str" {
        key "gNE76SLp"
        doc "setGiftIdentifyID.  The inbox row's own id — what a claim would name.  STRING setter."
    }

    field user_id_from type="str" {
        key "yDiG31Fe"
        doc "setUserIDFrom.  The sender.  Half of the pair that makes this player-to-player rather than a present-box grant."
    }

    field user_id_to type="str" {
        key "1px2dbX3"
        doc "setUserIDTo.  The recipient."
    }

    field gift_id type="i32::str" {
        key "eDj82kMN"
        doc "setGiftID(int).  Which gift, as opposed to which inbox row."
    }

    field gift_type type="i32::str" {
        key "2bvT9hKt"
        doc "setGiftType(int).  Enum not yet decoded — no sample traffic exists for this screen."
    }

    field item_id type="i32::str" {
        key "kixHbe54"
        doc "setItemID.  Same key ItemMst uses for its own id.  STRING setter, so a quoted number is what it wants."
    }

    field possession type="i32::str" {
        key "wgV86x1q"
        doc "setPossession(int).  Quantity held / sent."
    }

    field gift_date type="str" {
        key "aHSvC81N"
        doc "setGiftDate.  A STRING setter, so this is modelled as str -- it was `datetime`, which generates a chrono_time the server cannot assign a date string to."
    }

    field gift_ymd type="i32::str" {
        key "q5Y4gUnb"
        doc "setGiftYmd(int).  The date again as a packed integer, alongside gift_date."
    }

    field recieve_flg type="i32::str" {
        key "fa6WwE9u"
        doc "setRecieveFlg(int).  Whether the recipient has claimed it.  (Spelling is the client's.)"
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "setUnitID.  STRING setter.  Present so the inbox row can draw the sender's leader."
    }

    field handle_name type="str" {
        key "B5JQyV8j"
        doc "setHandlename.  Sender's display name.  (Lower-case `n` is the client's.)"
    }

    field unit_img_type type="i32::str" {
        key "2pAyFjmZ"
        doc "setUnitImgType(int).  Alternate art bit for the leader drawn on the row — the same flag reference_alternate_art covers."
    }

    field ep3_flg type="i32::int" {
        key "jkldTrhL"
        doc "setEp3Flg(int).  Episode-3 marker, shared with the arena/ranking rows.  // UNVERIFIED: this is the one field here still sent UNQUOTED, unlike everything around it."
    }

    field sex type="i32::str" {
        key "9i2xhMaJ"
        doc "setSex(int).  Sender's summoner avatar sex.  CORRECTED from type=str: the setter takes an int."
    }

    field element type="i32::str" {
        key "iNy0ZU5M"
        doc "setElement(int).  Sender's leader element.  CORRECTED from type=str: the setter takes an int, and FriendInfo's note records the same trap on this key."
    }

    field hair_id type="str" {
        key "btZizNep"
        doc "setHairID.  Sender's summoner hair.  STRING setter (by const reference)."
    }

    field arm_id type="str" {
        key "RVVgyuor"
        doc "setArmID -- the sender's equipped SUMMONER ARM, a STRING setter (const ref).  An earlier pass here claimed this key was NOT accepted by UserGiftInfoResponse::readParam; that was a tool blind spot, not a fact -- readParam has two dispatch shapes (`cbz w0,<handler>` and `cbnz w0,<skip>`) and only the first was being parsed, so keys in the second form went unseen.  All 18 fields of this struct are accepted."
    }
}

json UserSummonerInfo {
    doc """
    The player's Summoner (the avatar behind the squad) — level, element
    mastery, SP, equipment and derived stats.

    Wire block `n5mdIUqj` -> UserSummonerInfoResponse::readParam @0x144EAD0,
    33 keys into 32 setters.

    ⚠ SINGLETON, NOT A LIST.  readParam opens with UserSummonerInfo::shared()
    followed by init() (@0x144EB10/0x144EB14) before the first strcmp, so the
    whole object is reset and refilled from one node.  Send exactly one row —
    an empty array never runs readParam at all, which is what made reward
    type 17 (Summoner SP) impossible to show.

    // WAS A STUB: a single `mock` field keyed \"INVALID\".

    ⚠ WE ONLY MODEL `sp`.  Every other field is emitted at the value
    UserSummonerInfo::init() @0x127E9E8 already assigns, read out of the
    binary rather than guessed — string fields \"\" except summoner_arm_id
    \"10\", sex 1, element 1, exp/level pairs (0,1) six times over, sp 0,
    friend point 0, hp/atk/def/hel 1, summon_limit 1, deck 0.  So sending
    this block is a no-op for everything the summoner subsystem has not been
    built for yet, and the one field we do own is truthful.

    The exception is hp/atk/def/hel: init()'s 1/1/1/1 is a placeholder the
    server is meant to overwrite, so we send SummonerLevelMst's row for the
    level we send (level 1 = 4000/1500/1500/1500) instead of repeating it.

    SP is earned per summoner level (SummonerLevelMst.get_sp, the same
    iIDqD50O hash) and spent in SummonerAbilityListScene on
    SummonerAbilityLevelMst.need_sp.  Cap: DefineMst.max_summoner_sp = 99999.
    """

    field user_id type="str" {
        key "h7eY3sAK"
        doc "Owning user.  setUserID @0x127EBC0, member +0x18."
    }

    field sex type="i32::str" {
        key "9i2xhMaJ"
        doc "Summoner appearance sex.  setSex, member +0x30.  init() default 1."
    }

    field element type="i32::str" {
        key "iNy0ZU5M"
        doc "Summoner element.  setElement, member +0x34.  init() default 1."
    }

    field summoner_arm_id type="str" {
        key "RVVgyuor"
        doc "EQUIPPED arm id, member +0x38 — init() seeds it \"10\", the first of DefineMst.init_summoner_arm_id \"10,20\".  Same hash as UserSummonerArmsInfo.summoner_arm_id, which is the OWNED list; this is the one in hand."
    }

    field summoner_hair_id type="str" {
        key "btZizNep"
        doc "Hairstyle id, member +0x50.  init() default empty."
    }

    field exp type="i32::str" {
        key "d96tuT2E"
        doc "Summoner EXP, member +0x68."
    }

    field level type="i32::str" {
        key "D9wXQI2V"
        doc "Summoner level, member +0x6c.  init() default 1 — never send 0, SummonerLevelMst starts at 1."
    }

    field exp1 type="i32::str" {
        key "FTTADDzF"
        doc "Element 1 mastery EXP.  setExp1, member +0x70."
    }

    field level1 type="i32::str" {
        key "Gbe7pD2H"
        doc "Element 1 mastery level.  setLevel1, member +0x74.  init() default 1."
    }

    field exp2 type="i32::str" {
        key "8VhOXCti"
        doc "Element 2 mastery EXP.  setExp2, member +0x78."
    }

    field level2 type="i32::str" {
        key "l7C3nzdE"
        doc "Element 2 mastery level.  setLevel2, member +0x7c.  init() default 1."
    }

    field exp3 type="i32::str" {
        key "MYFUzcTo"
        doc "Element 3 mastery EXP.  setExp3, member +0x80."
    }

    field level3 type="i32::str" {
        key "6PuPnB04"
        doc "Element 3 mastery level.  setLevel3, member +0x84.  init() default 1."
    }

    field exp4 type="i32::str" {
        key "0eIAr87V"
        doc "Element 4 mastery EXP.  setExp4, member +0x88."
    }

    field level4 type="i32::str" {
        key "gTPezJiG"
        doc "Element 4 mastery level.  setLevel4, member +0x8c.  init() default 1."
    }

    field exp5 type="i32::str" {
        key "bWfWAyCs"
        doc "Element 5 mastery EXP.  setExp5, member +0x90."
    }

    field level5 type="i32::str" {
        key "aqtX45n3"
        doc "Element 5 mastery level.  setLevel5, member +0x94.  init() default 1."
    }

    field exp6 type="i32::str" {
        key "tIHDv3Gk"
        doc "Element 6 mastery EXP.  setExp6, member +0x98."
    }

    field level6 type="i32::str" {
        key "Rt80vCfs"
        doc "Element 6 mastery level.  setLevel6, member +0x9c.  init() default 1."
    }

    field sp type="i32::str" {
        key "iIDqD50O"
        doc "SUMMONER SP — the currency reward type 18’s sibling, type 17, pays.  setSp, member +0xa0.  Granted by SummonerLevelMst.get_sp (same hash), spent on SummonerAbilityLevelMst.need_sp.  Read by SummonerAbilityListScene, MissionResultSummonerTopScene and SummonerUnitStatusInfo."
    }

    field summoner_friend_point type="i32::str" {
        key "J3stQ7jd"
        doc "Summoner friend points, member +0xa4.  Same hash as the UserTeamInfo field of that name."
    }

    field hp type="i32::str" {
        key "e7DK0FQT"
        doc "Summoner HP, member +0xa8.  Derived: SummonerLevelMst.base_hp for `level` (4000 at 1).  init() leaves 1 as a placeholder."
    }

    field atk type="i32::str" {
        key "67CApcti"
        doc "Summoner ATK, member +0xac.  SummonerLevelMst.base_atk (1500 at level 1)."
    }

    field def type="i32::str" {
        key "q08xLEsy"
        doc "Summoner DEF, member +0xb0.  SummonerLevelMst.base_def (1500 at level 1)."
    }

    field hel type="i32::str" {
        key "PWXu25cg"
        doc "Summoner REC, member +0xb4.  SummonerLevelMst.base_rec (1500 at level 1).  \"hel\" is the client’s own spelling."
    }

    field summon_limit type="i32::str" {
        key "SWfnWyuQ"
        doc "setSummonLimit, member +0xb8.  init() default 1.  // UNVERIFIED: what it limits."
    }

    field ep3_current_deck_no type="i32::str" {
        key "K8U410zY"
        doc "setEp3CurrentDeckNo, member +0xbc.  init() default 0.  Episode-3 deck selection."
    }

    field summoner_ability_info type="str" {
        key "mgNdrCEe"
        doc "Purchased summoner abilities, packed string.  setSummonerAbilityInfo, member +0xc0.  ⚠ The key `kbOUiuPq` reaches the SAME setter (@0x144F224 vs @0x144F17C) — an alias we do not send; sending both would just overwrite one with the other."
    }

    field eqp_item_frame_id type="str" {
        key "0R3qTPK9"
        doc "Equipped frame item, member +0xd8."
    }

    field eqp_item_id type="str" {
        key "Ge8Yo32T"
        doc "Equipped item, member +0xf0."
    }

    field extra_passive_skill_id type="str" {
        key "cP83zNsv"
        doc "Extra passive skill, member +0x108.  Same hash as SummonerLevelMst.extra_passive_skill_id."
    }

    field extra_passive_skill_id2 type="str" {
        key "LjY4DfRg"
        doc "Second extra passive skill, member +0x120."
    }
}

json UserSummonerArmsInfo {
    doc """
    One Summoner Arm the player owns, with its progress.

    Wire block `dhMmbm5p` -> UserSummonerArmsInfoResponse::readParam @0x144E824
    (arm64 libgame.so), 4 keys, list is a FULL REPLACE via removeAllObjects.

    // WAS A STUB: a single `mock` field keyed "INVALID", so the server sent an
    // empty array and nothing could own an arm.  That is what made reward type
    // 18 (Summoner Arm -- see mst/mission.kdl clear_rewards) unclaimable.

    The arm id indexes SummonerArmMst (JuBeb6YR, 23 rows: 10-190 by tens, plus
    7011/8010/9010/9020).
    """

    field user_id type="str" {
        key "h7eY3sAK"
        doc "Owning user.  setUserID @0x144E8B8."
    }

    field summoner_arm_id type="str" {
        key "RVVgyuor"
        doc "Which arm, indexing SummonerArmMst.  setSummonerArmID @0x144E95C."
    }

    field exp type="i32::str" {
        key "d96tuT2E"
        doc "Arm EXP.  setExp @0x144E998."
    }

    field level type="i32::str" {
        key "D9wXQI2V"
        doc "Arm level.  setLevel @0x144E9C4."
    }
}

json UserItemDictionaryInfo {
	doc "One discovered item species for the item encyclopedia.  Response key bd5Rj6pN (UserItemDinctionaryInfoResponse [sic] in response_mappings.json); the client's readParam reads a single param kixHbe54 per node.  Mirrors UserUnitDictionary but for items."

	field item_id type="u32::str" {
		key "kixHbe54"
		doc "Item master id the player has seen/owned (joins to ItemMst.id)."
	}
}

json UserArenaInfo {
    doc """
    Per-user arena standing.  8jBJ7uKR -> UserArenaInfoResponse, readParam
    @0x13FCDF0, and it is a SINGLETON parser.

    ⚠ MUST CARRY ONE ROW EVEN WHEN EVERYTHING IS ZERO.  Every setter fires per
    ROW, so an empty array never runs readParam and the client-side singleton is
    never written -- it then draws whatever was in that memory.  With
    "8jBJ7uKR":[] the Battle Record's Arena Record showed 9,765,061 Total
    Entries, 14,614,711 Total Wins, 7,143,541 Offense Wins and 7,471,170 Defense
    Wins.  Same trap as PQ56vbkI; see UserInfoResp.arena_archive.

    Modelled 2026-08-31 from readParam (it was a one-field `mock` stub, the fifth
    found).  Nothing instruments arena battles yet, so every counter is honestly
    0 -- the point is that readParam runs.
    """

    field user_id type="str" {
        key "h7eY3sAK"
        doc "setUserID @0x13FCEB4."
    }

    field arena_rank_id type="str" {
        key "JmFn3g9t"
        doc "setArenaRankID @0x13FCF54, joins to ArenaRankMst.  NOTE this key is also declared on UserTeamInfo, where nothing reads it -- resolve it against the owning class (Rule Zero)."
    }

    field ranking_point type="i32::str" {
        key "U4pMNjy0"
        doc "setRankingPoint @0x13FCF8C."
    }

    field battle_cnt type="i32::str" {
        key "69vnphig"
        doc "setBattleCnt @0x13FCFB4 -- arena entries, NOT a stamina cost (a previously corrected misreading).  Renders as Total Entries."
    }

    field win_cnt type="i32::str" {
        key "8CEu9Kcm"
        doc "setWinCnt @0x13FCFDC -- renders as Total Wins.  Same key as UserTeamArchive.setWinCnt; different class, different counter."
    }

    field battle_cnt_accept type="i32::str" {
        key "20iEWRCV"
        doc "setBattleCntAccept @0x13FD004 -- defence side, battles accepted."
    }

    field win_cnt_accept type="i32::str" {
        key "0rAkzg7L"
        doc "setWinCntAccept @0x13FD02C -- defence side wins."
    }

    field max_arena_rank_id type="str" {
        key "8uJ1XGwx"
        doc "setMaxArenaRankID @0x13FD0BC -- highest rank ever held."
    }

    field current_position type="i32::str" {
        key "2rqxaZ6K"
        doc "setCurrentPosition @0x13FD0F4."
    }

    field battle_id type="str" {
        key "xL0p2MkY"
        doc "setBattleID @0x13FD184."
    }
}

json UserTeamArchive {
    doc """
    THE TROPHY PROGRESS COUNTERS (lifetime, non-arena).

    Every live field is read by exactly one consumer:
    PlayerInfoBattleResultScene::getActual @0x1791EEC, 32KB of
    TrophyMst::getTrophyID() compares that answer one trophy id per field.  Each
    doc below therefore cites the TROPHY the field satisfies rather than a
    reading of the setter name.  All 62 ids across this class and
    UserTeamArenaArchive exist in deploy/mst/trophy_mst.json, whose Japanese
    labels match the getter names independently.

    Reached from PlayerInfoBattleResultScene::setTrophyList,
    ArenaArchiveScene::setArchiveInfo and ColosseumArchiveScene::setTrophyList.

    ⚠ THE SERVER POPULATES NONE OF THIS.  There is no handler, DB column or
    schema mapping for UserTeamArchive, so the wire carries "zI2tJB7R":[] and
    every trophy reads 0.  Modelled here (it was a one-field `mock` stub) so the
    achievements feature has a verified target; filling it is a feature build.

    Full audit: tools/SERVER_COMPONENT_AUDIT.md.
    """

    field user_id type="str" {
        key "h7eY3sAK"
        doc "UNREAD.  setUserID @0x14020B4 stores it; no getter on this class reads it and getActual never asks for it."
    }

    field login_cnt type="i32::str" {
        key "dD64grYH"
        doc "Answers TROPHY 100010 (ログイン日数).  PlayerInfoBattleResultScene::getActual @0x1791EEC returns this counter for that id; setLoginCnt @0x14020EC."
