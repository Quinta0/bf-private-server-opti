// One Music House track the player OWNS -- response key d98mjNDc,
// UserSoundInfoResponse::readParam @0x1401614.
//
// A LIST and a FULL REPLACE: readParam calls UserSoundInfoList::removeAllObjects
// at row 0 and addObject per row.  It was modelled as a one-element wrapper,
// which cannot express a collection of purchased tracks.
//
// Readers are MyTownSoundRoomScene (the jukebox: which tracks are playable, and
// getCount for the list) and SandbagChangeSoundScene (choosing battle BGM).
// The purchase itself is client-local -- confirmAnswerYes builds a UserSoundInfo
// and addObject's it straight into the list, decrements Zel through
// UserTeamInfo::getZel/setZel, and queues a TownUpdate carrying the new ids
// under LzKDI2i7 -- so WITHOUT this block every track the player paid Zel for
// is gone at the next launch.
json UserSoundInfo {
    doc "A Music House track the player owns.  See the note above: a full-replace LIST, not a singleton."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "ID of the user for this session."
        optional #true
    }

    field sound_id type="i32::str" {
        key "k7Lf0jTt"
        doc "setSoundID -- the SoundMst row this track is.  Same key SoundMst uses for its own id."
    }

}

