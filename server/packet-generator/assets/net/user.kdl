json UserAchievementInfo {
    doc """
    Bnc4LpM8 -> UserAchievementInfoResponse, readParam @0x13FBB58.

    ⚠ readParam LAZILY CONSTRUCTS the singleton: `cbnz x20 / ctor / str x20,[x22]`
    @0x13FBB7C-0x13FBB90.  If the block is never sent, that pointer stays NULL --
    and UserAchievementInfo stores its three ints at +0x18, +0x1c and +0x20,
    which are exactly the offsets the 2026-08-29 Randall Achievement crash reads
    off a null pointer (BraveFrontier.Windows.exe +0xB87F1D).  Sending the block
    is what makes the object exist.

    All three fields are StrToInt -> a raw int store, so they are ints on the
    wire, not strings.  Corrected 2026-08-29: this struct previously declared
    LHQZuau1, which is absent from BOTH client binaries, and omitted HjgTfx8A,
    which readParam actually reads.

    Full audit: tools/SERVER_COMPONENT_AUDIT.md.
    """

    field id type="i32::str" {
        key "idfCDG70"
        doc "StrToInt -> [this+0x18] @0x13FBBB0."
    }

    field unk_HjgTfx8A type="i32::str" {
        key "HjgTfx8A"
        doc "StrToInt -> [this+0x1c] @0x13FBBD0.  Meaning unknown -- UserAchievementInfo exposes NO getters, so the scene reads the members directly and there is no consumer to cite.  Sent as 0 so the singleton exists."
    }

    field unk_CjaJUSrs type="i32::str" {
        key "CjaJUSrs"
        doc "StrToInt -> [this+0x20] @0x13FBBF0.  Meaning unknown, same reason as HjgTfx8A.  Sent as 0."
    }
}


