        key "oS3kTZ2W"
        doc "TODO"
    }

    field bb_id type="str" {
        key "nj9Lw7mV"
        doc "Denotes the bb skill id for this unit."
    }

    field bb_lvl type="u32::str" {
        key "3NbeC8AB"
        doc "Denote bb skill level; max should be level 10."
    }

    field sbb_id type="str" {
        key "iEFZ6H19"
        doc """
        Denotes the sbb skill id for this unit.
        Leave empty if not unlocked.
        """
    }

    field sbb_lvl type="u32::str" {
        key "RQ5GnFE2"
        doc "Denote sbb skill level; max should be level 10."
    }

    field equipitem_frame_id type="i32::str" {
        key "0R3qTPK9"
        doc """
        SLOT 1's WAREHOUSE ROW: the item index (UserWarehouseInfo n6E8iMf3) of
        the sphere copy equipped there, 0 when the slot is empty.  Not a sphere
        type, despite the name.

        BINARY-CONFIRMED (arm64 libgame.so):
          * ItemSphereSelectScene::eqpSphere @0x1738980 writes the chosen copy's
            index into it (setEquipItemFrameID, vtable +0x1d8);
          * UserUnitInfoList::updateSphereEquipList @0x12BA7F8 keys the client's
            "which unit wears this row" map on it, skipping "0";
          * the sphere picker (setSphereList @0x172F0F8), the "equipped / total"
            header (GameScene::getSphereNumString via getSphereEqpCount) and
            GameUtils::decWarehouseItem all look warehouse rows up in that map.
        So a sphere type here marks whichever row happens to have that index as
        equipped, and the real copy as free.  The unit's slot ICON comes from
        equipitem_id, never from this field (GameUtils::setEquipSphereIcon).
        """
    }

    field equipitem_id type="i32::str" {
        key "Ge8Yo32T"
        doc "TODO"
    }

    field equipitem_frame_id2 type="i32::str" {
        key "RXfC31FA"
        doc """
        SLOT 2's WAREHOUSE ROW **AND** THE UNIT'S SPHERE CAPACITY.  Three-valued:

            -1     no second slot -- the client does not draw it at all
             0     slot present, empty
            >0     slot present, holding the copy in that warehouse row

        // CORRECTED 2026-10-02: the >0 case was documented as an ItemMst
        // sphere_type (1..14).  It is the equipped copy's warehouse row, exactly
        // as for slot 1 -- see equipitem_frame_id for the binary evidence.
        // GameUtils::setEquipSphereIcon @0x118F344 reads this field only to
        // compare it with "-1" (slot B drawn or not); the -1/0 sentinel below
        // is unaffected by the correction.

        A unit is born with ONE slot; the second is granted only by fusing a
        Sphere Frog (unit 20302), which moves this field -1 -> 0.

        CONFIRMED IN-CLIENT 2026-09-05.  UnitMixMainScene::mixUnitDoubleSphereCheck
        @0x1C118F8 walks the fusion material list, calls
        UserUnitInfoBase::getEquipItemFrameID2 (vtable+0x1f0) and compares the
        result against the literal string "-1" (mov w22, #0x312d); any material
        that is NOT "-1" raises UNIT_MIX_CONFIRM_SPHERE, "A Unit with max Sphere
        capacity has been selected as an Ingredient.  *Max Sphere capacity will
        not be passed down."  UnitDetailUserUnitScene tests the same sentinel in
        14 places.  Probing one unit at -1 against another left at 0 drew one
        slot on the first and two on the second.

        // WE SENT 0 FOR EVERY UNIT, so every unit showed both slots and the
        // Sphere Frog had nothing to grant.  See the ext_count note below for
        // why the earlier search missed this.

        Related: unit.kdl before_eqp_frame_id2 / after_eqp_frame_id2 report the
        change across a fusion, which is how the frog's effect is shown on the
        result screen.
        """
    }

    field equipitem_id2 type="i32::str" {
        key "mZA7fH2v"
        doc "TODO"
    }

    field received_order type="u32::str" {
        key "Bvkx8s6M"
        doc """
        Numeric acquired-sort key.
        The client only uses this value for acquired-order unit sorting, so the
        server populates it from the monotonically increasing user_unit_id
        instead of storing a separate timestamp.
        """
    }

    field unk2 type="i32::str" {
        key "DbMVG16I"
        doc "TODO"
    }

    field is_new type="bool::str" {
        key "dJNpLc81"
        doc """
        Client-visible new badge for an owned unit row.

        This only marks a newly obtained owned unit, not whether the unit is
        new to the player.
        """
    }

    field extra_passive_skill_id type="i32::str" {
        key "cP83zNsv"
        doc "TODO"
    }

    field extra_passive_skill_id2 type="i32::str" {
        key "LjY4DfRg"
        doc "TODO"
    }

    field add_extra_passive_skill_id type="i32::str" {
        key "T4rewHa9"
        doc "TODO"
    }

    field unit_img_type type="i32::int" {
        key "2pAyFjmZ"
        doc "TODO"
    }
     // # TODO: is this really a str?
    field omni_level type="i32::int" {
        key "49sa3sld"
        doc "TODO"
    }

    field ext_count type="i32::int" {
        key "5gXxT7LZ"
        doc """
        The SPHERE FROG bit: 1 if this unit has been given a second sphere
        slot, 0 otherwise.  Backed by user_units.sphere_ext.

        // RENAMED FROM: "TODO", and never populated -- the server sent 0 for
        // every unit.  setExtCnt @0x12B4CA8; the pair getExtCnt @0x12B4D44
        // reads member 0x364 XORed with the byte at 0x368, one of the client's
        // obfuscated fields, so this is a value it expects to be tamper-worthy.

        The MECHANIC is not inferred -- it is the game's own help text,
        MST_HELP_SUBTOPIC_100_8 "Sphere Capacity Increase": fusing the unit
        "Sphere Frog" (20302) raises the base unit's sphere capacity, one
        extra slot per unit and no more, inherited through evolution, and
        granted by nothing else.  UNIT_DETAIL_SPHERE_EXT ("Fuse to get another
        Sphere slot!") is the label the frog's own detail page shows.

        // RESOLVED 2026-09-05 -- THIS KEY IS *NOT* THE CARRIER, BUT THE
        // MECHANIC IS REAL.  Sphere capacity lives in equipitem_frame_id2
        // (RXfC31FA) as a "-1" sentinel, documented above.  Read sites for
        // getExtCnt really are only ChallengeArena party copies, so the client
        // does not appear to read THIS field -- that observation was correct.
        //
        // // THE CONCLUSION DRAWN FROM IT WAS NOT.  An earlier pass took the
        // // dead read sites, plus "no capacity symbol in libgame.so", plus
        // // unit_mst having no slot column, plus setEquipSphereIcon drawing
        // // both icons unconditionally, and concluded this build had DROPPED
        // // sphere capacity entirely -- every unit simply has two slots, and
        // // MST_HELP_SUBTOPIC_100_8 is legacy text.  ItemSphereEqp's gate was
        // // removed on the strength of that.  All of it was wrong:
        // //
        // //   * it hunted for a slot COUNT.  The capacity is not a count, it
        // //     is a sentinel value inside the frame id, which no search for
        // //     "SphereSlot"/"EqpCnt"/capacity columns could ever surface;
        // //   * several steps were xref-absence arguments over VIRTUAL getters
        // //     (getEquipItemFrameID2 is vtable+0x1f0, reached by blr x8).
        // //     so_xref cannot see virtual calls; absence proves nothing.
        // //
        // // What actually solved it was the game telling us: the fusion screen
        // // warns that material units with max Sphere capacity do not pass it
        // // down, and that warning string led straight to the check.
        //
        // Kept as the server-side boolean record of "a frog was fused", and as
        // the thing ItemSphereEqp gates on.  The invariant every write site
        // maintains is  eqip_item_frame_id2 == -1  <=>  sphere_ext == 0.
        """
    }

    field fe_bp type="i32::str" {
        key "bFQbZh3x"
        doc """
        setFeBP -- the unit's UNSPENT enhancement SP (Omni "SP Enhancements").
        GameUtils::mixFeBpCheck @0x1EC4C80 tests
            fe_bp + <SP the selected materials give> + fe_used_bp
        against fe_max_usable_bp (+ Omni Emperor cap), and the fusion material
        screen greys out every SP-only material (Burst/Omni Frogs on a max-level
        Omni unit) when that sum has no room -- so sending 0/0/0 here is what
        made frogs unusable for SP (#25).  The fusion result adds fe_used_bp to
        UnitOpeResult before/after_fe_bp for display (parseMixResult @0x1C18D6C),
        so those two carry unspent SP too.  Global wiki, Unit Skills rev 656738:
        10 SP to start, 100 at most.
        """
    }

    field fe_used_bp type="i32::str" {
        key "3RgneFpP"
        doc "setFeUsedBP -- SP already spent on enhancements (counts against fe_max_usable_bp together with fe_bp)."
    }

    field fe_max_usable_bp type="i32::str" {
        key "GIO9DTif"
        doc "setFeMaxUsableBP -- the SP limit: 100 (Global wiki), raised by Omni+ Boost (unit_evo_omni_mst ddD4lsc1) and, at Omni+3, by Omni Emperors to 130 (checkElemUnit compares against 0x82)."
    }

    field fe_skill_info type="str" {
        key "Fnxab5CN"
        doc """
        setFeSkillInfo @0x12B7B14 — the unit's acquired SP enhancements.
        Format, from the parser: groups joined by '/', each
        `<category>@<skill>:<skill>...`; the categories land in the list
        getFeCategory returns (helper-list icons), every skill id other than
        "" or "0" in the list isFeSkill / getFeSkillInfoList read.  "" and "0"
        mean none.  Categories are UnitFeSkillMst.category_id, skills
        FeSkillMst ids.  Written by FeSkillGet, cleared by ShopUse type 9;
        stored in user_units.fe_skill_info (30092026_UnitFeSkillInfo).
        """
    }

}

