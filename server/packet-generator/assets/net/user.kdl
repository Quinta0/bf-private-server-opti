json UserUnitDbbInfo {
    doc """
    One Dual Brave Burst bond: two of this player's units paired so they share
    a DBB (wrapper `sxorQ3Mb`, UserUnitDbbInfoResponse::readParam @0x1C75104).

    ⚠ REPLACE: readParam calls UserUnitDbbInfoList::removeAllObjects() before
    its first row, and an empty array never reaches readParam at all — so a
    player who has just UNBONDED everything still needs the key, with an empty
    list, or the client keeps the bond it already drew.

    ⚠ ONE ROW PER BOND, not two.  The list is a dictionary keyed by
    `edy7fq3L`, but addObject @0x1CC3374 also builds a second map from the
    BONDED id back to the main one, which is how the sub unit answers
    `isUnitBondedToAnotherUnit` without a row of its own.  Sending the mirror
    row as well would make each unit claim the other as its sub.

    The bond LEVEL is not here: UserUnitDbbInfo::getBondLevel() @0x1CC2DDC
    resolves both user units to their species, asks
    DbbMstList::getDbbMstByUnitIdsCombo which DBB that pair is, and looks the
    level up by that id in the `tR4katob` list.
    """

    field user_unit_id type="i32::str" {
        key "edy7fq3L"
        doc "setUserUnitId — the MAIN unit of the pair, and the dictionary key."
    }

    field bonded_user_unit_id type="str" {
        key "hDFXueWP"
        doc """
        setDbbBondedUserUnitId — the unit it is bonded to.

        A STRING rather than an id, because the empty one is meaningful: an
        empty list never reaches readParam (so removeAllObjects never runs, so
        an unbond cannot be expressed by sending nothing), and a row naming the
        released unit with an empty partner is how the client is told.  That is
        also the value its own constructor leaves here.
        """
    }
}

json UserUnitDbbLevelInfo {
    doc """
    How far one DBB pairing has been raised (wrapper `tR4katob`,
    UserUnitDbbLevelInfoResponse::readParam @0x1C7535C).  REPLACE, same rule as
    UserUnitDbbInfo.

    Keyed by DBB id, not by unit: getBondLevel() finds the DbbMst row for the
    pair and then looks up THAT id here.
    """

    field user_id type="str" {
        key "h7eY3sAK"
        doc "setUserId."
    }

    field dbb_id type="str" {
        key "sp3Xi9hu"
        doc "setDbbId — DbbMst.id, the row that pairs these two species."
    }

    field main_unit_id type="str" {
        key "pn16CNah"
        doc "setMainUnitId — the SPECIES id of the pair's main unit (this hash is the species id everywhere else, not a user_unit_id)."
    }

    field bond_level type="i32::str" {
        key "M81OjLwr"
        doc "setBondLevel — 1 on a fresh bond; DbbBondRecipeMst prices 2..6."
    }
}

json SummonTicketV2UserInfo {
    doc """
    How many of one V2 summon-ticket TYPE the player holds (wrapper a3d5d12i).

    Joined to SummonTicketV2Mst by id; that row says which gate the ticket
    redeems on (target_gacha) and how many it costs per pull (required_tickets,
    absent on every shipped row = 1).

    SummonTicketV2UserInfoResponse::readParam @0x1C6EBB4 calls
    SummonTicketV2UserInfoList::removeAllObjects() before its first row, so
    sending this key REPLACES the whole list -- and an empty array never runs
    readParam at all, so a type spent down to nothing has to keep reporting
    itself at 0.

    Load-bearing, not decoration: SummonsDetailScene::touchBegan @0x16A7FA8
    sums the amounts of the types whose MST row targets the open gate and
    refuses the pull when the total is 0, so a ticket paid into the present box
    could not be spent while this list was absent.
    """

    field id type="i32::str" {
        doc "setSummonTicketV2Id.  Ticket TYPE id, joins SummonTicketV2Mst.id."
        key "b0D2iq2d"
    }

    field amount type="i32::str" {
        doc "setAmount.  How many of this type are held; 0 is meaningful (see the struct doc)."
        key "Rs7bCE3t"
    }
}

json UnitSelectorGachaUserInfo {
    doc """
    One Unit Selector ticket the user holds, response key CGHaOZda (the same
    hash as the UnitSelectorGachaTicket request group, a different class).
    Decoded 2026-09-11 from UnitSelectorGachaUserInfoResponse::readParam
    @0x1CCB500.

    A FULL REPLACE: row 0 / param 0 destroys the whole
    UnitSelectorGachaUserInfoList before the first row is read, so every send
    must carry the complete inventory.  An empty list never reaches readParam
    and so clears nothing -- a ticket spent down to zero has to go out with
    count 0, which is why the server sends every catalog ticket, held or not
    (gme::loadSelectorTickets).  No client code changes these counts locally.

    Readers: SummonsScrlItem::addObject @0x16DA238 (the banner's pull count,
    count / required_tickets summed over the selectors of that gate),
    SummonsDetailScene::setGachaInfo @0x16A3A9C (the held count) and
    UnitSelectorGachaUnitSelectScene::initialize @0x1D95E54.  They match the
    row to the selector by the MST's ticket id.  required_tickets (MST
    JRqU2bS6) defaults to 1 and readParam clamps it to at least 1, so the
    division cannot be by zero.
    """

    field ticket_id type="str" {
        key "XIvaD6Jp"
        doc "setTicketId -- the UnitSelectorGachaMst ticket id (the same XIvaD6Jp the MST row is keyed by, and the target_id of a type-8005 present)."
    }

    field count type="i32::str" {
        key "H6k1LIxC"
        doc "setTicketCount (StrToInt).  Tickets held."
    }
}

json UserTrophyGradeInfo {
    doc """
    One trophy GRADE the player has attained (wrapper H18CjPKI).

    The Records screen does not work this out for itself:
    PlayerInfoBattleResultScene::getTrophyGrade @0x1799F34 walks the trophy's
    TrophyGradeMst rows and asks UserTrophyGradeInfoList::exist(gradeId) for
    each, taking the highest that is present -- so an absent list means every
    trophy shows grade 0 however high its counter has run.

    Field map from UserTrophyGradeInfoResponse::readParam @0x1404870, which
    clears the list on its first row (a FULL REPLACE) and adds one object per
    row.  Two fields only.
    """

    field user_id type="str" {
        key "h7eY3sAK"
        doc "setUserID."
    }

    field grade_id type="i32::str" {
        key "ARn3u96q"
        doc "setTrophyGradeID -- TrophyGradeMst.id, not the grade NUMBER: that table keys (trophy_id, grade, clear_cond) by its own id."
    }
}

json UserSummonerInfoEditNode {
    doc """
    The Summoner's appearance, from UserSummonerInfoEditRequest::createBody.

    The wiki's Summoner Avatar article names exactly these three choices as the
    first thing the arc asks for -- "Players will be prompted here when entering
    the Summoner Avatar Arc the first time": Gender, Hairstyle A/B/C, and
    Element.  Changing gender afterwards costs 1 Gem.
    """

    field accept_flag type="i32::str" {
        key "mnZ5K4Ii"
        doc "Confirmation flag the edit screen sends with the change."
    }

    field sex type="i32::str" {
        key "9i2xhMaJ"
        doc "Gender.  1 male, 2 female -- the same hash UserInfo already uses for it."
    }

    field element type="i32::str" {
        key "iNy0ZU5M"
        doc """
        Chosen element, 1 Fire .. 6 Dark.  ⚠ NOT cosmetic: the wiki is explicit
        that "the Quest you complete will merit you Summoning Arts based on the
        element you have picked", so this selects which of the six element
        levels a quest feeds -- the levels Randall bands 56000-61000 measure.
        """
    }

    field hair_id type="str" {
        key "btZizNep"
        doc "Hairstyle A/B/C.  // UNVERIFIED: named by position in createBody and by the wiki's list of the three choices; no setter was read."
    }

    field unk_RVVgyuor type="str" {
        key "RVVgyuor"
        doc "// UNVERIFIED: the fifth param of the edit group; no store to it was read."
        optional #true
    }
}

json UserSummonerInfoEditReq {
    doc """
    UserSummonerInfoEdit -- GroupId `ZJYkXcHo`, AES key `lyR0us9b`, recovered
    from getRequestID/getEncodeKey on the request class.

    ⚠ UNREGISTERED UNTIL 2026-09-20, and it is the FIRST request the Summoner
    Avatar arc makes, so entering the arc closed the session.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Caller identity."
    }

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal-key dispatch tag, echoed back."
    }

    field edit type="[UserSummonerInfoEditNode]::size(1)" {
        key "pxjFxjDZ"
        doc "The appearance being set."
    }
}

json UserSummonerInfoEditResp {
    doc "The refreshed Summoner block, so the screen redraws what was just saved."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal-key dispatch tag echoed back."
    }

    field summonerInfo type="[UserSummonerInfo]" {
        key "n5mdIUqj"
        doc "The one Summoner row.  A LIST -- readParam never runs on an empty array, so the client would keep its constructed defaults."
    }
}

json SummonerMixNode {
    doc "One unit offered to the Summoner, same node shape UnitBondBoost uses."

    field user_unit_id type="i32::str" {
        key "inU8Q4gL"
        doc "The user_unit_id being fused in."
    }

    field slot type="i32::str" {
        key "mnZ5K4Ii"
        doc "Picker slot; a client concern."
        optional #true
    }

    field kind type="i32::str" {
        key "29MgiJIQ"
        doc "Material kind, as on UnitBondBoost's list."
        optional #true
    }
}

json SummonerMixReq {
    doc """
    SummonerMix -- GroupId `nv4d3O7F`, AES key `vM65bAB4`.

    Fusing Frog units into the Summoner to earn SP.  The wiki's Summoner
    Parameters article gives the whole table: Burst Frog 50,000 Zel for +1 SP,
    Burst Emperor 250,000 for +5, Sphere Frog 500,000 for +10, and SP caps at
    99,999.  Nothing else can be fused.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Caller identity."
    }

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal-key dispatch tag, echoed back."
    }

    field materials type="[SummonerMixNode]" {
        key "8Z2NQrx1"
        doc "The units being fused in."
        optional #true
    }
}

json SummonerSkillGetReq {
    doc """
    SummonerSkillGet -- GroupId `qWkYyw5i`, AES key `mrXjLLJB`.

    Spends SP to raise one Parameter a level.  `SummonerAbilityLevelMst.need_sp`
    is the price, and it matches the wiki's SP cost tables exactly (Max HP lv2
    10, lv3 40, lv4 80, lv5 130 ...), which is what confirms the MST is the
    authority rather than the article.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Caller identity."
    }

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal-key dispatch tag, echoed back."
    }

    field ability_id type="str" {
        key "LPx0yZhY"
        doc "The Parameter being raised.  Sent through SummonerSkillGetRequest::setParam."
        optional #true
    }

    field target_level type="i32::str" {
        key "mgNdrCEe"
        doc "The level being bought -- the CURRENT level plus one."
        optional #true
    }
}
