json GuildJoinedListResp {
    doc "GuildJoinedList's reply.  GuildJoinedListRequest (3890ab5j, identity only) is sent ONLY by GuildRequestsListScene::initConnect @0x1e48b7c -- the guild's Requests screen -- not by the applicant."

    field requests type="[GuildJoinRequestInfo]" {
        key "aj38Jk10"
        doc "Every open application and outstanding invite of the caller's guild.  ⚠ Zero rows cannot clear the client's list."
    }
}

json GuildBoardInfo {
    doc "One board post.  GuildBoardInfoResponse::readParam @0x1C4E59C into GuildBoardInfoList (full replace on row 0).  GuildBoardScene::refreshMessageLayout @0x1D9CEC8 draws row 0 at the top."

    field post_id type="i32::str" {
        key "Kd8i2bKe"
        doc "setGuildBoardID."
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildID."
    }

    field user_id type="str" {
        key "h7eY3sAK"
        doc "setUserID.  Compared with the viewer's own user id to draw the post on the 'self' side; empty draws the default thumbnail."
    }

    field message type="str" {
        key "ZC0msu2L"
        doc "setMessage.  At most 160 characters, single line, on the client side."
    }

    field created type="str" {
        key "o94cnA8P"
        doc "setCreateDateFormattedString.  Drawn verbatim; the client parses nothing."
    }

    field handle_name type="str" {
        key "B5JQyV8j"
        doc "setHandleName.  The name label."
    }

    field friend_id type="str" {
        key "98WfKiyA"
        doc "setFriendID."
    }

    field team_lv type="i32::str" {
        key "2Fh3J7ng"
        doc "setTeamLevel."
    }

    field unit_id type="str" {
        key "pn16CNah"
        doc "setLeaderUnitID.  The thumbnail; \"1\" draws the default guild_board_chara_thum.png.  GuildBoardScene::downloadFiles fetches it on open, but NOT after a post, so it should be a unit the member list already carries."
    }
}

json GuildBoardPostNode {
    doc "GuildBoardPostRequest::createBody @0x1c4ebe0: one node."

