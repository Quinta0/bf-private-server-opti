json GuildRecomendedMemberResp {
    doc """
    Response for GuildRecomendedMember (ja5Enusw).

    ⚠ A FULL REPLACE.  readParam @0x1C64A38 calls removeAllObjects, so every
    send must carry the COMPLETE candidate list -- a partial send deletes the
    rest, the same trap as the unit dictionary and the Social list.
    """

    field members type="[GuildRecomendedMemberInfo]" {
        key "fRaBu6et"
        doc "Every invitable Summoner, in full."
    }

    field friends type="[GuildRecommendFriendInfo]" {
        key "8lAroepR"
        doc "One profile per fRaBu6et row, SAME user ids -- tapping a card clones its row from here unchecked.  Also a full replace (removeAllObjects on row 0).  ⚠ Neither list can be EMPTIED over the wire: a zero-row array never reaches readParam, so the last candidate invited stays on the client's list until a non-empty reply replaces it."
    }
}

json GuildTargetNode {
    doc "A guild named by id alone."

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "The guild.  QUOTED like every number a request carries: JsonNode::addParam(const char*, int) @0xFDB82C is CommonUtils::IntToString plus the string overload (binary-confirmed 2026-09-27).  An unquoted i32::int here stops glaze at this field and silently drops the rest of the request.  Captured from the Windows client 2026-09-27: \"sD73jd20\": \"1\" -- the unquoted model made every rank change a no-op."
    }
}

json GuildMemberEditNode {
    doc "One member being acted on.  From GuildMemberUpdateRequest::createBody @0x1C56448, which pairs with setMemberEditValue(std::string, int) @0x1C563FC."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "Who.  A std::string, matching the roster and the recommended list."
    }

    field value type="str" {
        key "gr48vsdJ"
        doc "The member's NEW rank (see GuildMemberInfo.member_type), or 0 to remove them.  GuildMemberInfoScene::updateEvent @0x1DD36B8 sends current - 1 to promote, current + 1 to demote and 0 to dismiss; the Hall and GuildTeamScene2 send the player's OWN id with 0 to leave.  QUOTED on the wire despite setMemberEditValue taking an int, because createBody uses the std::string addParam overload.  After a success the client applies the change to its own list (noticeOK @0x1DD3DD4), so the reply must NOT carry csIuech30: that key clears the member list first and the promote dereferences a freed member."
    }
}

json GuildMemberUpdateReq {
    doc "Request for GuildMemberUpdate (ad81b8at).  TWO groups, not one."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field guild type="[GuildTargetNode]::size(1)" {
        key "IkdSufj5"
        doc "Which guild."
    }

    field members type="[GuildMemberEditNode]" {
        key "csIuech30"
        doc "The members being edited; one node each."
    }
}

// ⚠ aj38Jk10 IS THREE THINGS.  It is the REQUEST group GuildJoin sends its one
// node under (GuildJoinReq, below), AND the group GuildInviteManage sends its
// accept/decline decisions under -- two ints per node.  It is ALSO the
// RESPONSE key GameResponseParser dispatches to GuildJoinRequestInfoResponse
// @0x1C54530, which reads 33 keys: the member card again, plus 7ad38bad,
// SL7ySqi8 and xvkLFco0.  That response is the list of Summoners who have
// APPLIED to join, which is the mirror of the invite the message box delivers.
//
// Not modelled, deliberately: nobody can apply to a guild on this server, so the
// screen has no rows to draw and modelling 33 fields for it would be
// speculative. tools/bin/kdl_response_audit.py reports the key as a gap because
// its matcher only knows the request side; that report is expected, not a bug.

json GuildInviteManageNode {
    doc "One accept/decline decision.  From setUserIdAndAction(int, int) @0x1C53DA0."

    field user_id type="i32::str" {
        key "7ad38bad"
        doc "⚠ AN INT, not the string id every other guild request uses.  GuildDetailScene::touchBegan @0x1DA9AC0 fills it from MessageBoxInfo::getGuildInviteID(), so it is an INVITE id travelling in the message box, not a Summoner id."
    }

    field action type="i32::str" {
        key "ad8D1kqP"
        doc "1 = accept, 0 = decline.  Both constants read off the callers: GuildDetailScene::touchBegan and GuildRequestsListScene::updateEvent pass mov w2,#1 at 0x1DA9AD8 and 0x1E4B7B0, and the reject loop passes wzr at 0x1E4B900."
    }
}

json GuildInviteManageReq {
    doc """
    Request for GuildInviteManage (1D8bba8D) -- the RECEIVING half of an invite.

    ⚠ NOT REACHABLE ON THIS SERVER, and modelled anyway so the gap is explicit
    rather than an unexplained hole in the guild set.  The invite id comes from
    the client message box and is an integer; this server has no numeric account
    ids and no message-box invite channel, and the Summoners being invited are
    simulated, so nothing ever sends the player an invite to accept.  Joining
    here runs the other way: the player's own invite, GuildJoin with type 2,
    whose ids are strings we actually own.  (Until 2026-09-26 this said
    GuildMemberUpdate; the client never sends that for an invite.)
    """

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[GuildInviteManageNode]" {
        key "aj38Jk10"
        doc "One node per decision; createBody loops the vector at +0x20 adding a node each time."
    }
}

json GuildJoinNode {
    doc "The one node GuildJoinRequest::createBody @0x1C54338 adds.  All three values go through CommonUtils::IntToString / a std::string, so all three arrive QUOTED."

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "The guild.  For an invite, the SENDER'S own guild (GuildUserGuildInfo::getGuildInfo()->getGuildId()); for an application, the guild being applied to."
    }

    field user_id type=str {
        key "h7eY3sAK"
        doc "Who joins.  For an invite, the FRIEND'S id (FriendInfo::getUserID of the profile being viewed); for an application, the player's own."
    }

    field request_type type="i32::str" {
        key "xvkLFco0"
        doc "setRequestValues' third argument, read off every caller: 2 = INVITE (all nine friend-profile scenes pass mov w3,#2 -- Guild Hall candidate, Social list, friend search, mission/arena/colosseum/vortex-arena results), 1 = APPLY (GuildDetailScene::touchBegan @0x1DA99CC).  The same key as GuildJoinRequestInfo's request type."
    }
}

json GuildJoinReq {
    doc """
    Request for GuildJoin (bfa2D1bp) -- the Invite to Guild button.

    ⚠ INVITING IS THIS REQUEST, NOT GuildMemberUpdate.  Every friend profile's
    invite button builds a GuildJoinRequest with type 2.  GuildMemberUpdate is sent
    only by the Hall, the member screen and GuildTeamScene2 -- with the player's
    OWN id next to GUILD_DISBAND_CONFIRMATION_OK, i.e. leaving/disbanding and
    member management, never an invite.

    After the send the profile scenes read nothing back except an error message:
    FriendDetailScene and the other result screens show GUILD_INVITE_FINISH, and
    the Guild Hall's own profile (FriendRandomSearchFriendRequestScene) shows
    nothing.  Going back rebuilds the Hall, whose initConnect re-requests ONLY
    GuildRecomendedMember -- so the reply should carry the refreshed GuildInfo or
    the member list stays stale until the next GuildInfo.
    """

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[GuildJoinNode]" {
        key "aj38Jk10"
        doc "Exactly one node (addGroup then a single addNode)."
    }
}

// ---------------------------------------------------------------------------
// The message inbox -- recovered 2026-09-17 from MessageInboxResponse::readParam
// @0x1C69AE8 and InboxMessageManageRequest::createBody @0x1C694A0.
//
// It lives in guild.kdl because a guild INVITE is a message: the class carries a
// whole guild alongside the text, and setGuildInviteID's key (7ad38bad) is the
// same one GuildInviteManage sends back to accept or decline.  That is the
// receiving half of the invite loop.
// ---------------------------------------------------------------------------

json MessageInboxInfo {
    doc """
    One message.  MessageBoxInfo on the client.

    Every guild field here is the SAME key the standalone GuildInfo uses, because
    an invite has to draw the guild it is inviting you to without a second
    request -- the message carries a copy.
    """

    field message_id type="i32::str" {
        key "78Zema70"
        doc "setMessageID.  What InboxMessageManage names to act on a message."
    }

    field message_date type="str" {
        key "KjS8hhHS"
        doc "setMessageDate.  A display string, not a timestamp."
    }

    field message_type type="i32::str" {
        key "3e9aGpus"
        doc "setMessageType.  ⚠ The SAME key the GME error envelope uses for its error code -- different class, different direction, unrelated meaning.  // UNVERIFIED: the type vocabulary is not recovered."
    }

    field message_action type="i32::str" {
        key "oohpPLCt"
        doc "setMessageAction.  // UNVERIFIED: which actions the message offers; not yet traced to a consumer."
    }

    field message_title type="str" {
        key "y53KRhOb"
        doc "setMessageTitle.  The subject line in the list."
    }

    field message_content type="str" {
        key "bQvVOkkR"
        doc "setMessageContent.  The body."
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildId.  The guild this message is about; 0 when it is not a guild message."
    }

    field guild_name type="str" {
        key "s35idar9"
        doc "setName.  The guild's name, copied into the message."
    }

    field guild_description type="str" {
        key "qp37xTDh"
        doc "setDescription.  The guild's blurb, copied into the message."
    }

    field guild_art_id type="i32::str" {
        key "dDKCN293"
        doc "setGuildArtId.  The guild's crest."
    }

    field guild_level type="i32::str" {
        key "osidufj5"
        doc "setLevel.  The guild's level."
    }

    field guild_rank type="i32::str" {
        key "P_RANK"
        doc "setRank @0x1C69FE4.  ⚠ Literal, unhashed, six characters -- the same odd key GuildInfo uses, and the same reason an 8-character key sweep misses it."
    }

    field guild_prestige_point type="i32::str" {
        key "sc83dkh3"
        doc "setPrestigePoint.  The guild's currency balance."
    }

    field guild_members_count type="i32::str" {
        key "SivJ9sL9"
        doc "setMembersCount.  How many are already in."
    }

    field guild_master_name type="str" {
        key "aBcniqj8"
        doc "setMasterName.  Who is inviting."
    }

    field guild_create_date type="str" {
        key "o94cnA8P"
        doc "setCreateDate.  When the inviting guild was founded -- the message carries it so the invite can show the guild's age without a second request, the same reason it copies the name and crest."
    }

    field guild_invite_id type="i32::str" {
        key "7ad38bad"
        doc "setGuildInviteID @0x1C6A10C.  THE INVITE HANDLE: GuildDetailScene::touchBegan @0x1DA9AC0 reads it straight back out with getGuildInviteID() and hands it to GuildInviteManage as its user_id.  That is why that request takes an int."
    }
}

json MessageInboxResp {
    doc """
    The inbox.

    ⚠ A FULL REPLACE: readParam @0x1C69AE8 calls removeAllObjects, so a send must
    carry every message.  An EMPTY list is safe and means "nothing here" -- a
    zero-row array never reaches readParam, so it clears nothing either.
    """

    field messages type="[MessageInboxInfo]" {
        key "D9dkXSPY"
        doc "Every message, in full."
    }
}

json InboxMessageManageNode {
    doc "One message being acted on.  From setMessageIdAndAction(int, int) @0x1C69388, the same shape GuildInviteManage uses for invites."

    field message_id type="i32::str" {
        key "78Zema70"
        doc "Which message.  QUOTED like every number a request carries: JsonNode::addParam(const char*, int) @0xFDB82C is CommonUtils::IntToString plus the string overload (binary-confirmed 2026-09-27).  An unquoted i32::int here stops glaze at this field and silently drops the rest of the request."
    }

    field action type="i32::str" {
        key "Hhgi79M1"
        doc "What to do with it.  ⚠ This key is also the OUTER envelope's GroupId field (handbook 4); inside this node it is the action, and the two have nothing to do with each other.  // UNVERIFIED: the action vocabulary is not recovered."
    }
}

json InboxMessageManageReq {
    doc "Request for InboxMessageManage (rYSfaC4P) -- opening or acting on the message box."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[InboxMessageManageNode]" {
        key "YBsNO3cI"
        doc "One node per message acted on; createBody loops its vector adding a node each time."
    }
}

// ---------------------------------------------------------------------------
// The guild roster -- GuildMembersInfoResponse::readParam @0x1C56648.
//
// ⚠ THE KEY IS NINE CHARACTERS.  `csIuech30` went unseen for a whole pass
// because the dispatch sweep matched exactly eight-character keys; combined
// with P_RANK at six, that assumption has now hidden three real fields.  The
// sweep is widened (tools/bin/so_response_map.py) and finds eight more keys
// across the protocol than it did.
//
// ⚠ AND IT IS THE SAME KEY GuildMemberUpdate SENDS ITS EDITS UNDER.  Request
// and response share it, as they do for IkdSufj5.
//
// MOST OF THIS IS A SUMMONER CARD.  23 of the 37 keys are the same ones
// FriendInfo uses for a borrowable helper, and the names here are taken from
// net/friends.kdl on that basis -- key identity within the same card family,
// not an independent trace of each setter.  The genuinely guild-specific
// fields are member_type, cp_points, tokens, active_guild_deck and last_online.
// ---------------------------------------------------------------------------

json GuildMemberInfo {
    doc "One member of a guild, as the Guild Hall roster draws them."

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildId @0x1C566D0.  Which guild this row belongs to."
    }

    field user_id type="str" {
        key "h7eY3sAK"
        doc "setUserID @0x1C56764.  A std::string -- the same id the friend roster and GuildMemberUpdate use."
    }

    field handle_name type="str" {
        key "B5JQyV8j"
        doc "setHandleName @0x1C56808."
    }

    field team_lv type="i32::str" {
        key "2Fh3J7ng"
        doc "setTeamLv @0x1C56844."
    }

    field friend_id type="str" {
        key "98WfKiyA"
        doc "setFriendID @0x1C568D8.  Present because a guild member may also be a friend; the Hall shows that."
    }

    field friend_message type="str" {
        key "bM7RLu5K"
        doc "setFriendMessage @0x1C5697C."
    }

    field member_type type="i32::str" {
        key "gr48vsdJ"
        doc """
        setMemberType @0x1C572FC -- the member's RANK inside the guild.

        BINARY-CONFIRMED vocabulary (2026-09-27): GameUtils::getNameOfGuildRank
        @0x1EC4178 draws GUILD_RANK_NAME_<n>, which the client's string table
        defines for 1 Guild Master, 2 Vice Guild Master, 3 Officer, 4 Member.
        Lower is higher: promoting sends n - 1.  0 has no name (it is
        GuildMemberUpdate's "remove"), which is why every member drew wrong
        while the server sent 0.
        """
    }

    field cp_points type="i32::str" {
        key "9SVsdnwl"
        doc "setCpPoints @0x1C57328.  Contribution points; the Hall has a CP Ranking button that reads them."
    }

    field tokens type="i32::str" {
        key "23b6d2ia"
        doc "setTokens @0x1C57400.  The member's guild-token balance.  Guild tokens are present type 8002, which the present box still cannot pay -- see the present-type notes."
    }

    field active_guild_deck type="i32::str" {
        key "Z0Y4RoD7"
        doc "setActiveGuildDeck @0x1C5742C.  Which of their guild decks is fielded."
    }

    field last_online type="i64::str" {
        key "93nclsc8"
        doc "setLastOnline @0x1C573C4, a long -- the only 64-bit field here.  Same key GuildRecomendedMemberInfo uses."
    }

    field arena_rank_id type="str" {
        key "JmFn3g9t"
        doc "setArenaRankID @0x1C570B4."
    }

    field fe_skill_info type="str" {
        key "Fnxab5CN"
        doc "setFeSkillInfo @0x1C572C0.  Packed elemental-skill data; kept as a string because its grammar is not decoded."
    }

    field unit_img_type type="i32::str" {
        key "2pAyFjmZ"
        doc "setUnitImgType @0x1C56A64.  Which art variant of the card unit to draw."
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "The unit on their card.  Setter inlined; named from net/friends.kdl by key identity."
    }

    field unit_lv type="i32::str" {
        key "4A6LzBxr"
        doc "That unit's level.  Setter inlined."
    }

    field base_hp type="i32::str" {
        key "e7DK0FQT"
        doc "Setter inlined."
    }

    field base_atk type="i32::str" {
        key "67CApcti"
        doc "Setter inlined."
    }

    field base_def type="i32::str" {
