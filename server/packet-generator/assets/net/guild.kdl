json GuildMembersInfoResp {
    doc """
    The guild roster.

    Sent alongside the guild itself: the Hall draws the member list from this,
    and with it absent the list is empty and tapping a member dereferences null
    -- an access violation with no dialog, which is what a client test hit on
    2026-09-17 (read 0x230, unmapped).

    THAT IS THE LIMIT OF THE EMPTY-BODY STUB.  Answering `{}` keeps the session
    alive where an unregistered GroupId would close it, but a scene that needs
    rows still crashes on the rows it did not get.  A stub prevents the protocol
    failure, not the null dereference.
    """

    field members type="[GuildMemberInfo]" {
        key "csIuech30"
        doc "Every member of the caller's guild.  Same key GuildMemberUpdate sends its edits under."
    }
}

// =============================================================================
//  GuildRanking (2b9D01b4 / 23Djab0e) and GuildRankingDetail (7ekSBz2y / tWF58aK0)
//
//  Both crashed the client as empty-body stubs.  Same shape of failure as the
//  Guild Hall member list: the stub keeps the session alive, the scene still
//  dereferences the rows it did not get.  Every field below is
//  binary-confirmed -- each has a NAMED, non-inlined setter in the response's
//  own readParam, so nothing here is inferred from value shape.
// =============================================================================

json GuildRankingInfo {
    hash "g7hx43Pq"
    doc """
    One guild's row on the leaderboard.  GuildRankingResponse::readParam
    @0x1C64000; the list is a REPLACE (removeAllObjects), so every reply carries
    the whole board.
    """

    field ranking_type type="i32::str" {
        key "C6W4Vpow"
        doc "setRankingType @0x1C64088 — which board this row belongs to (the screen's tab)."
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildID @0x1C640B4.  Same key GuildInfo uses."
    }

    field name type=str {
        key "s35idar9"
        doc "setName @0x1C64148."
    }

    field description type=str {
        key "qp37xTDh"
        doc "setDescription @0x1C641EC."
    }

    field guild_art_id type="i32::str" {
        key "dDKCN293"
        doc "setGuildArtID @0x1C64228 — the crest."
    }

    field guild_level type="i32::str" {
        key "osidufj5"
        doc "setGuildLevel @0x1C64254."
    }

    field prestige_points type="i32::str" {
        key "sc83dkh3"
        doc "setPrestigePoints @0x1C64280 — what the board is ordered by."
    }

    field ranking type="i32::str" {
        key "P_RANK"
        doc "setRanking @0x1C642AC.  ⚠ SIX characters and literal, not an 8-char hash — so a tool that only matches 8-char keys will report this field missing."
    }

    field season_id type="i32::str" {
        key "X7hZ03iq"
        doc "setSeasonID @0x1C642E0."
    }
}

json GuildRankingDetailInfo {
    hash "R6YwbeCB"
    doc """
    One MEMBER's row inside a guild's ranking breakdown.
    GuildRankingDetailResponse::readParam @0x1C63950, also a REPLACE.

    Note it carries TWO name setters against different keys: B5JQyV8j and
    s35idar9 both land on setName.  s35idar9 is the guild's name on the sibling
    board, so B5JQyV8j is the member's — they are filled accordingly, and the
    ambiguity is recorded here rather than resolved by guesswork.
    """

    field ranking type="i32::str" {
        key "P_RANK"
        doc "setRanking @0x1C63CA0 — this member's place within the guild."
    }

    field member_name type=str {
        key "B5JQyV8j"
        doc "setName @0x1C63A6C.  // UNVERIFIED which of the two name keys the screen draws where; this one is filled with the MEMBER's handle."
    }

    field ranking_type type="i32::str" {
        key "C6W4Vpow"
        doc "setRankingType @0x1C63AA8."
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildID @0x1C63AD4."
    }

    field guild_name type=str {
        key "s35idar9"
        doc "setName @0x1C63B68 -- the SAME setter as B5JQyV8j (@0x1C63A6C), and keys are processed in sorted order, so this one wins.  Despite the field name it must carry the MEMBER's name (2026-10-17): sending the guild's name drew every member as the guild."
    }

    field user_id type=str {
        key "h7eY3sAK"
        doc "setUserID @0x1C63C0C."
    }

    field guild_level type="i32::str" {
        key "osidufj5"
        doc "setGuildLevel @0x1C63C48."
    }

    field bcp_points type="i32::str" {
        key "gE2NN2xi"
        doc "setBcpPoints @0x1C63C74 — Battle Contribution Points, the per-member score."
    }

    field unit_lvl type="i32::str" {
        key "4A6LzBxr"
        doc "setUnitLvl @0x1C63CCC — the member's showcase unit level."
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "setUnitId @0x1C63CF8."
    }

    field unit_img_type type="i32::str" {
        key "2pAyFjmZ"
        doc "setUnitImgType @0x1C63D2C — the alternate-art bit."
    }
}

json GuildRankingResp {
    doc """
    GuildRanking's reply.

    THREE blocks, not one.  The board alone leaves GuildRaidRankingResultScene
    dereferencing a null season -- see the block comment above.
    """

    field ranking type="[GuildRankingInfo]" {
        key "g7hx43Pq"
        doc "The whole board.  REPLACE: GuildRankingResponse::readParam clears with removeAllObjects before reading, so a partial reply is a truncated board, not an update to one."
    }

    field seasons type="[GuildRaidSeasonDataInfo]" {
        key "mK6fd7L7"
        doc "Every season the picker can move between.  REPLACE.  Must never be empty: the scene indexes it with no null check."
    }

    field round type="[GuildRaidRoundInfo]" {
        key "Nebq4d8x"
        doc "The round clock.  A singleton, so one row."
    }
}

json GuildRankingDetailResp {
    doc "GuildRankingDetail's reply: one row per member of the guild being inspected."

    field detail type="[GuildRankingDetailInfo]" {
        key "R6YwbeCB"
        doc "One row per member.  REPLACE, same as the board above."
    }
}

// =============================================================================
//  What GuildRanking's reply ALSO has to carry.
//
//  The screen behind `GuildRankingRequest` is GuildRaidRankingResultScene, not
//  a plain leaderboard, and its initConnect @0x1E1AFD4 reads
//  `GuildRaidRoundInfo::shared()->getSeasonID()` before it even sends.  Its
//  setLayout, initSubHeader, updateEvent, updatePreviousSeason,
//  updateNextSeason, touchEnded and updatePreviousButtonState all then index
//  `GuildRaidSeasonDataInfoList::shared()`.
//
//  With that list empty the season lookup falls through to `xor eax,eax` and
//  the very next instruction dereferences it -- PE +0x2FEEB1,
//  `mov eax,[eax+0x14]`, which is the `read 0x00000014` in the crash dump.
//  There is no null check.  Sending the ranking rows alone was never going to
//  be enough, which is why the screen still crashed after they were modelled.
// =============================================================================

json GuildRaidSeasonDataInfo {
    hash "mK6fd7L7"
    doc """
    One selectable season on the ranking screen's season picker.
    GuildRaidSeasonDataResponse::readParam @0x1C646AC -- a REPLACE list with
    exactly one field.  The client turns the id into a name itself:
    `GR_SESSION_%04d_NAME`, which its string table answers for 1..66
    ("Season 1 Results" and up).
    """

    field season_id type="i32::str" {
        key "dk39bDa1"
        doc "setSeasonID @0x1C64724.  The only field the row has."
    }
}

json GuildRaidRoundInfo {
    hash "Nebq4d8x"
    doc """
    The guild-raid round clock.  A SINGLETON (no list ops in its readParam
    @0x1C61E24), read by the ranking screen before it connects.

    Only the ten fields with a named setter are modelled.  `s385qzx9`,
    `gE2NN2xi` and `qXCIfZIk` have inlined setters and nothing to fill them
    from, so they are deliberately absent rather than sent as 0 (handbook 3.4).
    """

    field season_id type="i32::str" {
        key "dk39bDa1"
        doc "setSeasonID @0x1C61E8C."
    }

    field round_id type="i32::str" {
        key "81tacsfJ"
        doc "setRoundID @0x1C61EB8."
    }

    field server_time type="i32::str" {
        key "z1I0P1Qk"
        doc "setServerTime @0x1C61F88.  Unix seconds; every countdown below is measured against it."
    }

    field preparation_end_time type="i32::str" {
        key "qS4wLauD"
        doc "setPreparationEndTime @0x1C62034."
    }

    field battle_preparation_end_time type="i32::str" {
        key "l4txLZJ1"
        doc "setBattlePreparationEndTime @0x1C620E0."
    }

    field battle_end_time type="i32::str" {
        key "WhVJkLa1"
        doc "setBattleEndTime @0x1C6218C."
    }

    field consolidation_end_time type="i32::str" {
        key "6lldENEG"
        doc "setConsolidationEndTime @0x1C62238."
    }

    field current_phase type="i32::str" {
        key "djaB081u"
        doc "setCurrentPhase @0x1C62268.  // UNVERIFIED enumeration -- the phase values are not decoded, so this reports the consolidation/results phase the ranking screen is reached from."
    }

    field current_phase_end_time type="i32::str" {
        key "ka8D1i0b"
        doc "setCurrentPhaseEndTime @0x1C62304."
    }

    field outpost_relocate_remain_time type="i32::str" {
        key "d3B6aKl3"
        doc "setOutpostRelocateRemainTime @0x1C623B0."
    }
}

json GuildRankingReq {
    doc "GuildRanking's request (2b9D01b4).  createBody @0x1C63E2C adds group g7hx43Pq with exactly these two params, on top of the three BaseRequest tags."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field ranking type="[GuildRankingReqItem]" {
        key "g7hx43Pq"
        doc "The board being asked for."
    }
}

json GuildRankingReqItem {
    doc "The one node GuildRankingRequest::createBody fills."

    field ranking_type type="i32::str" {
        key "C6W4Vpow"
        doc "setRequestRankingType -- which tab the screen is on.  Echoed back on every row so the client can tell whose board it is looking at."
    }

    field season_id type="i32::str" {
        key "X7hZ03iq"
        doc "The season being viewed, taken from GuildRaidRoundInfo::getSeasonID() before the send."
    }
}
json GuildTradeNode {
    doc "GuildTradeRequest createBody 0x1C67D3C, numeric addParam overloads.  QUOTED like every number a request carries: JsonNode::addParam(const char*, int) @0xFDB82C is CommonUtils::IntToString plus the string overload (binary-confirmed 2026-09-27).  An unquoted i32::int here stops glaze at this field and silently drops the rest of the request."
    field id type="i32::str" {
        key "Yxo3bEic"
        doc "id; see enclosing packet for binary evidence."
    }
    field count type="i32::str" {
        key "H6k1LIxC"
        doc "count; see enclosing packet for binary evidence."
    }
}

json GuildTradeReq {
    doc "Group 38adiJeb, key ja3biAqb."
    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "login info; see enclosing packet for binary evidence."
    }
    field nodes type="[GuildTradeNode]" {
        key "ah82D1iq"
        doc "nodes; see enclosing packet for binary evidence."
    }
}

// ---------------------------------------------------------------------------
// Guilds between real players (2026-10-17): search, a friend's guild, the
// Requests screen, the board and the ranking detail.  Recovered by the
// guild-client-re pass; docs/features/GUILDS_SOCIAL_2026-10-17.md.
// ---------------------------------------------------------------------------

json GuildSearchNode {
    doc "GuildSearchRequest::createBody @0x1c675c0: one node, the keyword."

    field name type="str" {
        key "bj729kiq"
        doc "UserState::getGuildSearchName, copied in by GuildSearchListScene::initConnect @0x1e63154 from the search box (filterText(8, mode 4), the guild-name filter).  Never empty: GuildRecommendedListScene refuses an empty keyword with GUILD_SEARCH_NO_KEYWORD before sending."
    }
}

json GuildSearchReq {
    doc "Request for GuildSearch (R38ba9M3)."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field search type="[GuildSearchNode]" {
        key "kj1d80ai"
        doc "The same string as the response key."
    }
}

json GuildSearchResp {
    doc "GuildSearch's reply.  GuildSearchResponse::readParam @0x1c6772c fills GuildInfoSearchList (full replace on row 0; the scene also clears it before every search).  Empty means GUILD_SEARCH_NOT_FOUND and back to 102002, which is safe."

    field guilds type="[GuildInfo]" {
        key "kj1d80ai"
        doc "Matching guilds.  Ten keys are read (sD73jd20 s35idar9 qp37xTDh dDKCN293 osidufj5 P_RANK sc83dkh3 SivJ9sL9 aBcniqj8 o94cnA8P); the cap comes from GuildInfoMst by level.  Guild id 0 is dropped."
    }
}

json GuildMemberTargetNode {
    doc "GuildMemberGuildInfoRequest::createBody @0x1c5575c: one node under csIuech30 (the MEMBERS key, not IkdSufj5)."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "The profile's user id: FriendInfo / RivalParty / ReinforcementInfo ::getUserID on nine profile scenes."
    }
}

json GuildMemberGuildInfoReq {
    doc "Request for GuildMemberGuildInfo (38bSeq81) -- a profile's View Guild button, shown only when the profile's guild id (FriendInfo sD73jd20) is not 0."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field members type="[GuildMemberTargetNode]" {
        key "csIuech30"
        doc "Whose guild."
    }
}

json GuildMemberGuildInfoResp {
    doc "GuildMemberGuildInfo's reply.  GuildMemberGuildInfoResponse::readParam @0x1c558e8 stores ONE new GuildInfo as GuildUserGuildInfo's search target; FriendDetailScene::updateEvent @0x166b15c then opens GuildDetailScene on it (with Apply).  An empty reply leaves the previous target, so the profile opens the last guild viewed -- send a row whenever the user has a guild."

    field guild type="[GuildInfo]" {
        key "8bD18LPe"
        doc "Exactly one row, including Nt38aDqi (max members)."
    }
}

json GuildJoinRequestInfo {
    doc """
    One row of the Requests screen: an APPLICATION to the caller's guild
    (request type 1) or an INVITE it has sent (type 2).
    GuildJoinRequestInfoResponse::readParam @0x1c54530 into GuildUserGuildInfo's
    join-request list (full replace on row 0; zero rows leave the old list).
    GuildRequestsListScene::setRequestsList @0x1e48e48 splits by type.  The
    member card is the usual Summoner card; unit stat names follow
    net/friends.kdl by key identity.
    """

    field invite_id type="i32::str" {
        key "7ad38bad"
