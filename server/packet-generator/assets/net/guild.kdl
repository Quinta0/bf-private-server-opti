json GuildUpdateNode {
    doc "GuildUpdateRequest::createBody @0x1C67F20: one node, from setGuildInfoValue(std::string desc, int artId, int action) @0x1C67ED0.  There is no name key: the client cannot rename a guild."

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "GuildUserGuildInfo::getGuildInfo()->getGuildId()."
    }

    field description type="str" {
        key "qp37xTDh"
        doc "The description being saved (the edit box takes 150 characters); \"\" for a disband."
    }

    field guild_art_id type="i32::str" {
        key "dDKCN293"
        doc "The crest (GuildSelectInsigniaScene hands back ids >= 1); \"0\" for a disband."
    }

    field action type="i32::str" {
        key "ad8bdAj1"
        doc "0 = save the edits (GuildHallScene states 5 and 7), -1 = disband (state 2, after two confirmations).  The constructor's -2 is always overwritten."
    }
}

json GuildUpdateReq {
    doc "Request for GuildUpdate (92bDoqBi), sent only by GuildHallScene (GuildTeamScene2 is unreachable).  The client reads nothing back: GuildConnectScene shows the success notice and the Hall applies the edit, or on a disband sets its guild id to 0 and goes Home.  Reply {}."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field guild type="[GuildUpdateNode]" {
        key "IkdSufj5"
        doc "Exactly one node."
    }
}
