// Frontier Gate — the per-user progress payload (net side).  The gate/floor
// catalog and support-effect tables are the MST side and live in
// mst/frontier_gate.kdl; F_FROGATE_REWARD_MST and F_FRONTIER_GATE_AREA_MST are
// client-loaded, so the server never sends reward or area data.  The server's
// job here is per-user progress only: which gate, what state/progress, score,
// and the support slot.
//
// Decoded 2026-08-07 — full audit in tools/ida/audits/dPM7oJDl_audit.txt.
//
// Every setter in FrontierGateInfoResponse::readParam (@0x142ECBC) is INLINED,
// so no field name comes out of the pseudocode directly.  Two levers resolved
// them: cross-class hash reuse (the same key named by a real call in another
// response class) and the vtable slot map — the inlined calls are virtual
// dispatches at fixed offsets +48..+208, a clean 16-byte stride with no gaps,
// giving 11 slots for 11 wire keys.  That is the COMPLETE field layout.
//
// // REVERTED FROM the legacy stub: bfdata/responses/Frontier/
// FrontierGateInfoResponse.hpp declares only 7 fields, omits NungTq5g /
// JQ23rIvk / SzV0Nps7 / 2wHGmJqm entirely, and orders the rest wrongly.  Do not
// build from it.  readparam_analysis.json has the same 7-field gap and types
// every one of them uint32_t; where it disagrees with the pseudocode (start_date
// / end_date are std::string there, not uint32_t) THE PSEUDOCODE WINS — the
// analysis entry appears to be what the legacy stub was generated from.
//
// Field order below follows response_mappings.json's params list (which matches
// the readParam strcmp chain).  Note that is NOT the vtable order: the chain
// tests j28VNcUW before 69bpUIXR while the vtable declares them the other way.
// Each doc records its vtable slot, since slot adjacency is the evidence behind
// the two UNVERIFIED names.

json FrontierGateInfo {
    doc "Frontier Gate per-user progress entry — one per gate, under response_key dPM7oJDl (array).  Populates the FrontierGateInfoList singleton the FG top/select screens read from."

    field frogate_id type="i32::str" {
        key "hBNPQAU0"
        doc "setFrogateID.  vtable slot 0 (+48).  = FrontierGateMst.id (1..3, then 200001..200015).  The binary StrToInt's the wire value then IntToString's it back before storing, so it is provably an integer even though the setter takes std::string (FrontierGateInfoList::getObjectWithFrogateID also keys on the string form)."
    }

    field score type="i32::str" {
        key "TPR79fyI"
        doc "setScore.  vtable slot 1 (+64).  CommonUtils::StrToInt — a plain int."
    }

    field support_id_list type="[i32::str]::sep(comma)" {
        key "NungTq5g"
        doc "setSupportIDList.  vtable slot 2 (+80).  CommonUtils::parseList with separator constant 11266 = 0x2C02 (an SSO std::string holding ','), so comma-separated.  Elements = FrontierGateSupportMst.id, which are plain ints (100..123 and 2xxxxx across all 61 rows), hence [i32::str].  Same hash/name as mst/frontier_gate.kdl's support id."
    }

    field state type="i32::str" {
        key "j0Uszek2"
        doc "setState.  vtable slot 3 (+96).  StrToInt.  // UNVERIFIED: the state enum's values are not decoded — no capture exists (deploy/log has no http_log_M17pPotk_*)."
    }

    field reward_info_list type="[str]::sep(comma)" {
        key "JQ23rIvk"
        doc "setRewardInfoList.  vtable slot 4 (+112).  parseList, same comma separator as NungTq5g.  Elements stay `str`: the sibling use of this hash in mst/raid.kdl (F_RAID_RC_MST reward_info, CONFIRMED setRewardInfo) holds colon-packed tuples like \"6:20302:1:1:1\", so they are not plain ints.  Also carried by CampaignMissionInfoResponse (2I9V0o6J) and ColosseumUserInfoResponse (FfBebG0R)."
    }

    field progress type="i32::str" {
        key "pG2n1A28"
        doc "setProgress.  vtable slot 5 (+128).  StrToInt.  readParam ALSO mirrors this value to FrontierGateComInfo::setPlayProgress on the shared singleton — the two names (Progress / PlayProgress) are the same number."
    }

    field mission_id type="str" {
        key "j28VNcUW"
        doc "setMissionID.  vtable slot 6 in wire order (+160 in the vtable).  Kept `str`, not i32::str: the binary stores this one WITHOUT any StrToInt, unlike frogate_id/score/state/progress which are all converted.  That asymmetry is the evidence — the client treats it as an opaque string.  Narrow it only against a real capture."
    }

    field progress_max type="i32::str" {
        key "69bpUIXR"
        doc "// UNVERIFIED (named from vtable slot position + arg type): ProgressMax.  vtable slot 6 (+144), StrToInt.  This key is FG-EXCLUSIVE — it appears in no other class in readparam_analysis.json or response_mappings.json and has no named setter anywhere in the corpus, so cross-class reuse cannot resolve it.  Structural argument: of the five FrontierGateInfo getters left unclaimed (getProgressMax, getRanking, getMissionStartDate, getMissionEndDate, getTimeString) only ProgressMax and Ranking are int-shaped, and this slot sits immediately after slot 5 = Progress.  RISK: could be swapped with `ranking` below — both are ints, so a swap is wire-compatible and would surface only as a wrong number on screen.  Disambiguate by sending distinguishable sentinels (7 here, 99 there) and reading which the UI prints as progress vs as a rank."
    }

    field start_date type="str" {
        key "qA7M9EjP"
        doc "setStartDate.  vtable slot 8 (+176).  CONFIRMED by cross-class reuse: named setStartDate by GachaInfoResponse (1IR86sAv), FeatureGatingInfoResponse (2375D38i), BundlePacksInfoResponse (K72eC4nz) and UserTownLocationDetailResponse (s8TCo2MS).  `str` on THIS path — the setter takes a std::string with no numeric conversion, matching the string-typed siblings and mst/guild.kdl's datetime strings.  Do NOT reuse mst/frontier_gate.kdl's i64::str raw-unix-seconds type here without a capture; readparam_analysis.json claims uint32_t but the pseudocode builds a std::string."
    }

    field end_date type="str" {
        key "SzV0Nps7"
        doc "setEndDate.  vtable slot 9 (+192).  CONFIRMED by cross-class reuse: named setEndDate by UserItemTimeLimitInfoResponse (YmaEqtA8), and pairs with qA7M9EjP as start/end in GachaInfo, BundlePacks, BundlePacksCategory, FeatureGating and InteractiveBanner.  Same `str` reasoning as start_date."
    }

    field ranking type="i32::str" {
        key "2wHGmJqm"
        doc "// UNVERIFIED (named from vtable slot position + arg type): Ranking.  vtable slot 10 (+208), StrToInt.  Thinner evidence than progress_max: this key is absent from readparam_analysis.json entirely (hand-coded getValue path) and appears in response_mappings.json only for dPM7oJDl.  Structural argument: it is the LAST declared field, fitting a later-revision append, and Ranking is a feature the client gates behind FrontierGateMst::getRankingDispFlg while the full board lives in its own classes (FrontierGateRankingInfo / FrontierGateRankingResponse) — a single per-gate \"my rank\" int here is consistent.  See the swap RISK noted on progress_max."
    }
}

// NOT wire fields — FrontierGateInfo also exposes getMissionStartDate,
// getMissionEndDate and getTimeString, and none of the three has a vtable slot
// in this response.  They are derived client-side, most likely from
// FrontierGateMst (which carries its own start/end dates and entry term) via
// mission_id.  Do not invent keys for them.

// ---------------------------------------------------------------------------
// Tier 2 — the active run.  FrontierGateStart (l3lkDBSc) opens one and the
// server answers with FrontierGateNum under key Mg8K8Y1a.
// ---------------------------------------------------------------------------

// Request side.  FrontierGateStartRequest::createBody @0x13BC3C0 BRANCHES on
// the isFGPlus byte at this+32: true takes createBodyFGPlusNum (group
// "Che7rAre") + the FGPlus deck/unit serializers, false takes
// createBodyFrogateNum (group "Mg8K8Y1a") + the normal ones.  Only ONE group is
// emitted per request — they are alternatives, not siblings.  Per handbook
// §11.2 the server handles the normal Frontier Gate path (Mg8K8Y1a) and leaves
// FGPlus alone.
json FrontierGateStartEntry {
    doc "The gate the player is entering and the support they picked — request group Mg8K8Y1a, one node (createBodyFrogateNum @0x13BC4F0)."

    field frogate_id type="i32::str" {
        key "hBNPQAU0"
        doc "FrontierGateComInfo::getFrogateGateID — the gate being entered, = FrontierGateMst.id.  Passed to addParam as a std::string, so quoted on the wire."
    }

    field support_id type="i32::str" {
        key "NungTq5g"
        doc "FrontierGateComInfo::getSupportID — the chosen support effect, = FrontierGateSupportMst.id.  SINGULAR here, unlike the same hash in dPM7oJDl where it is a comma LIST (SupportIDList).  Cardinality is per-context; do not share a type between the two."
    }
}

// Response side.  FrontierGateNumResponse::readParam @0x142FF48 — every one of
// the 7 setters is a REAL named call (no inlining), so unlike dPM7oJDl there is
// no guesswork in this struct.
//
// is_array = FALSE: readParam writes the FrontierGateNum SHARED SINGLETON and
// never calls addObject on a list, unlike FrontierGateInfoResponse which drives
// FrontierGateInfoList.  So Mg8K8Y1a is a single embedded OBJECT on the
// response, even though the request wraps the same key in an array via
// addGroup/addNode.  Same key, different cardinality per direction.
json FrontierGateNum {
    doc "The player's active Frontier Gate run — response key Mg8K8Y1a (FrontierGateNumResponse), a single object.  Its presence is also what FrontierGateSuspendedInfoResponse (gmeGFd2s, 1 field) projects."

    field frogate_num type="i32::str" {
        key "2FQdEbG3"
        doc "setFrogateNum.  StrToInt.  The RUN handle: FrontierGateEnd/Continue/Retry read it straight back out of the shared singleton (FrontierGateNum::getFrogateNum) and echo it as their own 2FQdEbG3, so the client never authors this value — the SERVER owns it and the client round-trips it opaquely."
    }

    field mission_status type="i32::str" {
        key "j3g5P4cq"
        doc "setMissionStatus.  StrToInt.  Named by RaidRoomUserInfoResponse (uwH62EZy), which uses the same hash.  // UNVERIFIED: the status enum's values are not decoded — no capture exists.  NOTE readparam_analysis.json omits this field for Mg8K8Y1a entirely (it lists 6 of 7); the pseudocode and response_mappings both have it."
    }

    field frogate_id type="i32::str" {
        key "hBNPQAU0"
        doc "setFrogateID.  StrToInt.  Which gate this run is in, = FrontierGateMst.id."
    }

    field sel_support_id type="i32::str" {
        key "NungTq5g"
        doc "setSelSupportID.  StrToInt — a SINGLE int here, not the comma list this hash carries in dPM7oJDl."
    }

    field power_up_rate_hp type="f32::str" {
        key "9iE6ouVv"
        doc "setPowerUpRateHp.  CommonUtils::StrToFloat, then the client DIVIDES BY 100 before storing — the wire carries a percentage and the client wants a multiplier.  So 100 = x1.0 = no bonus, and 0 would multiply the party's HP by ZERO.  100 is the neutral value; never send 0.  (readparam_analysis.json types this std::string, which is true of the raw wire but hides the float parse — the pseudocode is the authority.)"
    }

    field power_up_rate_atk type="f32::str" {
        key "llTJ33yj"
        doc "setPowerUpRateAtk.  StrToFloat then / 100.0 — see power_up_rate_hp.  Neutral = 100."
    }

    field power_up_rate_def type="f32::str" {
        key "fPxrnRT4"
        doc "setPowerUpRateDef.  StrToFloat then / 100.0 — see power_up_rate_hp.  Neutral = 100."
    }
}

// ---------------------------------------------------------------------------
// Tier 3 — the run's party.  DECODED 2026-08-07 from the battle-path dump.
//
// MissionStartScene::downloadFiles branches on GameUtils::isFrontierGate and,
// in Frontier Gate mode, builds its asset download set from
// FrontierGateUserUnitInfoList — i.e. from 52xDBRGr — NOT from the player's
// normal unit list:
//
//     if (GameUtils::isFrontierGate(missionId)) {
//         list = FrontierGateUserUnitInfoList::shared();
//         if (!list.empty()) { requestSummonerUnitFiles(); requestUnitFiles(); }
//     }
//
// The server never sent 52xDBRGr, so that list was empty, no unit assets were
// requested, and the battle then ran with units whose files had never been
// fetched — the mission downloaded its 12 shared assets and crashed.
//
// isFrontierGate itself resolves mission -> dungeon -> DungeonMst.dungeon_type
// == 5 (dungeon 9000002 carries 3hPeI1RV=5), so the client is correctly in FG
// mode; it simply has no party to load.
//
// The client SENDS both groups on FrontierGateStart, so echoing them back is
// both the fix and the resume mechanism.
// ---------------------------------------------------------------------------

json FrontierGatePartyDeckInfo {
    doc "One party-deck member for a Frontier Gate run — response key MxmCpDRC (FrontierGatePartyDeckInfoResponse).  A strict subset of CampaignMissionPartyDeckInfoResponse (w5vHLT0q), which adds 1e6jxQzf and yu18xScw; authored separately rather than shared so we do not emit two keys the FG client never reads."

    field deck_num type="i32::str" {
        key "zsiAn9P1"
        doc "Deck slot number."
    }

    field user_unit_id type="i32::str" {
        key "edy7fq3L"
        doc "user_units instance id of this member."
    }

    field friend_id type="str" {
        key "98WfKiyA"
        doc "setFriendID — set on the borrowed friend slot, empty otherwise."
    }

    field member_type type="i32::str" {
        key "gr48vsdJ"
        doc "Member role/type."
    }

    field disporder type="i32::str" {
        key "XuJL4pc5"
        doc "Display order within the deck."
    }

    field now_hp type="i32::str" {
        key "a3qJ6QhX"
        doc "Current HP — volatile per-run state."
    }

    field max_hp type="i32::str" {
        key "3WMz78t6"
        doc "Max HP."
    }

    field bb_gauge type="i32::str" {
        key "gU2xtQ0V"
        doc "Brave-burst gauge."
    }

    field sb_gauge type="i32::str" {
        key "nIGZ1X9C"
        doc "Super-burst gauge."
    }

}

