    }

    field units type="str" {
        key "U42YcFNu"
        doc "P_* unit JSON for both squads."
    }

    field atk_formation_id type="i32::str" {
        key "XRaf10Pu"
        doc "Attack formation."
    }

    field atk_support_id type="i32::str" {
        key "dgtpPK70"
        doc "Attack support."
    }

    field def_formation_id type="i32::str" {
        key "5MjZwxqH"
        doc "Defence formation."
    }

    field def_support_id type="i32::str" {
        key "kPvAtLWr"
        doc "Defence support."
    }
}

json ColosseumBattleResult {
    doc "BZ95Eg3M ColosseumBattleResultResponse row.  Rows 1 and 2 are the two fights; row 3 is the match summary that ColosseumResultScene / ResultJudgeScene / RewardScene fetch with getObjectWithBattleType(3) and use unchecked, so it is always sent."

    field battle_num type="str" {
        key "1kisc6IF"
        doc "Battle id."
    }

    field battle_type type="i32::str" {
        key "2QOPHXW1"
        doc "1 attack fight, 2 defence fight, 3 summary."
    }

    field result type="i32::str" {
        key "3pAQY5KW"
        doc "1 = won.  On the summary: the match verdict the judge screen shows."
    }

    field defeat_unit_cnt type="i32::str" {
        key "mFID53JZ"
        doc "Enemy units defeated."
    }

    field before_cbp type="i32::str" {
        key "43QyxTS5"
        doc "Summary: class season CBP before the match."
    }

    field after_cbp type="i32::str" {
        key "OUY9jpPA"
        doc "Summary: class season CBP after the match."
    }

    field friend_req_state type="i32::str" {
        key "Sx5H0Ikn"
        doc "1 opens the friend-request prompt after the reward screen; 0."
    }

    field bonus_point type="i32::str" {
        key "tvWWL9wI"
        doc "Summary: the clean-sweep bonus included in after_cbp."
    }

    field battle_cnt type="i32::str" {
        key "69vnphig"
        doc "Summary: tickets used (ARENA_COLOSSEUM_REWARD_USE_TICKET)."
    }

    field bonus_type type="str" {
        key "ciDqCjAF"
        doc "Campaign type echoed from BattleStart."
    }

    field bonus_param type="str" {
        key "59b1eE6N"
        doc "Campaign parameter echoed from BattleStart."
    }
}

json ColosseumRewardInfo {
