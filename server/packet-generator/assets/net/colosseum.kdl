    field team type="str" {
        key "INT1K9Pf"
        doc "JSON {P_USER_ID, P_FRIEND_MESSAGE, P_LV, P_GUILD_ID} (NpcTeamParse), as in arena."
    }

    field atk_party type="str" {
        key "Enmv8X74"
        doc "Opponent attack squad (fights the player's defence squad)."
    }

    field def_party type="str" {
        key "UvOujGQX"
        doc "Opponent defence squad (fights the player's attack squad)."
    }

    field units type="str" {
        key "U42YcFNu"
        doc "P_* unit JSON for both squads (NpcUnitParseList, arena format)."
    }

    field atk_formation_id type="i32::str" {
        key "XRaf10Pu"
        doc "Attack formation."
    }

    field atk_support_id type="i32::str" {
        key "dgtpPK70"
        doc "Attack support."
    }

    field def_formation_id type="i32::str" {
        key "5MjZwxqH"
        doc "Defence formation."
    }

    field def_support_id type="i32::str" {
        key "kPvAtLWr"
        doc "Defence support."
    }

    field friend_message type="str" {
        key "bM7RLu5K"
        doc "Opponent message."
    }

    field friend_id type="str" {
        key "98WfKiyA"
        doc "Opponent friend id."
    }

    field extra_flg type="i32::str" {
        key "Z7PXoxc2"
        doc "Extra rule flag; 0 (no extra rules)."
    }

    field rule_id type="i32::str" {
        key "IvuccUuD"
        doc "ColosseumExtraRuleMst id when extra_flg is set; 0."
    }

    field total_cbp type="i32::str" {
        key "z1rMbo8n"
        doc "Opponent's season CBP in the class."
    }

    field position type="i32::str" {
        key "2rqxaZ6K"
        doc "Opponent's ranking position, 0 when unranked."
    }
}

json ColosseumBattlePartyInfo {
    doc "7oXGyuVH ColosseumBattlePartyInfoResponse: the player's own side as the battle builds it (PlayerParty::entryColosseumPlayer reads the units from HERE, not from the unit box).  Empty parties make ColosseumMatchScene refuse with ARENA_COLOSSEUM_PLAYER_NULL."

