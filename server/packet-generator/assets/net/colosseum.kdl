// ---------------------------------------------------------------------------
// Response envelopes
// ---------------------------------------------------------------------------

json ColosseumHubResp {
    doc """
    ArenaInfo (oim9TU1D) reply, also appended to ChallengeArenaResetInfo's: the
    arena standing plus everything the Colosseum Top / Class Select screens read.

    NO MASTER ROWS HERE (wmpLokaR / aCmTmaOx / kaQtidz4).  Their readParams
    removeAllObjects first, and ColosseumTopScene::initialize keeps a pointer
    to its ColosseumClassMst (+0x3b0) that only initialize sets, so a class row
    in the Top screen's own ArenaInfo reply frees the object under it: the cost
    check then read garbage and refused a Hero Class squad ("exceeds the set
    cost limit", emulator 2026-10-23).  The CDN tables already carry the
    English names the screens show.
    """

    field arena_info type="[UserArenaInfo]" {
        key "8jBJ7uKR"
        doc "Exactly one row (singleton parser)."
    }

    field classes type="[ColosseumClassInfo]" {
        key "HgYvs3am"
        doc "All four classes."
    }

    field user_info type="[ColosseumUserInfo]" {
        key "FfBebG0R"
        doc "Exactly one row."
    }

    field durations type="[ColosseumDurationInfo]" {
        key "Q5jXpri7"
        doc "Current and past seasons."
    }

    field past_rankings type="[ColosseumPastRanking]" {
        key "dSC5DzuN"
        doc "The player's past-season standings."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "HUD with the day's free tickets topped up."
    }
}

json ColosseumDeckEditResp {
    doc "ColosseumDeckEdit reply.  No HgYvs3am: the client built the request from its own ColosseumClassInfo, and replacing that list frees objects the Top and squad screens hold (see ColosseumHubResp)."

    field user_info type="[ColosseumUserInfo]" {
        key "FfBebG0R"
        doc "Exactly one row."
    }
}

json ColosseumBattleStartResp {
    doc "ColosseumBattleStart / ColosseumBattleRestart reply."

    field enemy_info type="[ColosseumBattleEnemyInfo]" {
        key "y7A1mZft"
        doc "Exactly one row."
    }

    field party_info type="[ColosseumBattlePartyInfo]" {
        key "7oXGyuVH"
        doc "Exactly one row."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "HUD with the spent tickets."
    }

    field ais type="[AIMst]" {
        key "89ausgc4"
        doc "Unit AI rows, as ArenaBattleStartResp.ais: both sides fight on AI."
    }
}

json ColosseumBattleEndResp {
    doc "ColosseumBattleEnd reply."

    field results type="[ColosseumBattleResult]" {
        key "BZ95Eg3M"
        doc "Fight rows 1 and 2 plus the summary row 3."
    }

    field classes type="[ColosseumClassInfo]" {
        key "HgYvs3am"
        doc "All four classes, updated."
    }

    field user_info type="[ColosseumUserInfo]" {
        key "FfBebG0R"
        doc "Exactly one row."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "HUD."
    }
}

json ColosseumFriendListResp {
    doc "ColosseumFriendList reply (ColosseumRankScene)."

    field list type="[FriendUserArenaInfo]" {
        key "BYaF62TE"
        doc "Ranking rows; ranking_point is the class season CBP, position the rank."
    }

    field durations type="[ColosseumDurationInfo]" {
        key "Q5jXpri7"
        doc "Seasons, for the title."
    }

    field past_rankings type="[ColosseumPastRanking]" {
        key "dSC5DzuN"
        doc "The player's past-season standings."
    }
}

json ColosseumRewardResp {
    doc "ColosseumGetRewardInfo / ColosseumRewardReceipt reply."

    field rewards type="[ColosseumRewardInfo]" {
        key "xNCYRb5G"
        doc "The asked-for stage's rewards; ColosseumTopScene goes straight to the shop when this is non-empty."
    }

    field stages type="[ColosseumRewardStageMst]" {
        key "U6MWwoW4"
        doc "The player's stage and the ones after it, in order: \"Go to Next Stage\" asks for the first row that is not the shop's stage."
    }

    field user_info type="[ColosseumUserInfo]" {
        key "FfBebG0R"
        doc "Exactly one row, with the CBP left."
    }
}
