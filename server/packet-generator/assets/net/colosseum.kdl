// Colosseum (async PvP by class).  Wire shapes rebuilt from the v2.19.6
// client's createBody / readParam (strcmp -> setter pairs); the scene flow,
// rules and what is still unverified are in docs/features/COLOSSEUM.md.
// Handlers: gme/handlers/Colosseum.cpp, state: gme/common/Colosseum.{hpp,cpp}.
//
// Request values are all strings on the wire, so every request field here is
// `str` and the handler parses numbers itself (same rule as net/arena.kdl).
//
// Registration (GmeControllerHandlers.cpp):
//   rdZbaKBG ColosseumDeckEdit / gY3YK5bD
//   ysP6qYcy ColosseumBattleStart / iFIHAT5V
//   ohH9lfDE ColosseumBattleRestart / j2bFgyri
//   fGDPoQI3 ColosseumBattleEnd / 4V6oIoRC
//   AoBvG2YN ColosseumFriendList / Wj5fH1HV
//   jv0dI88o ColosseumGetRewardInfo / d7aPxZWw
//   PN5CVaWy ColosseumRewardReceipt / YBgVBy5A

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

json ColosseumClassEntry {
    doc "KtSHFZY7 node: the class the request is about (ColosseumCommonInfo::getSelectClassID)."

    field class_id type="str" {
        key "3mMAn6L5"
        doc "Class id 1..4."
        optional #true
    }

    field duration_id type="str" {
        key "ZW19nYrU"
        doc "Season id (ColosseumUserInfo.duration_id); FriendList only."
        optional #true
    }
}

json ColosseumDeckMember {
    doc "Pgz43hTE row of ColosseumDeckEdit::createBodyPartyDeck: one unit of one of the class's two squads."

    field deck_num type="str" {
        key "zsiAn9P1"
        doc "UserPartyDeck deck num: 0 = attack squad, 1 = defence squad."
        optional #true
    }

    field deck_type type="str" {
        key "U9ABSYEp"
        doc "1 = attack, 2 = defence (createBodyPartyDeck: deck num 1 -> 2, else 1)."
        optional #true
    }

    field user_unit_id type="str" {
        key "edy7fq3L"
        doc "The unit."
        optional #true
    }

    field member_type type="str" {
        key "gr48vsdJ"
        doc "0 = leader, 1 = member (npc_mst P_MEMBER_TYPE vocabulary)."
        optional #true
    }

    field disp_order type="str" {
        key "XuJL4pc5"
        doc "Squad position 0..4."
        optional #true
    }
}

json ColosseumDeckSupport {
    doc "vAPeUI3X row of createBodySupportInfo: the formation and support of one squad."

    field deck_type type="str" {
        key "U9ABSYEp"
        doc "1 = attack, 2 = defence."
        optional #true
    }

    field formation_id type="str" {
        key "peCeLuNq"
        doc "ColosseumFormationMst id (1xx attack, 2xx defence)."
        optional #true
    }

    field support_id type="str" {
        key "NungTq5g"
        doc "ColosseumSupportMst id (400/600/700/800)."
        optional #true
    }
}

json ColosseumDeckEditReq {
    doc "ColosseumDeckEdit (rdZbaKBG).  Sent by ColosseumTopScene::updateEvent on every visit and before Match, and by ColosseumPartySetScene."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field class_info type="[ColosseumClassEntry]" {
        key "KtSHFZY7"
        doc "One node."
        optional #true
    }

    field members type="[ColosseumDeckMember]" {
        key "Pgz43hTE"
        doc "Both squads, one row per unit."
        optional #true
    }

    field supports type="[ColosseumDeckSupport]" {
        key "vAPeUI3X"
        doc "Two rows, attack then defence."
        optional #true
    }
}

json ColosseumBattleInfoEntry {
    doc "fq2C03jh node of ColosseumBattleStart::createBodyBattleInfo."

    field ticket_cnt type="str" {
        key "69vnphig"
        doc "Tickets the player put on this match (the Top screen's slider); omitted when 0."
        optional #true
    }

    field bonus_type type="str" {
        key "ciDqCjAF"
        doc "GeneralEventMst Colosseum campaign type, echoed in the result."
        optional #true
    }

    field bonus_param type="str" {
        key "59b1eE6N"
        doc "GeneralEventMst Colosseum campaign parameter, echoed in the result."
        optional #true
    }
}

json ColosseumBattleStartReq {
    doc "ColosseumBattleStart (ysP6qYcy), sent by ColosseumMatchScene::initConnect.  Also carries the ignored 60subGk3 header and rj5fgJh0 (drop display setting)."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field class_info type="[ColosseumClassEntry]" {
        key "KtSHFZY7"
        doc "One node."
        optional #true
    }

    field battle_info type="[ColosseumBattleInfoEntry]" {
        key "fq2C03jh"
        doc "One node."
        optional #true
    }
}

json ColosseumClassReq {
    doc "ColosseumBattleRestart (ohH9lfDE) and ColosseumFriendList (AoBvG2YN): the login block plus the class node."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field class_info type="[ColosseumClassEntry]" {
        key "KtSHFZY7"
        doc "One node."
        optional #true
    }
}

json ColosseumBattleEndEntry {
    doc "BZ95Eg3M row of ColosseumBattleEnd::createBodyResult: one of the match's two fights (ArenaBattleScene::setColosseumResultParam; a give-up sends both rows as losses).  Only the fields the server keeps are modelled."

    field battle_num type="str" {
        key "1kisc6IF"
        doc "The server's battle id, from ColosseumBattleEnemyInfo.battle_num."
        optional #true
    }

    field battle_type type="str" {
        key "2QOPHXW1"
        doc "1 = the attack fight, 2 = the defence fight."
        optional #true
    }

    field result type="str" {
        key "3pAQY5KW"
        doc "1 = won."
        optional #true
    }

    field b_crystal_cnt type="str" {
        key "hoG2ieT5"
        doc "Battle crystals."
        optional #true
    }

    field h_crystal_cnt type="str" {
        key "6PLsn8xo"
        doc "Heart crystals."
        optional #true
    }

    field max_turn_damage type="str" {
        key "5NRJQ1LU"
        doc "Best single-turn damage."
        optional #true
    }

    field max_turn_spark type="str" {
        key "XP06YWdT"
        doc "Best single-turn sparks."
        optional #true
    }

    field defeat_unit_cnt type="str" {
        key "mFID53JZ"
        doc "Enemy units defeated."
        optional #true
    }

    field hp_party_rest type="str" {
        key "WDYR11jJ"
        doc "Comma list, one value per squad slot (\"0,0,0,0,0\" on a give-up).  INFERRED: remaining HP of the player's side."
        optional #true
    }

    field hp_enemy_rest type="str" {
        key "chy3HnIm"
        doc "Comma list, as hp_party_rest for the other side."
        optional #true
    }
}

json ColosseumBattleEndReq {
    doc "ColosseumBattleEnd (fGDPoQI3), sent by ColosseumBattleEndScene::initConnect after both fights."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field class_info type="[ColosseumClassEntry]" {
        key "KtSHFZY7"
        doc "One node."
        optional #true
    }

    field results type="[ColosseumBattleEndEntry]" {
        key "BZ95Eg3M"
        doc "One row per fight."
        optional #true
    }
}

json ColosseumRewardFilter {
    doc "1x6T2Trz node of ColosseumGetRewardInfo::createBody."

    field stage_id type="str" {
        key "mQhKzRxu"
        doc "Reward stage asked for (ColosseumShopScene::nextConnect sends the next stage)."
        optional #true
    }

    field category_id type="str" {
        key "VgU78CYj"
        doc "Reward category."
        optional #true
    }
}

json ColosseumGetRewardInfoReq {
    doc "ColosseumGetRewardInfo (jv0dI88o): the CBP exchange list.  Sent by the Top screen's Reward button and the shop scenes."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field filter type="[ColosseumRewardFilter]" {
        key "1x6T2Trz"
        doc "One node."
        optional #true
    }
}

json ColosseumReceiptEntry {
    doc "zcN7zXLn row of ColosseumRewardReceipt::createBody: one reward to exchange."

    field reward_id type="str" {
        key "N1b6SUW4"
        doc "ColosseumRewardInfo.reward_id."
        optional #true
    }

    field category_id type="str" {
        key "VgU78CYj"
        doc "Its category."
        optional #true
    }

    field count type="str" {
        key "H6k1LIxC"
        doc "Always 1 in the package path."
        optional #true
    }
}

json ColosseumRewardReceiptReq {
    doc "ColosseumRewardReceipt (PN5CVaWy): exchange CBP for rewards.  ShopDetailScene sends one row; ShopScene's exchange-all (setIsPackage) sends every row whose receive status is 1."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field rewards type="[ColosseumReceiptEntry]" {
        key "zcN7zXLn"
        doc "Rewards to exchange."
        optional #true
    }
}

// ---------------------------------------------------------------------------
// Response rows
// ---------------------------------------------------------------------------

json ColosseumClassInfo {
    doc "HgYvs3am ColosseumClassInfoResponse row (a list).  The Top, Class Select, Match and Reward scenes all look their class up with getObjectID and use the result unchecked, so every reply that carries the group lists all four classes."

    field class_id type="i32::str" {
        key "3mMAn6L5"
        doc "Class id."
    }

    field position type="i32::str" {
        key "2rqxaZ6K"
        doc "This season's ranking position in the class, 0 while unranked."
    }

    field atk_party type="str" {
        key "Enmv8X74"
        doc "Attack squad, JSON [{P_USER_UNIT_ID, P_MEMBER_TYPE, P_DISPORDER}] (NpcPartyParseList::parse); \"[]\" when unset.  ColosseumCommonInfo::classDeckDataSet builds the squad screens from it."
    }

    field def_party type="str" {
        key "UvOujGQX"
        doc "Defence squad, same format."
    }

    field units type="str" {
        key "U42YcFNu"
        doc "Unused for the player's own classes (classDeckDataSet reads the units from UserUnitInfoList); sent as \"[]\"."
    }

    field atk_formation_id type="i32::str" {
        key "XRaf10Pu"
        doc "Attack formation; isDcekCheck refuses a match when FormationMstList has no such id."
    }

    field atk_support_id type="i32::str" {
        key "dgtpPK70"
        doc "Attack support."
    }

    field def_formation_id type="i32::str" {
        key "5MjZwxqH"
        doc "Defence formation."
    }

    field def_support_id type="i32::str" {
        key "kPvAtLWr"
        doc "Defence support."
    }

    field battle_cnt type="i32::str" {
        key "69vnphig"
        doc "Matches fought in this class."
    }

    field win_cnt type="i32::str" {
        key "8CEu9Kcm"
        doc "Matches won."
    }

    field atk_series_win_cnt type="i32::str" {
        key "7sXWfE8j"
        doc "Current winning streak (Reward screen \"consecutive victories\")."
    }

    field battle_cnt_accept type="i32::str" {
        key "20iEWRCV"
        doc "Times this player's squads were challenged."
    }

    field win_cnt_accept type="i32::str" {
        key "0rAkzg7L"
        doc "Challenges the squads held off."
    }

    field battle_num type="str" {
        key "1kisc6IF"
        doc "Open battle id, \"\" when none (only the dead ArenaInfoConnectScene::colosseumBattleTheWay reads it)."
    }

    field total_cbp type="i32::str" {
        key "z1rMbo8n"
        doc "This season's CBP in the class: the ranking score."
    }

    field all_win_cnt type="i32::str" {
        key "PL0mqDhK"
        doc "Matches where both fights were won."
    }

    field all_series_win_cnt type="i32::str" {
        key "Txb2idHz"
        doc "Current streak of matches with both fights won."
    }
}

json ColosseumUserInfo {
    doc "FfBebG0R ColosseumUserInfoResponse: a SINGLETON (readParam starts with clear()), so exactly one row."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "Player id."
    }

    field cbp type="i32::str" {
        key "qnccUrMN"
        doc "CBP to spend in the reward exchange (the client caps the display at 999999999)."
    }

    field total_cbp type="i32::str" {
        key "z1rMbo8n"
        doc "CBP earned over all seasons."
    }

    field battle_cnt type="i32::str" {
        key "69vnphig"
        doc "Matches, all classes."
    }

    field win_cnt type="i32::str" {
        key "8CEu9Kcm"
        doc "Wins, all classes."
    }

    field battle_cnt_accept type="i32::str" {
        key "20iEWRCV"
        doc "Times challenged, all classes."
    }

    field win_cnt_accept type="i32::str" {
        key "0rAkzg7L"
        doc "Defences held, all classes."
    }

    field position type="i32::str" {
        key "2rqxaZ6K"
        doc "Unused by the scenes read; 0."
    }

    field reward_info type="str" {
        key "JQ23rIvk"
        doc "ColosseumTopScene::initialize shows a non-empty value as a notice and then clears it: the season-end message."
    }

    field duration_id type="str" {
        key "ZW19nYrU"
        doc "Current season id (YYYYMM); the Rank scene sends it back."
    }

    field stage_id type="str" {
        key "mQhKzRxu"
        doc "Current reward stage (the shop headers look it up in U6MWwoW4)."
    }

    field category_id type="str" {
        key "VgU78CYj"
        doc "Current reward category."
    }
}

json ColosseumBattleEnemyInfo {
