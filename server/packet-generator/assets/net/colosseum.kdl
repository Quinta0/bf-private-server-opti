        key "h7eY3sAK"
        doc "Opponent id (bots: COLOBOT<n>)."
    }

    field battle_num type="str" {
        key "1kisc6IF"
        doc "Server battle id; BattleEnd sends it back on every fight row."
    }

    field handle_name type="str" {
        key "B5JQyV8j"
        doc "Name on the Match screen."
    }

    field lv type="i32::str" {
        key "D9wXQI2V"
        doc "Team level."
    }

    field win_cnt type="i32::str" {
        key "8CEu9Kcm"
        doc "Wins in this class (Match screen record)."
    }

    field battle_cnt type="i32::str" {
        key "69vnphig"
        doc "Matches in this class; the screen shows battle_cnt - win_cnt as losses."
