json GetPlayerInfoReq {
    doc """
    GetPlayerInfo (vUQrAV65 / 7pW4xF9H) request.

    GetPlayerInfoRequest::createBody @0x13A4E64 is 44 bytes and adds NOTHING
    beyond the standard user-info / signal-key / version tags, so this carries
    only the login block.  The whole contract is in the response.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Standard user-info tag; the only thing createBody emits."
    }
}

json GetPlayerInfoResp {
    doc """
    What the Records / Archive screens need.

    Sent by PlayerInfoBattleResultScene::initConnect, ArenaArchiveScene and
    ColosseumArchiveScene -- the three scenes that call getActual @0x1791EEC,
    the trophy-id chain that answers one trophy per UserTeamArchive counter.

    getResponseObject is a global key -> class registry (handbook 7.12.4), so
    these keys dispatch to their own response classes whichever handler carries
    them.  Both archive blocks are singleton readParams with no list ops, so
    re-sending on every visit is a clean overwrite.
    """

    field archive type="[UserTeamArchive]" {
        key "zI2tJB7R"
        doc "Lifetime trophy counters; 8 of 39 are fed from MissionEnd."
    }

    field trophy_grades type="[UserTrophyGradeInfo]" {
        key "H18CjPKI"
        doc "Which trophy grades those counters have reached.  The client cannot derive them (see UserTrophyGradeInfo), so without this every trophy on the screen reads grade 0."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "HUD refresh -- these scenes draw the header like any other."
    }

    field arena_archive type="[UserTeamArenaArchive]" {
        key "PQ56vbkI"
        doc "Sent as one all-zero row, never as [].  See UserInfoResp.arena_archive -- the class is a singleton readParam, so an empty array leaves it uninitialised and the Arena section renders garbage."
    }

    field arena_info type="[UserArenaInfo]" {
        key "8jBJ7uKR"
        doc "Also one all-zero row, never [] -- another singleton readParam.  This one supplies Total Entries / Total Wins / Offense Wins / Defense Wins on the Arena Record."
    }
}

json UserInfoResp {
    field entered_features type="[UserEnteredFeatureInfo]" {
        key "2386Diw1"
        doc "Full per-player visit snapshot: the reader clears its list before ingesting rows."
    }


    // AUDIT 2026-08-24: 33 blocks, all structurally verified (dispatch, response
    // class, and replace-vs-merge).  NO BLOCK ACCUMULATES: every list either
    // calls removeAllObjects, does a selective clear (the PermitPlace trio), or
    // dedupes per row before insert.  That matters because the client refetches
    // this on every return to Home -- GetUserInfoRequest is built from 10 sites
    // incl. HomeScene2::updateEvent, ~15 times in a logged session.
    //
    // 4ceMWH6k and qC2tJs4E are the SAME class with opposite ctor flags:
    // UserUnitInfoResponse(true) @0x1392674 is full-replace, (false) @0x139269C
    // is insert-if-absent.  Full audit in tools/SERVER_COMPONENT_AUDIT.md.
    doc "TODO"

    field loginInfo type="[LoginInfoResp]::size(1)" {
        key "IKqx1Cn9"
