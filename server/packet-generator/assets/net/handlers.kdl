json UnitFavoriteReq {
    doc "Toggle the favorite/lock flag on one or more user_units.  Example captured wire body: {\"3kcmQy7B\":[{\"edy7fq3L\":\"12345\",\"5JbjC3Pp\":\"1\",\"2pAyFjmZ\":\"0\"}]}"

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field entries type="[UnitFavoriteEntry]" {
        key "3kcmQy7B"
        doc "The client's WHOLE favourite list, not a delta: UnitFavoriteRequest::createBody @0x13AEDC8 walks every unit and lists those with getFavorite == 1 or getUnitImgType == 2.  A unit that is not listed is not a favourite.  May be empty (the last favourite was removed)."
    }
}

json UnitFavoriteResp {
    doc "The favourite list as the server now holds it, one row per unit the request listed.  UnitFavoriteResponse::readParam clears UnitFavoriteList at row 0 and adds one UnitFavoriteObj per row, so this is a FULL REPLACE of an array: echoing only the first entry (as a single object, from the old fork's SerializeFields) left the client's list with one unit and the other stars vanished (ticket #39)."

    field entries type="[UnitFavoriteEntry]" {
        key "3kcmQy7B"
        doc "Every entry of the request, as applied."
    }
    field helper_list type="[ReinforcementInfo]" {
        key "xZH6EIQ7"
        doc "The helper picker as FriendGet sends it (gme::buildHelperLists).  Any reply that carries xZH6EIQ7 replaces ReinforcementInfoList (row 0 clears it), so this is always the COMPLETE list, never a partial or id-less row.  Sent because the client only calls FriendGet at login and before a repeat quest: an own favourited unit's card otherwise kept its login-time level."
        optional #true
    }
    field helper_friends type="[FriendInfo]" {
        key "tojMy68W"
        doc "The Social rows as FriendGet sends them, including the priority-2 rows that put own cards first. FriendInfoResponse clears FriendInfoList at row 0, so this is always the COMPLETE list."
        optional #true
    }
}

json UnitEvoReq {
    doc "Evolve a base unit by consuming evo materials.  Wire root keys (UnitEvoRequest::createBody): login IKqx1Cn9, base unit(s) Km35HAXv, evolution target I82p0wCL, zel cost mCE3rUu5, element/material units 8Z2NQrx1."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field units type="[UnitEvoUnitEntry]" {
        key "Km35HAXv"
        doc "Base unit(s) being evolved (role \"1\" = base)."
    }

    field target type="[UnitEvoTargetEntry]" {
        key "I82p0wCL"
        doc "Evolution target — the unit_mst id the base evolves into."
    }

    field zel_cost_list type="[UnitEvoZelEntry]" {
        key "mCE3rUu5"
        doc "Zel cost line items for the evolution."
    }

    field elem_units type="[UnitEvoElemEntry]" {
        key "8Z2NQrx1"
        doc "Evolution material (element) units consumed."
    }
}

json UnitEvoResp {
    doc "UnitEvo response (response_class=UnitOpeEvoResponse).  Carries the evolution result (I82p0wCL), a full unit-cache rebuild (4ceMWH6k) and the updated team info (fEi17cnx).  xZH6EIQ7 is the HELPER PICKER list and is never sent from here (see the reinforce field)."

    field evo_result type="[EvoResultEntry]" {
        key "I82p0wCL"
        doc "Which MST id the base evolved into (and the evolved unit's DB id)."
    }

    field unit_refresh type="[UserUnitInfo]" {
        key "4ceMWH6k"
        doc """
        FULL-REPLACE unit cache rebuild — the ONLY key that can change a unit
        the client already owns, because its ctor flag makes readParam call
        removeAllObjects() before re-adding.  Send the COMPLETE roster here or
        the client loses every unit omitted.

        Evolution needs this for the same reason fusion does: the client has no
        local apply path.  It never rewrites the evolved unit and never drops
        the consumed materials, and it issues no request afterwards, so without
        this the unit list keeps showing the pre-evolution form until Home.

        The historical note here said DO NOT USE 4ceMWH6k because it soft-locked
        the result screen.  That test is superseded — the same key is confirmed
        working on UnitMix (2026-08-10) now that lvup_status is a valid table;
        the earlier build sent "1", which crashes the result scene by itself.
        The removeAllObjects release() hazard is still the thing to suspect if a
        result screen ever does hang on this.

        OPTIONAL ON PURPOSE: a plain vector serialises as "4ceMWH6k": [] when
        unset, and an empty full-replace list is the one payload that could
        clear the roster outright.
        """
        optional #true
    }

    field ope_result type="[UnitOpeResult]" {
        key "1ZbHB6Im"
        doc """
        DO NOT POPULATE THIS FOR EVOLUTION — the evolution result screen never
        reads it.  UnitOpeResult::shared() has exactly one scene consumer,
        UnitMixPlayScene::parseMixResult (the other two callers are the response
        ctor and its readParam), and UnitOpeResult is a SINGLETON, so writing it
        from an evolution reply mutates state a fusion scene may later read.
        Evolution reports through its own class instead: I82p0wCL ->
        UnitOpeEvoResponse -> UnitEvoInfo (see EvoResultEntry).
        Retained only because the field is shared with UnitMixResp.
        """
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated team info (zel) after the evolution."
    }

    // NO GV81ctzR HERE (ticket #138).  It rode this reply from
    // 2026-10-23 06:23Z for the Unit Guide (#118); its readParam erases and
    // re-adds every UserUnitDictionaryList entry, and the only evolutions whose
    // result the client never applied (it re-sent the same request) came after
    // it.  The form is recorded server-side and arrives with the next UserInfo.

    field helper_list type="[ReinforcementInfo]" {
        key "xZH6EIQ7"
        doc "The helper picker as FriendGet sends it (gme::buildHelperLists).  Any reply that carries xZH6EIQ7 replaces ReinforcementInfoList (row 0 clears it), so this is always the COMPLETE list, never a partial or id-less row.  Sent because the client only calls FriendGet at login and before a repeat quest: an own favourited unit's card otherwise kept its login-time level."
        optional #true
    }
    field helper_friends type="[FriendInfo]" {
        key "tojMy68W"
        doc "The Social rows as FriendGet sends them, including the priority-2 rows that put own cards first. FriendInfoResponse clears FriendInfoList at row 0, so this is always the COMPLETE list."
        optional #true
    }

    field warehouse_info type="[UserWarehouseInfo]" {
        key "9wjrh74P"
        doc """
        Complete positive inventory, sent only when an evolution material had
        spheres equipped and gme::returnEquippedSpheres put them back.  No
        evolution scene calls a client warehouse mutator (incWarehouseItem,
        setItemNum, UserWarehouseInfoList::addObject) and HomeInfo carries no
        warehouse, so those spheres stayed invisible until relaunch.
        readParam @0x14060E0 clears first: whole warehouse only.
        """
        optional #true
    }
    field item_favorite type="[ItemFavorite]" {
        key "VSRPkdId"
        doc """
        The complete lock set, whenever this reply carries the warehouse.
        GameResponseParser::parseBodyTag @0x139B3E8 re-derives every row's lock
        from ItemFavoriteList (UserWarehouseInfoList::setFavorite) after BOTH
        VSRPkdId and 9wjrh74P, so the two together settle on the server's set
        in either order.  Without it, a copy the client locked under its craft
        placeholder (INT_MAX - itemId) came back under its real id unlocked
        until the next UserInfo.  A zero-row array never reaches readParam, so
        an empty set changes nothing.
        """
        optional #true
    }

    field item_dictionary_info type="[UserItemDictionaryInfo]" {
        key "bd5Rj6pN"
        doc "Every item species ever stacked, sent with warehouse_info (merge with dedupe; see PresentReceiptResp)."
        optional #true
    }
}

json UnitMixReq {
    doc "Fuse (mix) material units into a base unit for XP.  Wire root keys: login IKqx1Cn9, units Km35HAXv (role \"1\" = base receiving XP, \"2\" = material consumed), zel cost mCE3rUu5."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field units type="[UnitMixUnitEntry]" {
        key "Km35HAXv"
        doc "Base + material units (role \"1\" = base, \"2\" = material)."
    }

    field zel_cost_list type="[UnitMixZelEntry]" {
        key "mCE3rUu5"
        doc "Zel cost line items for the fusion."
    }
}

json UnitMixResp {
    doc "UnitMix (Power Fusion) response.  Carries the result record (1ZbHB6Im), a full unit-cache rebuild (4ceMWH6k) and the updated team info (fEi17cnx).  xZH6EIQ7 is the HELPER PICKER list and is never sent from here (see the reinforce field)."

    field helper_list type="[ReinforcementInfo]" {
        key "xZH6EIQ7"
        doc "The helper picker as FriendGet sends it (gme::buildHelperLists).  Any reply that carries xZH6EIQ7 replaces ReinforcementInfoList (row 0 clears it), so this is always the COMPLETE list, never a partial or id-less row.  Sent because the client only calls FriendGet at login and before a repeat quest: an own favourited unit's card otherwise kept its login-time level."
        optional #true
    }
    field helper_friends type="[FriendInfo]" {
        key "tojMy68W"
        doc "The Social rows as FriendGet sends them, including the priority-2 rows that put own cards first. FriendInfoResponse clears FriendInfoList at row 0, so this is always the COMPLETE list."
        optional #true
    }

    field unit_update type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc """
        INERT for fusion — kept only so the shape stays documented.  This key
        is INSERT-IF-ABSENT, not an update: UserUnitInfoResponse::readParam
        ends with

            v187 = UserUnitInfoList::exist(list, userUnitId);
            if ( (v187 & 1) == 0 ) { ...; addObject(...); return 1; }
            return 1LL;              // already owned -> entry DISCARDED

        and a fusion base unit is always already owned, so whatever we put
        here is parsed and then dropped.  It is the right key for genuinely
        NEW units (drops, gacha).  Use unit_refresh below to actually change
        an owned unit.
        """
    }

    field unit_refresh type="[UserUnitInfo]" {
        key "4ceMWH6k"
        doc """
        FULL-REPLACE unit cache rebuild — the ONLY key that can change a unit
        the client already owns, because its ctor flag makes readParam call
        removeAllObjects() before re-adding.  Send the COMPLETE roster here or
        the client loses every unit omitted.

        CONFIRMED WORKING on the fusion reply, 2026-08-10: the fusion menu shows
        the new level and the fodder are gone with no trip to Home.
        The one caveat to remember is that removeAllObjects() release()s every
        CCObject in both containers, so any scene still holding a raw
        UserUnitInfo* dangles.  This key soft-locked the result screen once
        (2026-08-09), but that build also sent lvup_status "1", which crashes
        parseMixResult by itself.  If a result screen ever hangs on this again,
        the release() is the mechanism to suspect.

        Why it is here at all: the client has NO local apply path.  It never
        updates the fused unit and never removes the fodder — removeObject is
        called by the sale scenes (UnitSellTopScene2::sellUnit @0x1C35DFC) and
        the FrontierGate/FGPlus friend lists, never by a fusion scene, and
        removeObjectWithUserUnitID has none.  It also requests nothing after a
        fusion.  So without this key the fusion menu stays stale until Home.

        OPTIONAL ON PURPOSE, and it must stay that way.  A plain vector
        serialises as "4ceMWH6k": [] when unset — qC2tJs4E demonstrably does
        exactly that today — and an empty full-replace list is the one payload
        that could clear the client's roster outright.  As std::optional the
        key is absent entirely unless we mean it.
        """
        optional #true
    }

    field ope_result type="[UnitOpeResult]" {
        key "1ZbHB6Im"
        doc "The result-screen payload — before/after levels and exp for the level-up animation.  See UnitOpeResult in net/unit.kdl."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated team info (zel) after the fusion."
    }

    field warehouse_info type="[UserWarehouseInfo]" {
        key "9wjrh74P"
        doc """
        Complete positive inventory, sent only when fusion fodder had spheres
        equipped and gme::returnEquippedSpheres put them back.  No fusion
        scene calls a client warehouse mutator (incWarehouseItem, setItemNum,
        UserWarehouseInfoList::addObject) and HomeInfo carries no warehouse,
        so those spheres stayed invisible until relaunch.  readParam
        @0x14060E0 clears first: whole warehouse only.
        """
        optional #true
    }
    field item_favorite type="[ItemFavorite]" {
        key "VSRPkdId"
        doc """
        The complete lock set, whenever this reply carries the warehouse.
        GameResponseParser::parseBodyTag @0x139B3E8 re-derives every row's lock
        from ItemFavoriteList (UserWarehouseInfoList::setFavorite) after BOTH
        VSRPkdId and 9wjrh74P, so the two together settle on the server's set
        in either order.  Without it, a copy the client locked under its craft
        placeholder (INT_MAX - itemId) came back under its real id unlocked
        until the next UserInfo.  A zero-row array never reaches readParam, so
        an empty set changes nothing.
        """
        optional #true
    }

    field item_dictionary_info type="[UserItemDictionaryInfo]" {
        key "bd5Rj6pN"
        doc "Every item species ever stacked, sent with warehouse_info (merge with dedupe; see PresentReceiptResp)."
        optional #true
    }
    field dbb_info type="[UserUnitDbbInfo]" {
        key "sxorQ3Mb"
        doc """
        The DBB list, re-sent because THIS handler can change it.

        Fusing an Elemental Golem opens a unit's DBB slot, and the client learns
        a slot is open only by finding the unit in this list -- setDbbFusedIcon
        @0x1EC4CF8 does `objectForKey(<user_unit_id>)` on it.  Writing
        `dbb_unlocked` and not re-sending this left the fusion looking like it
        had done nothing: handbook §6, "a successful SQL update is not a UI
        refresh".  A REPLACE list, so it is always the complete set.
        """
        optional #true
    }

    field dbb_level_info type="[UserUnitDbbLevelInfo]" {
        key "tR4katob"
        doc "Bond levels, sent alongside dbb_info so the two never disagree."
        optional #true
    }

}

json UnitSellReq {
    doc "Sell one or more user_units for zel.  Wire root keys: login IKqx1Cn9, units Km35HAXv."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field units type="[UnitSellEntry]" {
        key "Km35HAXv"
        doc "Units to sell."
    }
}

