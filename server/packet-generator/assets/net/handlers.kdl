        key "XuJL4pc5"
        doc "Slot order."
    }

    field item_num type="i32::str" {
        key "wgV86x1q"
        doc "Count."
    }
}

json CampaignEventStatusReq {
    doc "The RseDpY04 request group (createBodySaveDataStatus @0x13B352C)."

    field mission_flg type=str {
        key "JcKMjH64"
        doc "CampaignMissionEventInfo::getMissionFlgCsv @0x12CBAF4 — the flags this run has set, comma-joined.  Each is a GrandMissionFlgMst flag id; the percents of the set flags are the run's completion (every mission's percents sum to exactly 100)."
    }

    field rest_time type="i32::str" {
        key "8n7oG4fS"
        doc "getRestTime."
    }

    field reserve_party_disp_flg type="i32::str" {
        key "W1EkCyc3"
        doc "Reserve-party display flag."
    }
}

json CampaignDeckEditReq {
    doc "CampaignDeckEdit (D74TYRf1 / e2k4s6jc) — the Grand Quest party, queued through ConnectRequestList by the party screens and MissionCheckScene::updateEvent.  Unregistered before 2026-09-11, so its 'Unsupported request' closed the session."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field mission type="[CampaignMissionRef]" {
        key "2I9V0o6J"
        doc "The Grand Mission being set up."
    }

    field decks type="[CampaignDeckEditEntry]" {
        key "hT95cq8K"
        doc "Every member of every party."
    }
}

