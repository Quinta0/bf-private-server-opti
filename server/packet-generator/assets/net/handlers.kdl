}

json CampaignItemReqEntry {
    doc "One Grand Quest item slot as the client sends it: Ckf3Zx7E / 5EByfWJ4 in CampaignItemEdit, NjZ6ds1S (equipped) and Nv94RF5q (the bag) in CampaignSave / CampaignEnd, which also carry h7eY3sAK."

    field user_id type=str {
