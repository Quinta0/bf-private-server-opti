// ---------------------------------------------------------------------------
// Campaign response structs (previously hand-written glz::meta in the handlers).
// ---------------------------------------------------------------------------

json CampaignMissionEntry {
    doc "One campaign mission's progress/state under response key 2I9V0o6J (CampaignMissionInfoResponse).  Shared by CampaignMissionGet and CampaignStart."

    field mission_id type="str" {
        key "j28VNcUW"
        doc "Mission id (numeric string == mission_mst.id)."
    }

    field attain_percent type="i32::str" {
        key "HUo4T7i8"
        doc "Best clear percentage.  Quoted decimal integer on the wire."
    }

    field mission_on_flg type="str" {
        key "JcKMjH64"
        doc "Whether the mission is selectable (\"1\") or locked (\"0\")."
    }

    field state type="i32::str" {
        key "j0Uszek2"
        doc "Mission state (>=1 = unlocked/cleared).  Quoted decimal integer on the wire."
    }

    field get_reward type="str" {
        key "JQ23rIvk"
        doc "setGetReward — the once-only rewards already earned on this mission, comma-joined reward ids (CampaignRewardScene::isGetRewardCheck splits on ',' to mark them obtained).  user_campaign_missions.rewards_got."
    }
}

json CampaignMissionGetResp {
    doc """
    CampaignMissionGet (RSm6p2d4) response — the per-mission progress list AND
    the Grand Quest master tables.

    ⚠ THE MASTER TABLES HAVE TO BE HERE, NOT ONLY ON CampaignStart.  This is the
    FIRST request of the Grand Quest flow (the mission-select screen fires it on
    open); CampaignStart is the LAST, after the quest and the deck are already
    chosen.  `CampaignInfo` resolves its `CampaignMissionMst*` when the quest is
    picked — between the two — so tables that arrive with CampaignStart arrive
    after that pointer has already been taken, and taken as NULL.

    That is what a client capture showed on 2026-09-13: DeckGet, DeckEdit and
    CampaignStart all named mission 5008001 correctly (that id comes from the
    per-user CampaignMissionInfo list), while the CampaignSave that followed
    carried `2I9V0o6J:[{}]` — an EMPTY mission, because Save builds it from
    `CampaignInfo::getMissionMst()->getMissionID()`.  With that pointer null,
    CampaignFieldScene::fleldMapDraw @0x14F6B60 bails on its very first branch
    (`ldr x8,[x19,#0x3e8]; cbz x8`) and the field draws no canvas and no spots —
    reported as "I can see my player icon but the map and the tiles are gone".

    They stay on CampaignStart as well: every one of these blocks is a REPLACE,
    re-sending costs nothing, and it covers any path that reaches a run without
    passing the menu.
    """

    field missions type="[CampaignMissionEntry]" {
        key "2I9V0o6J"
        doc "Mission progress/state entries."
    }

    field mission_mst type="[GrandMissionMst]" {
        key "as8G75gK"
        doc "CampaignMissionMstResponse — the mission catalogue the field scene resolves its map, spots and BGM through.  See this struct's doc for why it is on THIS request."
    }

    field map_mst type="[GrandMissionMapMst]" {
        key "iyCP4N1h"
        doc "CampaignMapMstResponse — the map canvas."
    }

    field spot_mst type="[GrandMissionSpotMst]" {
        key "aqb6LS9y"
        doc "CampaignMapSpotMstResponse — the tappable points."
    }

    field route_mst type="[GrandMissionRouteMst]" {
        key "Ri1S0JQX"
        doc "CampaignMapRouteMstResponse — the edges between spots."
    }

    field icon_mst type="[GrandMissionIconMst]" {
        key "HUo5G8gz"
        doc "CampaignMapIconMstResponse — boss/enemy/event icons."
    }

    field treasure_mst type="[GrandMissionTreasureMst]" {
        key "hpGBs2R1"
        doc "CampaignMapTreasureMstResponse — the chests a spot can hold."
    }

    field flg_mst type="[GrandMissionFlgMst]" {
        key "27tgwCUN"
        doc "CampaignFlgMstResponse — the story flags the visibility rules are written against."
    }

    field end_cnd_mst type="[GrandMissionEndCndMst]" {
        key "0sT4d2zV"
        doc "CampaignMissionEndCndMstResponse — what ends a run."
    }

    field event_mst type="[GrandMissionEventMst]" {
        key "x3kCNR4Y"
        doc "CampaignEventMstResponse — the scripted events a spot fires."
    }

    field reward_bonus_mst type="[GrandMissionRewardMst]" {
        key "Q83eyrJM"
        doc "CampaignRewardBonusMstResponse — the reward catalogue."
    }
}

json CampaignDeckMember {
    doc "One campaign party-deck member under response key w5vHLT0q (CampaignMissionPartyDeckInfoResponse)."

    field deck_num type="i32::str" {
        key "zsiAn9P1"
        doc "Deck slot number.  Quoted decimal integer on the wire."
    }

    field user_unit_id type="i32::str" {
        key "edy7fq3L"
        doc "user_units instance id of this member.  Quoted decimal integer on the wire."
    }

    field member_type type="i32::str" {
        key "gr48vsdJ"
        doc "Member role/type.  Quoted decimal integer on the wire."
    }

    field disporder type="i32::str" {
        key "XuJL4pc5"
        doc "Display order within the deck.  Quoted decimal integer on the wire."
    }

    field now_hp type="i32::str" {
        key "a3qJ6QhX"
        doc "Current HP (0 — the client fills from its unit cache).  Quoted decimal integer on the wire."
    }

    field max_hp type="i32::str" {
        key "3WMz78t6"
        doc "Max HP (0 — client-filled).  Quoted decimal integer on the wire."
    }

    field bb_gauge type="i32::str" {
        key "gU2xtQ0V"
        doc "Brave-burst gauge (0 — client-filled).  Quoted decimal integer on the wire."
    }

    field sb_gauge type="i32::str" {
        key "nIGZ1X9C"
        doc "Super-burst gauge (0 — client-filled).  Quoted decimal integer on the wire."
    }
}

json CampaignDeckGetResp {
    doc "CampaignDeckGet (C3a0VnQK) response — the campaign party-deck composition."

    field members type="[CampaignDeckMember]" {
        key "w5vHLT0q"
        doc "Campaign deck members."
    }
}

json CampaignStartDeckEntry {
    doc "One party-deck summary for the CampaignStart mission-select screen (response key hT95cq8K)."

    field deck_num type="i32::str" {
        key "zsiAn9P1"
        doc "Deck slot number.  Quoted decimal integer on the wire."
    }

    field guest_id type="str" {
        key "7zyHb5h9"
        doc "Guest/friend id for this deck slot (empty when none)."
    }

    field user_unit_id type="str" {
        key "edy7fq3L"
        doc "setUserUnitID (CampaignPartyDeckListResponse::readParam @0x1425E58) — without it every party slot came back empty."
    }

    field member_type type="i32::str" {
        key "gr48vsdJ"
        doc "Member role/type.  Quoted decimal integer on the wire."
    }

    field disp_order type="i32::str" {
        key "XuJL4pc5"
        doc "setDispOrder — the member's slot."
    }
}

json CampaignStartMissionDeckEntry {
    doc "One mission-deck slot for the CampaignStart deck-selector panel (response key Yusr3Zg5, CampaignMissionDeckInfoResponse::readParam @0x1423F34 -- a REPLACE list).  The same three fields the client sends back through CampaignDeckPosEntry."

    field deck_num type="i32::str" {
        key "zsiAn9P1"
        doc "setDeckNum -- deck slot number."
    }

    field now_point_num type="i32::str" {
        key "7w0inC1R"
        doc "setNowPointNum -- the map spot this deck stands on, restored from what the client last reported."
    }

    field arrival_order type="i32::str" {
        key "XuJL4pc5"
        doc "setArrivalOrder -- the order this deck arrived at its spot.  readParam reads it and nothing was sending it."
    }
}

json CampaignStartEventInfo {
    doc "CampaignStart event-flag object (response key RseDpY04 — a single object, not an array)."

    field reserve_party_disp_flg type="i32::str" {
        key "W1EkCyc3"
        doc "Whether the reserve-party UI is shown.  Quoted decimal integer on the wire."
    }
}

json CampaignRewardBonusEntry {
    doc "One EARNED bonus under response key p04iC2wr (CampaignRewardBonusInfoResponse, readParam @0x1426160, a REPLACE list).  Its only readers are the result screens — CampaignResultScene, CampaignResultBonusScene (one setReward + bonusUpdateHeader per row), CampaignResultSceneBase's totals and MissionResultGuildScene — so it is what a run won, sent by CampaignEnd; the catalog the reward screen lists is the client's CampaignRewardBonusMst.  The six fields are the client-facing subset of GrandMissionRewardMst (mst/grand_mission.kdl); every numeric field is quoted on the wire."

    field reward_id type="str" {
        key "N1b6SUW4"
        doc "setRewardID (std::string).  GrandMissionRewardMst.id."
    }

    field present_type type="i32::str" {
        key "30Kw4WBa"
        doc "setPresentType (uint32_t, stringified on the wire).  3=zel, 6=unit, 8=gem, 4/5/7=item domains — see CampaignReceipt.cpp for the grant dispatch."
    }

    field target_id type="str" {
        key "TdDHf59J"
        doc "setTargetID (std::string).  Rewarded entity id, interpreted per present_type."
    }

    field target_cnt type="i32::str" {
        key "wJsB35iH"
        doc "setTargetCnt (uint32_t, stringified on the wire).  Reward quantity."
    }

    field target_param type="str" {
        key "37moriMq"
        doc "setTargetParam (std::string).  GrandMissionRewardMst.param — kept string-typed because captured values include leading-zero colon forms (\"1:00\", \"1:01\")."
    }

    field reward_type type="i32::str" {
        key "IkmC8gG2"
        doc "setRewardType (uint32_t, stringified on the wire).  1=completion-percentage bonus, 2=treasure/flag reward, 4=first-clear bonus."
    }
}

json CampaignItemEntry {
    doc "One Grand Quest item slot as the client reads it: NjZ6ds1S / Ckf3Zx7E (CampaignEqpItemInfoResponse @0x1420C68) and 5EByfWJ4 (CampaignRsvItemInfoResponse @0x1426C5C) — both REPLACE lists with these three keys."

    field item_id type="str" {
        key "kixHbe54"
        doc "Item id."
    }

    field disp_order type="i32::str" {
        key "XuJL4pc5"
        doc "Slot order."
    }

    field item_num type="i32::str" {
        key "wgV86x1q"
        doc "Count."
    }
}

json CampaignStartResp {
    doc "CampaignStart (6Y0gaPQN) response — mission catalog, party decks, item slots, mission decks, and event flags for the mission-select screen.  p04iC2wr is deliberately NOT here: it is the EARNED-bonus list only the result screens read (CampaignResultScene sums every row), and the reward catalog comes from the client's own CampaignRewardBonusMst (Q83eyrJM).  Sending the catalog here showed every reward as earned whenever a CampaignEnd reply did not replace it."

    field missions type="[CampaignMissionEntry]" {
        key "2I9V0o6J"
        doc "Mission state list."
    }

    field party_decks type="[CampaignStartDeckEntry]" {
        key "hT95cq8K"
        doc "Party decks for the select screen."
    }

    field eqp_items type="[CampaignItemEntry]" {
        key "NjZ6ds1S"
        doc "The Grand Quest equipped loadout (user_campaign_state.eqp_items)."
    }

    field rsv_items type="[CampaignItemEntry]" {
        key "5EByfWJ4"
        doc "The Grand Quest reserve loadout (user_campaign_state.rsv_items)."
    }

    field mission_decks type="[CampaignStartMissionDeckEntry]" {
        key "Yusr3Zg5"
        doc "Mission-deck slots."
    }

    field event_info type="CampaignStartEventInfo" {
        key "RseDpY04"
        doc "Single-object event flags."
    }

    // ---------------------------------------------------------------------
    // The Grand Quest master tables.
    //
    // These are MST catalogues, not per-player state, and nothing was sending
    // them.  The client fills the ten lists below from exactly two places:
    // DataMstManager::loadCampaignMsts @0x1213608, which reads a locally CACHED
    // copy of each table through the same response class, and a live reply
    // carrying the key.  There is no cached copy in this fork (the client's
    // LocalState holds no MST files at all), so every one of the lists was
    // empty -- which is why a Grand Quest map drew no spots to tap and no
    // marker for where the party stands.  Reported from the client 2026-09-12.
    //
    // CampaignStart is the right carrier: it is the first request of the Grand
    // Quest flow (the menu), it precedes both the mission-select screen and
    // CampaignFieldDownloadScene (which sizes its download off
    // CampaignMapMstList), and the tables are small -- about 900 rows in total.
    // Every one of these blocks is a REPLACE, so re-sending them costs nothing.
    // ---------------------------------------------------------------------

    field mission_mst type="[GrandMissionMst]" {
        key "as8G75gK"
        doc "CampaignMissionMstResponse -- the mission catalogue behind the series tiles."
    }

    field map_mst type="[GrandMissionMapMst]" {
        key "iyCP4N1h"
        doc "CampaignMapMstResponse -- the map canvas.  CampaignFieldScene::fleldMapDraw @0x14F6BD4 reads it to lay out the tiles, and CampaignFieldDownloadScene::downloadFiles @0x14E9010 reads map_img to know which pieces to fetch."
    }

    field spot_mst type="[GrandMissionSpotMst]" {
        key "aqb6LS9y"
        doc "CampaignMapSpotMstResponse -- the tappable points on the map.  This is the block whose absence left the map with nothing to click: the party's position (now_point_num on the Yusr3Zg5 deck row) is an index into these."
    }

    field route_mst type="[GrandMissionRouteMst]" {
        key "Ri1S0JQX"
        doc "CampaignMapRouteMstResponse -- the edges between spots, which decide where the party may move next."
    }

    field icon_mst type="[GrandMissionIconMst]" {
        key "HUo5G8gz"
        doc "CampaignMapIconMstResponse -- boss/enemy/event icons anchored to spots."
    }

    field treasure_mst type="[GrandMissionTreasureMst]" {
        key "hpGBs2R1"
        doc "CampaignMapTreasureMstResponse -- the chests a spot can hold."
    }

    field flg_mst type="[GrandMissionFlgMst]" {
        key "27tgwCUN"
        doc "CampaignFlgMstResponse -- the story flags every spot/route/icon visibility rule is written against (the conditioned_flag columns)."
    }

    field end_cnd_mst type="[GrandMissionEndCndMst]" {
        key "0sT4d2zV"
        doc "CampaignMissionEndCndMstResponse -- what ends a run."
    }

    field event_mst type="[GrandMissionEventMst]" {
        key "x3kCNR4Y"
        doc "CampaignEventMstResponse -- the scripted events a spot fires."
    }

    field reward_bonus_mst type="[GrandMissionRewardMst]" {
        key "Q83eyrJM"
        doc "CampaignRewardBonusMstResponse -- the reward CATALOGUE the reward screen lists.  Distinct from p04iC2wr, which is what a run actually earned and belongs only to CampaignEnd."
    }
}

json CampaignRewardSummary {
    doc "The Grand Quest's share of MissionRewardInfo (response key F5Vs19mb, a singleton).  CampaignResultInitScene::initConnect @0x154C294 init()s MissionRewardInfo and sets before_lv / before_exp itself before sending CampaignEnd, so only what the run earned goes here — the full MissionRewardInfo would overwrite before_lv with 0 and fake a level-up."

    field zel type="i32::str" {
        key "Najhr8m6"
        doc "Zel from the run's battles (the last CampaignBattleEnd archive)."
    }

    field karma type="i32::str" {
        key "HTVh8a65"
        doc "Karma from the run's battles."
    }
}

json CampaignEndResp {
    doc "CampaignEnd (jF9Kkro4) response.  CampaignResultScene::initialize @0x154D51C takes MissionRewardInfo zel/karma and the p04iC2wr totals (getThetotalBonusZel/Karma/Dia sum target_cnt over EVERY row of present type 3/11/8) back off the header to count them up again, so team_info must already include all of it."

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "The header after every payout."
    }

    field reward type="[CampaignRewardSummary]::size(1)" {
        key "F5Vs19mb"
        doc "The run's battle zel and karma."
    }

    field bonuses type="[CampaignRewardBonusEntry]" {
        key "p04iC2wr"
        doc "The bonuses THIS run earned (CampaignRewardBonusInfoResponse clears the list at row 0).  Omitted when none: an empty list never reaches readParam, so it could not clear an older list anyway."
        optional #true
    }

    field missions type="[CampaignMissionEntry]" {
        key "2I9V0o6J"
        doc "Every Grand Mission row, with the cleared state, best completion and get_reward after this run (REPLACE list)."
    }
}

json CampaignBattleEndResp {
    doc "CampaignBattleEnd (pTNB6yw3) response — the header.  It used to share CampaignReceiptResp and carry that handler's serial-code stub (4MCxgS5p), which has nothing to do with a battle."

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "The header."
    }
}

json CampaignReceiptPayload {
    doc "Receipt stub payload under 4MCxgS5p — a single object {\"pCIRMw04\":\"\"}."

    field marker type="str" {
        key "pCIRMw04"
        doc "Receipt marker; empty-string stub (the client applies the reward from its own state)."
    }
}

json CampaignReceiptResp {
    doc "CampaignReceipt (5Imq3wC0 — the Serial Code screen) response: refreshed HUD team info (fEi17cnx) plus the receipt stub (4MCxgS5p).  CampaignBattleEnd has its own CampaignBattleEndResp."

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Refreshed HUD team info (zel/karma/exp)."
    }

    field receipt type="CampaignReceiptPayload" {
        key "4MCxgS5p"
        doc "Receipt stub."
    }
}


