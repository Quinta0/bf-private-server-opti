json InitializeReq {
    doc "Initialization command"

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "TODO"
    }

    field mstRequests type="[MstUrlList]" {
        key "KeC10fuL"
        doc "MST that should be sent"
     }
}

json CampaignBattleEndReq {
    doc "CampaignBattleEnd (pTNB6yw3) request.  CampaignBattleEndRequest::createBody @0x13AFCA4 sends CHd0w9WU, knPuw69N, w5vHLT0q, Yusr3Zg5, NjZ6ds1S, Nv94RF5q, RseDpY04 and the wVTBA6b5 archive — and NO mission id: only DeckEdit, Save and End carry 2I9V0o6J."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field missionId type=str {
        key "j28VNcUW"
        doc "Top-level mission id.  The real client never sends it (see above); wire tests do."
    }

    field archive type="[CampaignArchiveReq]" {
        key "wVTBA6b5"
        doc "The run's archive so far (createBodySaveDataArchive @0x13B0784) — cumulative for the run."
    }

    field deck_pos type="[CampaignDeckPosEntry]" {
        key "Yusr3Zg5"
        doc "Where each deck stands after the battle -- see CampaignDeckPosEntry."
        optional #true
    }
}

json CampaignArchiveReq {
    doc "One CampaignMissionArchiveInfo node (wVTBA6b5).  Only the two currencies are modelled; the rest (47cJBUxz used items, hoG2ieT5/6PLsn8xo crystals, 4T0Q2Bh5 items, 3MAT6quo units, the turn/spark/skill/mimic counters, pJqG1B7b cheat info) is read past."

    field get_zel type="i32::str" {
        key "Najhr8m6"
        doc "getGetZel — zel picked up in this run's battles so far."
    }

    field get_karma type="i32::str" {
        key "HTVh8a65"
        doc "getGetKarma — karma picked up so far."
    }
}

json CampaignDeckPosEntry {
    doc """
    One campaign deck's position on the Grand Quest map -- the Yusr3Zg5 group,
    built by createBodySaveDataPos (CampaignSaveRequest @0x13B4170, and the
    identical bodies on CampaignBattleEndRequest @0x13B036C and
    CampaignEndRequest @0x13B1E54).

    This is where the party marker IS.  The client owns the position while a
    run is on screen, reports it here at every save point, and reads it back
    from the CampaignStart reply -- CampaignFieldInitScene::
    missionEventInitCameraSet @0x14EA4A4 places the camera on it, and
    CampaignMissionDeckInfoList::nextBattleDeckNum picks the next deck by it.
    Nothing was storing it, so a resumed run always came back at point 0.
    """

    field deck_num type="i32::str" {
        key "zsiAn9P1"
        doc "getDeckNum -- which campaign deck this row is."
    }

    field now_point_num type="i32::str" {
        key "7w0inC1R"
        doc "getNowPointNum -- the GrandMissionSpotMst point_num the deck stands on."
    }

    field arrival_order type="i32::str" {
        key "XuJL4pc5"
        doc "getArrivalOrder -- the order this deck reached its spot, which is how the client stacks several decks on one point."
    }
}

json CampaignMissionRef {
    doc "The 2I9V0o6J request group: one node naming the Grand Mission (CampaignInfo::getMissionMst()->getMissionID)."

    field mission_id type=str {
        key "j28VNcUW"
        doc "Grand Mission id."
    }
}

json CampaignNumInfoReq {
    doc "The CHd0w9WU request group (createBodyNumInfo @0x13B1A84)."

    field mission_num type=str {
        key "C03bapzk"
        doc "CampaignMissionNumInfo::getMissionNum — the run handle."
    }

    field mission_status type="i32::str" {
        key "j3g5P4cq"
        doc "CampaignEndRequest +0x20.  2 = cleared; 3 = failed or abandoned.  CampaignResultInitScene::initConnect @0x154C3BC sends 2, or 3 when either loss flag (+0x368 / +0x369) is set; CampaignFieldInitScene's give-up @0x14E9F5C sends 3."
    }
}

