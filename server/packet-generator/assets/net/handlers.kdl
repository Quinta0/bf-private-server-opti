    field frogate_id type="i32::str" {
        key "hBNPQAU0"
        doc "Gate id.  Restart identifies by GATE, like Save, because the old run is being discarded."
    }
}

json FrontierGateRestartReq {
    doc "FrontierGateRestart (v0m1FU0g) request — abandon the current run and begin the gate again."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field run type="[FrontierGateRestartEntry]::size(1)" {
        key "Mg8K8Y1a"
        doc "The gate being restarted."
    }
}

// ---------------------------------------------------------------------------
// Dungeon keys (Vortex parades).  Entry types are in net/dungeon_key.kdl; the
// per-user row is UserDungeonKeyInfo in net/user.kdl, decoded in
// tools/ida/audits/eFU7Qtb0_audit.txt.
//
// Registration:
//   REGISTER("1mr9UsYz", GetDistributeDungeonKeyInfo, "r0ZA3pn5")
//   REGISTER("WCJE0xe2", DungeonKeyReceipt,           "V4pfQo5C")
//   REGISTER("aGT5S6qZ", DungeonKeyUse,               "3rPx6tTw")
// GroupIds and AES keys from the legacy handler registry
// (server/gimuserver/gme/handlers/*RequestHandler.hpp), where all three were
// 7-line empty-OK stubs — there was no behaviour to port.
// ---------------------------------------------------------------------------

json GetDistributeDungeonKeyInfoReq {
    doc """
    GetDistributeDungeonKeyInfo (1mr9UsYz) request.  createBody @0x13A4D14
    emits ONLY the three BaseRequest tags (userInfo/signalKey/version) and zero
    addParam/addGroup calls, so this carries loginInfo alone and the server
    derives everything from the resolved user plus the current date.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json DungeonKeyReceiptReq {
    doc """
    DungeonKeyReceipt (WCJE0xe2) request — claim today's key at the Akras
    Summoners' Hall Administration Office.  createBody @0x13A34E4 emits
    addGroup("9S5M2yI3") + one addNode.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field receipt type="[DungeonKeyReceiptEntry]::size(1)" {
        key "9S5M2yI3"
        doc "The key being claimed."
    }
}

json DungeonKeyUseReq {
    doc """
    DungeonKeyUse (aGT5S6qZ) request — spend keys to open a parade tier.
    createBody @0x13A366C emits addGroup("xki65BPq") + one addNode.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field use type="[DungeonKeyUseEntry]::size(1)" {
        key "xki65BPq"
        doc "The key being spent and how many."
    }
}

json DungeonKeyInfoResp {
    doc """
    Shared response for all three dungeon-key handlers — the player's current
    key inventory, keyed eFU7Qtb0 (UserDungeonKeyInfoResponse, is_array=true).

    There is no dedicated Receipt or Use response class in the binary: eFU7Qtb0
    is the ONLY dungeon-key response it defines, so every handler answers with
    the post-mutation inventory and the client re-reads its list from that.
    The legacy stubs returned {} instead, which left the client's key count
    stale until the next UserInfo.
    """

    field keys type="[UserDungeonKeyInfo]" {
        key "eFU7Qtb0"
        doc "One entry per DungeonKeyMst row (Metal / Jewel / Imp)."
    }

    field badge type="BadgeKeyCount" {
        key "h23iRjGN"
        doc "The key-ready badge, re-sent with every key reply.  BadgeInfo::setDungeonKeyNum is written only by BadgeInfoResponse (no local clear), so without this a claimed key kept its Home / Keys / Summoners' Hall badge until the next login.  Only this one field, so the other badge counters are untouched."
    }
}

json DungeonKeyUseResp {
    doc "Key purchase reply combines existing response classes through the global registry (APK getResponseObject @0x1392568); there is no new client response class."
    field keys type="[UserDungeonKeyInfo]" {
        key "eFU7Qtb0"
        doc "Current key inventory after the purchase."
    }
    field permitPlace type="[PermitPlace]" {
        key "yXNM8kL3"
        doc "Full current-state replacement, including all active parade tiers."
    }

    field permitPlaceSP type="[PermitPlaceSP]" {
        key "Y73tHKS8"
        doc "The SPECIAL half of the same snapshot.  PermitPlaceSpResponse::readParam clears removeSpecialObjects at row 0, and yXNM8kL3's removeNormalObjects deliberately SKIPS special rows -- so anything whose area is AreaMst type 1 or 3 has to come back on this key or it can never be withdrawn.  Same discriminated row shape; built by the shared snapshot builder."
    }

    field permitPlaceML type="[PermitPlaceML]" {
        key "Y73mHKS8"
        doc "The ML half, cleared by removeMLObjects.  AreaMst type 10.  Same contract as permitPlaceSP."
    }
}

// ---------------------------------------------------------------------------
// UpdateInfoLight (ynB7X5P9 / 7kH9NXwC) — the client's "anything new for me?"
// poll.  See handbook §8.41.
//
// The client fires this roughly every time it returns to Home (~143 times in a
// single logged session) and its createBody @0x13AF9F4 emits ONLY the userInfo
// and signalKey tags — the request carries no fields whatsoever.  Both this
// server and the legacy fork answered it with a bare {}, i.e. "nothing has
// changed", every single time.
//
// Nothing constrains a GME response to a fixed class: GameResponseParser
// dispatches each top-level key independently through getResponseObject (504
// keys, see tools/ida/audits/getResponseObject_FULL.txt), so a response is a
// BAG OF KEYS and this poll can carry whatever actually changed.
//
// Uses 4ceMWH6k for units, not qC2tJs4E.  Per §8.32 the same class is
// registered twice with different flags — 4ceMWH6k -> UserUnitInfoResponse(v3, 1)
// clears the list before appending (full replace) and qC2tJs4E ->
// UserUnitInfoResponse(v3, 0) appends (incremental, which is what unit DROPS
// use).  A refresh poll wants the authoritative current list, so: full replace.
// ---------------------------------------------------------------------------

json UpdateInfoLightReq {
    doc "UpdateInfoLight (ynB7X5P9) request — loginInfo only; createBody emits no addParam/addGroup calls at all."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json UpdateInfoLightResp {
    field entered_features type="[UserEnteredFeatureInfo]" {
        key "2386Diw1"
        doc "Full per-player visit snapshot: the reader clears its list before ingesting rows."
    }


    doc """
    UpdateInfoLight (ynB7X5P9) response — the mutable per-user state, resent so
    the client can refresh without a relaunch.

    Deliberately NOT the whole UserInfo payload: this fires on every return to
    Home, so it carries only what actually changes during play.  The MST tables,
    PermitPlace, gacha catalog and so on are login-time data and stay out.
    """

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Energy, zel, karma, level, exp — the header the player is looking at."
    }

    // NO unit list here.  4ceMWH6k was tried and removed on 2026-08-09.
    //
    // Its readParam opens with UserUnitInfoList::removeAllObjects(), which
    // RELEASES every CCObject in the list.  This poll fires on every return to
    // Home — ~143 times a session — and Home displays the party units, so we
    // would be freeing objects a live scene holds pointers to, over and over.
    // The same call soft-locked the fusion result screen when the clearing key
    // was tried there, which is what exposed the hazard.
    //
    // It also bought nothing: sending the full list here did NOT make
    // evolutions or level-ups appear without a relaunch, so there is no
    // benefit to weigh against the risk.  If unit refresh is revisited, it
    // needs a mechanism that does not clear a list other scenes are holding.

    field clear_mission_info type="[UserClearMissionInfo]" {
        key "UT1SVg59"
        doc "Cleared-mission history — the progression driver the client evaluates unlocks against."
    }
    field hunter_orbs type="HunterOrbRefresh" {
        key "kN2i7qds"
        doc "Read-only derived orb count/timer; partial singleton update preserves existing rank and score."
    }

}

// ---------------------------------------------------------------------------
// UpdateInfo (RUV94Dqz / hy0P9xjsGJ6MAgb2) — Home's THIRTY-MINUTE refresh.
//
// HomeScene2::updateEvent (and AnotherHomeScene's, the Vortex home) sends it
// when UpdateInfo::isNeedUpdate @0x1285E9C — now minus the time the
// UpdateInfo singleton was created or last reset > 0x708 (1800 s).  Unhandled,
// the server's "Unsupported request" closed the session the first time the
// player reached a Home screen half an hour after launch — which looked like a
// crash on entering Vortex, and a relaunch reset the timer.  createBody
// @0x13AFA94 sends the userInfo and signalKey tags only.
json UpdateInfoReq {
    doc "UpdateInfo (RUV94Dqz) request — loginInfo only."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json UpdateServerTime {
    doc "UpdateInfoResponse (response key AhSmZF07), a singleton.  Its readParam @0x13FAA18 reads one key; setUpdateServerTime @0x1285E24 stores it and restarts the 30-minute timer."

    field server_time type="i32::str" {
        key "QxWZoA04"
        doc "Server time, Unix seconds."
    }
}

json UpdateInfoResp {
    field entered_features type="[UserEnteredFeatureInfo]" {
        key "2386Diw1"
        doc "Full per-player visit snapshot: the reader clears its list before ingesting rows."
    }


    doc "UpdateInfo (RUV94Dqz) response — what UpdateInfoLight sends (and for the same reason no unit list), plus the server time that restarts the client's timer."

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "The header."
    }

    field clear_mission_info type="[UserClearMissionInfo]" {
        key "UT1SVg59"
        doc "Cleared-mission history."
    }

    field update_info type="UpdateServerTime" {
        key "AhSmZF07"
        doc "Server time."
    }
    field hunter_orbs type="HunterOrbRefresh" {
        key "kN2i7qds"
        doc "Read-only derived orb count/timer; partial singleton update preserves existing rank and score."
    }

}

// NoticeUpdate (68pTQAJv / WHfcd53M) — refreshes the notice list.  Sent by
// Home and the Vortex home alongside UpdateInfo when their notice flag is set,
// and by NoticeListScene::initConnect @0x176D904 on opening the Notices
// screen.  Its constructor clears NoticeMstList and marks it loading; only a
// NoticeMstResponse (keys oOmzJJSd / bcdqwXES, NOTICE_DATA 0 / 1) marks it
// done again, in its destructor @0x13E6EB8, and NoticeListScene::updateEvent
// @0x176DC10 waits on that before drawing the list.  So the reply names both
// keys, empty: "no notices", and the screen stops waiting.
json NoticeUpdateEntry {
    doc "Request group 1eun7Ly7, one node."

    field notice_kind type="i32::str" {
        key "wDgU3rAh"
        doc "The NoticeMst::NOTICE_KIND the request was constructed with (NoticeUpdateRequest +0x20)."
    }
}

json NoticeUpdateReq {
    doc "NoticeUpdate (68pTQAJv) request.  An async request (isAsync @0x13ABB2C returns 1)."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field notice type="[NoticeUpdateEntry]" {
        key "1eun7Ly7"
        doc "Which notice kind to refresh."
    }
}

json NoticeMstRow {
    doc "One NoticeMst row.  Only the id is modelled: the server has no notices, and NoticeMstResponse::readParam @0x13E6F10 reads ~20 more keys (Hl7S4ldK, aigSzwVh, dTd8sy7S, ...) that would need decoding before any row is sent."

    field notice_id type="i32::str" {
        key "xJNom6i0"
        doc "Notice id."
    }
}

json NoticeUpdateResp {
    doc "NoticeUpdate (68pTQAJv) response: both notice lists, empty."

    field notices type="[NoticeMstRow]" {
        key "oOmzJJSd"
        doc "NOTICE_DATA 0 list — sent empty so the NoticeMstResponse it creates marks the list done."
    }

    field informations type="[NoticeMstRow]" {
        key "bcdqwXES"
        doc "NOTICE_DATA 1 list — likewise empty."
    }
}

// UserLoginCampaignInfo (5fc8bf2c / 4eb7ce1b) — Home asks again twelve hours
// after launch (LoginCampaignRewardObjectManager::is12HoursSinceLastRequest,
// interval 43200 s), then carries on without waiting for the answer.  There is
// no login campaign offline, so the reply is empty; unhandled, it closed the
// session like UpdateInfo did.
json UserLoginCampaignInfoReq {
    doc "UserLoginCampaignInfo (5fc8bf2c) request — createBody @0x1C70CF0 sends the userInfo and signalKey tags only."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json UserLoginCampaignInfoResp {
    doc """
    UserLoginCampaignInfo (5fc8bf2c) response -- which calendar cell the player
    is on.

    Home asks again twelve hours after launch
    (LoginCampaignRewardObjectManager::is12HoursSinceLastRequest, interval
    43200 s) and carries on without waiting, so this is the request that rolls
    the calendar over for someone who leaves the game running across midnight.

    It used to reply {} on the grounds that no campaign runs offline.  That was
    the visible half of why the advent calendar paid nothing: with neither this
    nor InitializeResp's 3da6bd0a populated, UserLoginCampaignInfo::shared()
    kept its constructed defaults and the grid believed the player was on day 0.
    """

    field campaign_info type="[UserLoginCampaignInfo]::size(1)" {
        key "3da6bd0a"
        doc "The cell to light and whether to play the claim flourish.  A singleton -- readParam @0x1C70D74 writes into UserLoginCampaignInfo::shared() with no row-0 clear, so one full row goes out or none at all."
    }
}

// ---------------------------------------------------------------------------
// HomeInfo (NiYWKdzs / f6uOewOD) — requested by the client as it ENTERS the
// Home scene.  createBody @0x1C69270 emits only the three BaseRequest tags, so
// it carries no fields of its own.
//
// This is the unit cache's rebuild point.  See §8.41: the client has NO
// in-session path to correct a cached unit — UnitMixMainScene holds a POINTER
// to the UserUnitInfo it rendered at initialize() and never re-reads, and the
// incremental key (qC2tJs4E) can only APPEND, which getNotParty would render
// as a duplicate because it does not de-duplicate.  The only thing that
// rebuilds the cache is 4ceMWH6k, whose readParam calls removeAllObjects().
//
// That call RELEASES every CCObject in the list, so it is only safe where no
// scene is holding unit pointers — which is exactly a scene boundary.  Login
// is the proven-safe case (UserInfo lands, then scenes build), and HomeInfo
// has the same ordering: the client asks for it while entering Home, before
// HomeScene binds its party sprites.  Trying the same key mid-fusion
// soft-locked the ritual screen, which is what established the rule.
// ---------------------------------------------------------------------------

json MysteryBoxListReq {
    doc """
    MysteryBoxList (pAJ2Xesw) request - opening the Mystery Chest screen.

    loginInfo only: MysteryBoxListRequest::createBody @0x1C6B094 emits
    createUserInfoTag + createSignalKeyTag and nothing else, not even a version
    tag.  Fired from MysteryChestScene::initConnect @0x1E7A800, immediately
    after MysteryBoxList::removeAllObjects().
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json MysteryBoxListResp {
    doc """
    MysteryBoxList (pAJ2Xesw) response - the player's chests.

    A full replace with no operation code, so the complete set goes every time
    and an empty list is a truthful "no chests".
    """

    field boxes type="[MysteryBoxInfo]" {
        key "d0ajLeRi"
        doc "Every chest the player currently holds: unclaimed and unexpired."
    }
}

json MysteryBoxClaimEntry {
    doc "The chest being claimed."

    field box_id type=str {
        key "rEFRefr8"
        doc "Id of the chest to open, echoed from the list response."
    }
}

json MysteryBoxClaimReq {
    doc """
    MysteryBoxClaim (2paswUpR) request - opening one chest.

    From MysteryBoxClaimRequest::createBody @0x1C6AFB4: identity, version tag,
    then "d0ajLeRi":[{ "rEFRefr8": "<box id>" }].  rEFRefr8 uses the STRING
    overload of addParam, and the group key is the same one the list response
    dispatches on.  Fired from MysteryRewardScene::initConnect @0x1D3CA6C.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field entries type="[MysteryBoxClaimEntry]" {
        key "d0ajLeRi"
        doc "The chest to open.  The client sends exactly one."
    }
}

json MysteryBoxClaimResp {
    doc """
    MysteryBoxClaim (2paswUpR) response - what the chest paid.

    Carries the reward list plus the refreshed chest list, so the claimed chest
    disappears from the screen without a second round trip, and team_info so any
    currency the chest granted shows immediately.
    """

    field rewards type="[MysteryBoxRewardInfo]" {
        key "CoAp2aph"
        doc "The prizes this chest paid."
    }

    field boxes type="[MysteryBoxInfo]" {
        key "d0ajLeRi"
        doc "The player's remaining chests, minus the one just opened."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Refreshed header so gem/zel/karma rewards land on screen at once."
    }

    field unit_info type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc "Units the chest created, read back in the shape login sends.  No Mystery Chest scene adds to the client roster, so without this they stayed off the unit list until HomeInfo's roster rebuild."
        optional #true
    }

    field unit_dictionary type="[UserUnitDictionary]" {
        key "GV81ctzR"
        doc "The COMPLETE unit dictionary whenever the chest paid a unit (see UserUnitDictionary)."
        optional #true
    }

    field warehouse_info type="[UserWarehouseInfo]" {
        key "9wjrh74P"
        doc "Complete positive inventory whenever the chest paid an item, material or sphere.  No Mystery Chest scene calls a client warehouse mutator and HomeInfo carries no warehouse; readParam @0x14060E0 clears first, so whole warehouse only."
        optional #true
    }
    field item_favorite type="[ItemFavorite]" {
        key "VSRPkdId"
        doc """
        The complete lock set, whenever this reply carries the warehouse.
        GameResponseParser::parseBodyTag @0x139B3E8 re-derives every row's lock
        from ItemFavoriteList (UserWarehouseInfoList::setFavorite) after BOTH
        VSRPkdId and 9wjrh74P, so the two together settle on the server's set
        in either order.  Without it, a copy the client locked under its craft
        placeholder (INT_MAX - itemId) came back under its real id unlocked
        until the next UserInfo.  A zero-row array never reaches readParam, so
        an empty set changes nothing.
        """
        optional #true
    }

    field item_dictionary_info type="[UserItemDictionaryInfo]" {
        key "bd5Rj6pN"
        doc "Every item species ever stacked, sent with warehouse_info (merge with dedupe; see PresentReceiptResp)."
        optional #true
    }
}

json SlotgameResultInfo {
    doc """
    One Brave Slots pull result, keyed s8r5M6wI (SlotgameResultInfoResponse).

    Field map decoded 2026-08-21 from readParam @0x1448E58.  Every setter on
    this class is BOTH inlined and dispatched through the vtable, so these were
    resolved by slot and then cross-checked: VideoAdsSlotgameResultInfoResponse
    shares all nine keys and puts its two extra fields on slots 24 and 26,
    exactly where the 10th and 11th declared members sit.  All nine take
    std::string.

    Full replace with no operation code - removeAllObjects() then addObject().
    """

    field prize_type type=str {
        key "yT3NBME0"
        doc "setPrizeType (vtable slot 6)."
    }

    field prize_data type=str {
        key "CW1bko4F"
        doc """
        setPrizeData (slot 8).  TWO fields, '@'-separated: "<targetId>@<count>".

        NOT a description, and NOT a bare id.  createPrizeDrawInfo @0x1A75674
        splits this on RandallSlotScene::SLOT_PRIZE_DATA_DELIMITER (= "@"),
        resolves element [0] via UnitMstList/ItemMstList::getObject(STRING),
        and builds the popup label as getItemName() + "x" + element [1].

        ⚠ Element [1] is read at [vector + 0x18] with NO bounds check
        (@0x1A75CE0).  A single-field value therefore constructs a std::string
        from whatever heap follows the vector and memcpy's from a wild pointer
        - memory CORRUPTION, not a clean crash, so the same payload can render
        fine one run and take the client down the next.

        Only elements [0] and [1] are ever read; two fields is exactly right.
        Same shape as b5yeVr61 ("<medalId>@<cost>").
        """
    }

    field prize_rank type=str {
        key "3WZ7KTp8"
        doc "setPrizeRank (slot 10).  Drives how loud the win presentation is."
    }

    field picture_pattern type=str {
        key "D20kuSLy"
        doc "setPicturePattern (slot 12)."
    }

    field effect_sam type=str {
        key "HgI9wEJ0"
        doc "setEffectSam (slot 14).  Names a .sam effect bundle - the scene loads SlotFrameLightHighSpeedAdd.sam and SlotReelSideLightAdd.sam."
    }

    field effect_type type=str {
        key "3Vcj8eUn"
        doc "setEffectType (slot 16)."
    }

    field effect_param type=str {
        key "NLbQm24T"
        doc "setEffectParam (slot 18)."
    }

    field reel_stop_num type=str {
        key "h6smq0WE"
        doc """
        setReelStopNum (slot 20) - WHERE THE THREE REELS STOP.

        The server decides the outcome and the client animates to it, so this is
        the field that makes the machine land somewhere meaningful.  It is a
        string carrying several numbers, which handbook 3.4 says to read as a
        delimited list; the exact encoding is UNVERIFIED, so if the reels stop
        somewhere other than the symbols the prize names, start here.
        """
    }

    field medal_num type=str {
        key "A0P7psui"
        doc "setMedalNum (slot 22).  The medal balance AFTER the pull."
    }
}

json SlotActionEntry {
    doc "The pull being requested."

    field slot_id type="i32::str" {
        key "zS45RFGb"
        doc """
        Which machine.  1 is Brave Slots, matching brave_slots.json.

        QUOTED on the wire.  createBody uses JsonNode::addParam(const char*,
        int), and an earlier revision typed this i32::int on the strength of
        that - but the overload only says what the C++ SOURCE type is, not how
        the value is encoded.  The captured request is
        "kLz5ujP2":[{"zS45RFGb":"1","d04gRmkE":"1"}], and i32::int made the
        whole request fail to parse with parse_number_failure (handbook 3.4:
        int setter + quoted wire value -> i32::str).
        """
    }

    field draw_cnt type="i32::str" {
        key "d04gRmkE"
        doc "How many pulls.  The client sends 1.  QUOTED, same as slot_id."
    }
}

json SlotActionReq {
    doc """
    SlotAction (vChFp73J) request - pulling the lever.

    From SlotActionRequest::createBody @0x13C95C8: identity, signal key, version
    tag, then "kLz5ujP2":[{ zS45RFGb, d04gRmkE }].  BOTH params use the INT
    overload of JsonNode::addParam, not the string one.

    Fired from RandallSlotActionScene::touchBegan @0x1A70DCC - the lever pull,
    NOT opening the screen.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field entries type="[SlotActionEntry]" {
        key "kLz5ujP2"
        doc "The pull.  The client sends exactly one."
    }
}

json SlotActionResp {
    doc """
    SlotAction (vChFp73J) response.

    Carries the result the reels stop on, the refreshed medal balance so the
    counter is right without a relaunch, and team_info so any currency the pull
    paid lands on screen at once.
    """

    field results type="[SlotgameResultInfo]" {
        key "s8r5M6wI"
        doc "The pull outcome.  One entry."
    }

    field medal_info type="[UserBraveMedalInfo]" {
        key "6C0kzwM5"
        doc "Medal balances after the pull."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Refreshed header for gem/zel prizes."
    }

    field unit_info type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc "Units the pulls created, read back in the shape login sends.  No slot scene adds to the client roster, so without this they stayed off the unit list until HomeInfo's roster rebuild."
        optional #true
    }

    field unit_dictionary type="[UserUnitDictionary]" {
        key "GV81ctzR"
        doc "The COMPLETE unit dictionary whenever a pull paid a unit (see UserUnitDictionary)."
        optional #true
    }

    field warehouse_info type="[UserWarehouseInfo]" {
        key "9wjrh74P"
        doc "Complete positive inventory whenever a pull paid an item, material or sphere.  No slot scene calls a client warehouse mutator and HomeInfo carries no warehouse; readParam @0x14060E0 clears first, so whole warehouse only."
        optional #true
    }
    field item_favorite type="[ItemFavorite]" {
        key "VSRPkdId"
        doc """
        The complete lock set, whenever this reply carries the warehouse.
        GameResponseParser::parseBodyTag @0x139B3E8 re-derives every row's lock
        from ItemFavoriteList (UserWarehouseInfoList::setFavorite) after BOTH
        VSRPkdId and 9wjrh74P, so the two together settle on the server's set
        in either order.  Without it, a copy the client locked under its craft
        placeholder (INT_MAX - itemId) came back under its real id unlocked
        until the next UserInfo.  A zero-row array never reaches readParam, so
        an empty set changes nothing.
        """
        optional #true
    }

    field item_dictionary_info type="[UserItemDictionaryInfo]" {
        key "bd5Rj6pN"
        doc "Every item species ever stacked, sent with warehouse_info (merge with dedupe; see PresentReceiptResp)."
        optional #true
    }
}

json DailyLoginReq {
    doc """
    DailyLogin (4aClzokO) request - the Daily Spin's SPIN action.

    loginInfo only: DailyLoginRequest::createBody @0x1CC9880 emits just
    createUserInfoTag + createSignalKeyTag, with no addGroup or addParam.

    Note this is NOT sent when the screen opens - DailyLoginScene::initConnect
    is 16 bytes, i.e. empty.  It is fired from updateEvent state 2 @0xE53058,
    immediately before the wheel animates.
    """

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json DailyLoginResp {
    doc """
    DailyLogin (4aClzokO) response.

    Carries the same DailyLoginRewardsUserInfo the Initialize reply seeds, so
    the client's singleton is replaced with the post-spin state: one more spin
    used, and XIvaD6Jp set to the reward the spin landed on.

    Drudr2w5 IS dispatched by GameResponseParser::getResponseObject @0x1396CD4,
    so it lands on DailyLoginRewardsUserInfo whichever handler sends it.
    """

    field dailyLoginRewards type="DailyLoginRewardsUserInfo" {
        key "Drudr2w5"
        doc "Post-spin state: spins used, the day, and the reward landed on."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc """
        Refreshed header after the spin.  The wheel pays gems, zel, karma and
        summon tickets (UserTeamInfo::summon_ticket).  No DailyLoginScene
        function calls UserTeamInfo's zel/karma mutators (incZel, setZel,
        incKarma, setKarma), and fEi17cnx is what every other reward reply
        refreshes the header with; before this a currency prize never reached
        the header until some later reply carried it.
        """
    }

    field unit_info type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc "Units the spin created, read back in the shape login sends.  No Daily Spin scene adds to the client roster, so without this they stayed off the unit list until HomeInfo's roster rebuild."
        optional #true
    }

    field unit_dictionary type="[UserUnitDictionary]" {
        key "GV81ctzR"
        doc "The COMPLETE unit dictionary whenever the spin paid a unit (see UserUnitDictionary)."
        optional #true
    }

    field warehouse_info type="[UserWarehouseInfo]" {
        key "9wjrh74P"
        doc "Complete positive inventory whenever the spin paid an item.  No Daily Spin scene calls a client warehouse mutator and HomeInfo carries no warehouse; readParam @0x14060E0 clears first, so whole warehouse only."
        optional #true
    }
    field item_favorite type="[ItemFavorite]" {
        key "VSRPkdId"
        doc """
        The complete lock set, whenever this reply carries the warehouse.
        GameResponseParser::parseBodyTag @0x139B3E8 re-derives every row's lock
        from ItemFavoriteList (UserWarehouseInfoList::setFavorite) after BOTH
        VSRPkdId and 9wjrh74P, so the two together settle on the server's set
        in either order.  Without it, a copy the client locked under its craft
        placeholder (INT_MAX - itemId) came back under its real id unlocked
        until the next UserInfo.  A zero-row array never reaches readParam, so
        an empty set changes nothing.
        """
        optional #true
    }

    field item_dictionary_info type="[UserItemDictionaryInfo]" {
        key "bd5Rj6pN"
        doc "Every item species ever stacked, sent with warehouse_info (merge with dedupe; see PresentReceiptResp)."
        optional #true
    }
}

json HomeInfoReq {
    doc "HomeInfo (NiYWKdzs) request — loginInfo only; createBody emits no addParam/addGroup calls."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json HomeInfoResp {
    doc """
    HomeInfo (NiYWKdzs) response — the unit-cache rebuild.

    Deliberately minimal: the team header and the authoritative unit list.
    Everything else the Home scene needs it already has from login.
    """

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Energy, zel, karma, level — the header the player sees on Home."
    }

    field unit_info type="[UserUnitInfo]" {
        key "4ceMWH6k"
        doc """
        The full owned-unit list, FULL-REPLACE variant.

        This is what makes a fusion or evolution visible without relaunching:
        4ceMWH6k's readParam clears both of UserUnitInfoList's containers (the
        dictionary at +44 and the array at +45) before repopulating, so the
        stale entry is actually gone rather than shadowed.
        // Safe HERE and only here-like places — see the block comment above.
        // Do NOT copy this key onto a mutation reply such as UnitMix/UnitEvo.
        """
    }

    field energy_recover type="DefineEnergyRecover" {
        key "VkoZ5t3K"
        doc "The header energy-refill threshold (DefineEnergyRecover), kept equal to the player's max energy."
    }
}

json SummonerJournalInfoReq {
    doc """
    SummonerJournalInfo (32Gwida0) request.

    Captured from a real client 2026-08-22 and it carries NO journal
    parameters - identity, the signal key, and the 168-entry MST version
    manifest, exactly as createBody @0xE3794C predicted.  Only the identity is
    modelled; the handler reads with error_on_unknown_keys off, so the rest
    passes through without needing to be described.
    """

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json SummonerJournalTaskRewardsNode {
    doc "One mission being claimed."

    field task_id type="str" {
        key "23DaiBpe"
        doc """
        Which mission.  Added via the std::string overload of
        JsonNode::addParam (@0xE37898), not the int one, so §3.4's
        quoted-int ambiguity does not apply - this really is a string.
        """
    }
}

json SummonerJournalTaskRewardsReq {
    doc """
    SummonerJournalTaskRewards (2y48D13d) - claiming one mission's reward.

    Shape from createBody @0xE377A8: identity, signal key, version tag, then
    a `da38tRai` group carrying `23DaiBpe`.

    ⚠ da38tRai is ALSO the dispatch key of SummonerJournalUserTaskInfo, so the
    request posts the same group shape it will be answered in.
    """

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field entries type="[SummonerJournalTaskRewardsNode]" {
        key "da38tRai"
        doc "The mission(s) being claimed."
    }
}

json UpdatePermitPlaceInfoReq {
    doc "APK createBody @0x13AFB58 sends login and signal tags only."
    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Resolved user identity for the refresh."
    }
}
json UpdatePermitPlaceInfoResp {
    doc "Full normal permission snapshot through the global response registry."
    field permitPlace type="[PermitPlace]" {
        key "yXNM8kL3"
        doc "Rebuilt from current progression, weekday and every parade window."
    }

    field permitPlaceSP type="[PermitPlaceSP]" {
        key "Y73tHKS8"
        doc "The SPECIAL half of the same snapshot.  PermitPlaceSpResponse::readParam clears removeSpecialObjects at row 0, and yXNM8kL3's removeNormalObjects deliberately SKIPS special rows -- so anything whose area is AreaMst type 1 or 3 has to come back on this key or it can never be withdrawn.  Same discriminated row shape; built by the shared snapshot builder."
    }

    field permitPlaceML type="[PermitPlaceML]" {
        key "Y73mHKS8"
        doc "The ML half, cleared by removeMLObjects.  AreaMst type 10.  Same contract as permitPlaceSP."
    }
}

json HunterOrbRefresh {
    doc "Partial ChallengeHeaderInfo update. APK ChallengeUserTeamResponse::readParam @0x13D3F94 only sets named fields, with no reset. Omitting HR and score preserves both ChallengeHeaderInfo and FrontierGateComInfo score."
    field aube type="i32::str" {
        key "38sHatGk"
        doc "Current Hunter Orb count, setter @0x13D4008; derived from persisted count/deadline."
    }
    field aube_rest_timer type="i32::str" {
        key "RHKA30s5"
        doc "Seconds to next orb, setter @0x13D4068; zero at cap. Does not alter rank or Frontier Gate score."
    }
}

// ---------------------------------------------------------------------------
// FixGiftInfo (gLRIn74v) -- the gift screen's one write.
//
// Modelled 2026-09-15 from FixGiftInfoRequest::createBody @0x13A37E4.  It does
// THREE things in one request, which is why the handler cannot be a stub:
//   * updates the player's wanted gift (from UserTeamInfo::getWantGift)
//   * CLAIMS the received gifts it names by gift_identify_id
//   * sends gifts to friends
// ---------------------------------------------------------------------------

json FixGiftInfoNode {
    doc "One FixGiftInfo write: the wanted-gift preference, the gifts being claimed, and the gifts being sent."

    field want_gift type="str" {
        key "s2WnRw9N"
        doc "The gift the player has asked friends for -- UserTeamInfo::getWantGift @0x13A3844, stored on user_info.want_gift.  The wiki calls this the request list; this build carries one id."
    }

    field receive_ids type="str" {
        key "23Xi0jom"
        doc "COMMA-SEPARATED gift_identify_ids being claimed, joined from UserState::getUserGiftInfoListRecieve.  Each names a row of the player's own inbox; granting must be idempotent because the client resends the whole selection."
    }

    field send_pairs type="str" {
        key "qD74LPXb"
        doc "Gifts being SENT, as `user_id_to:gift_id` pairs joined with commas (getUserIDTo and getGiftID, separators at 0x13A3A18/0x13A3A20).  Unused here until real friends exist."
    }
}

json FixGiftInfoReq {
    doc "Request for FixGiftInfo (gLRIn74v) -- fired by the gift screen's Receive button and after MissionEnd."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[FixGiftInfoNode]" {
        key "Gg5c3eM6"
        doc "The write itself."
    }
}

json GetGiftInfoReq {
    doc "Request for GetGiftInfo (ifYoPJ46) -- fired by GiftRecieveConnectScene::initConnect simply to open the gift screen."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json GetGiftInfoResp {
    doc """
    The gift inbox.

    MUST NOT BE EMPTY.  GiftRecieveListScene2 renders straight from
    UserGiftInfoList and setGiftList @0x166D330 null-derefs on an empty list --
    a deterministic client crash reproduced in two identical minidumps
    (+0x84F533, read 0x14).  An empty inbox is not a safe state here, which is
    why the simulated friend sends a gift a day.
    """

    field giftInfo type="[UserGiftInfo]" {
        key "30uygM9m"
        doc "The player's unclaimed gifts, same shape as UserInfoResp.giftInfo."
    }
}

// ---------------------------------------------------------------------------
// FriendDelete (SfMN9w4p) -- unfriend.  Shape from FriendDeleteRequest::
// createBody @0x13A3EC0.  FriendApply (WUNi08YL) and FriendAgree (NYKBH4V6)
// send the IDENTICAL body, so this struct will serve all three.
// ---------------------------------------------------------------------------

json FriendDeleteNode {
    doc "One friend named by the request."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "The friend's user id -- the same key the roster is emitted under in xZH6EIQ7 and tojMy68W."
    }
}

json FriendDeleteReq {
    doc "Request for FriendDelete (SfMN9w4p)."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[FriendDeleteNode]" {
        key "BPz1e5tU"
        doc "The friend(s) to drop."
    }
}

json FriendApplyNode {
    doc "One Summoner named by a friend request."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "The Summoner to add -- for the developer easter egg, the encounter id FriendGet offered in the picker."
    }
}

json FriendApplyReq {
    doc "Request for FriendApply (WUNi08YL).  Body shape identical to FriendDelete's, from FriendApplyRequest::createBody @0x13A3DA0."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[FriendApplyNode]" {
        key "BPz1e5tU"
        doc "The Summoner(s) being added."
    }
}

// Android arm64: createBody 0x1C706F0, readParam 0x1C7041C.
// The reader resets the list on its first field, then appends triples.
json UserEnteredFeatureInfo {
    doc "One feature/dungeon visit; zero new_flg means entered."
    field feature_id type="i32::str" {
        key "e63D1BV0"
        doc "Feature ID. Zero can accompany a dungeon-specific visit."
    }
    field dungeon_id type="i32::str" {
        key "MHx05sXt"
        doc "Dungeon ID, or zero for a feature-wide visit."
    }
    field new_flg type="i32::str" {
        key "Diwl3b56"
        doc "Zero means entered: confirmed by enteredCheckByFeatureID 0x1CBBE68 and getIfUserEnteredParadeFeature 0x1CBBD20. All traced request call sites send zero."
    }
}

json UserEnteredFeatureReq {
    doc "One client-reported visit, GroupId 983D5Dii."
    field login_info type="[LoginInfoReq]::size(1)" { key "IKqx1Cn9"; doc "Current player login."; }
    field entered_features type="[UserEnteredFeatureInfo]" { key "2386Diw1"; doc "Feature visit rows."; }
}

json UserEnteredFeatureResp {
    doc "Complete persistent visit history for the current player."
    field entered_features type="[UserEnteredFeatureInfo]" { key "2386Diw1"; doc "Feature visit rows."; }
}
