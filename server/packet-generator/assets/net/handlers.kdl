    """

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated team info (zel) after the sell."
    }

    field warehouse_info type="[UserWarehouseInfo]" {
        key "9wjrh74P"
        doc "Complete positive inventory, sent only when a sold unit had spheres equipped and gme::returnEquippedSpheres put them back.  readParam @0x14060E0 clears first: whole warehouse only."
        optional #true
    }
    field item_favorite type="[ItemFavorite]" {
        key "VSRPkdId"
        doc """
        The complete lock set, whenever this reply carries the warehouse.
        GameResponseParser::parseBodyTag @0x139B3E8 re-derives every row's lock
        from ItemFavoriteList (UserWarehouseInfoList::setFavorite) after BOTH
        VSRPkdId and 9wjrh74P, so the two together settle on the server's set
        in either order.  Without it, a copy the client locked under its craft
        placeholder (INT_MAX - itemId) came back under its real id unlocked
        until the next UserInfo.  A zero-row array never reaches readParam, so
        an empty set changes nothing.
        """
        optional #true
    }

    field item_dictionary_info type="[UserItemDictionaryInfo]" {
        key "bd5Rj6pN"
        doc "Every item species ever stacked, sent with warehouse_info (merge with dedupe; see PresentReceiptResp)."
        optional #true
    }
}

json GachaListResp {
    doc "Gacha list data returned when opening the summon screen."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key response block."
    }

    field gachaInfo type="[GachaInfoMst]" {
        key "1IR86sAv"
        doc "Current gacha info rows."
    }

    field gachaCategories type="[GachaCategory]" {
        key "IBs49NiH"
        doc "Current summon screen category rows."
    }

    field unitSelectorGacha type="[UnitSelectorGachaMst]" {
        key "JukkSeNA"
        doc """
        The Unit Selector catalogue (UnitSelectorGachaMstResponse).  Loaded at
        boot and, until 2026-09-13, never sent -- which is the OTHER half of
        "selector summons are not working".

        SummonsDetailScene::initSummontickets @0x1D8E304 builds the scene's
        selected-selector list by walking UnitSelectorGachaMstList for rows
        whose gacha_gate_id is the open gate, and touchBegan @0x16A73FC sends
        the player to the unit picker only when that list is NOT empty.  With
        the catalogue absent the list can never fill, so SUMMON on a selector
        gate fell through to the ordinary paid pull.  SummonsScrlItem::addObject
        @0x16D9F70 reads the same list for the ticket count on the rail tile,
        and UnitSelectorGachaUnitSelectScene::initialize @0x1D95CCC reads it for
        the grid of units to choose from.

        readParam @0x1CCAD3C merges rather than replaces (addObject with no
        remove), and rows are keyed by ticket id, so re-sending is harmless.
        """
    }
}

json MissionStartResp {
    doc "Response payload for starting a mission."

    field signal_key type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key response included in captured mission-start payloads."
    }

    field battle_groups type="[BattleGroupMst]" {
        key "pj41dy9g"
        doc "Battle group rows for each stage."
    }

    field battle_monster_groups type="[BattleMonsterGroupMst]" {
        key "75t0sx9z"
        doc "Monster placement rows for each battle group."
    }

    field monsters type="[MonsterMst]" {
        key "U0v5IeJo"
        doc "Mission-local monster MST rows."
    }

    field monster_cgs type="[MonsterCgsMst]" {
        key "8hoyIF9Q"
        doc """
        Per-animation-state sprite sheets for monsters with NO backing unit —
        i.e. non-obtainable bosses.  See MonsterCgsMst in net/mission.kdl.

        OPTIONAL ON PURPOSE.  MonsterCgsMstResponse::readParam @0x13E4E20 opens
        with MonsterCgsMstList::removeAllObjects, so emitting this block always
        would clear the client's cached list on every mission start — including
        for the ordinary missions that have nothing to put back.  Leaving it
        nullopt makes Glaze drop the key entirely (the same omission behaviour
        verified for the GachaInfoMst extras in handbook 7.11.6), so a mission
        with no special monsters sends exactly what the live captures show.
        """
        optional #true
    }

    field battle_skills type="[SkillMst]" {
        key "8aiBoHg5"
        doc """
        F_SKILL_MST rows for the monsters' BATTLE-ONLY skills, re-registered for
        this battle.

        A skill row whose ToZj4zyn is "0" (21,174 of the 33,381) is not kept:
        UnitSkillMstResponse::readParam @0x13F9E04 files it with
        UnitSkillMstList::addObjectTemporary, and GameUtils::
        battleTemporaryMstRemove @0x1176238 empties that list on every Home
        (GameScene::initAllContensFlg) and after every mission result.  So
        by the time a battle loads, every monster-only skill is gone, and
        GameScene::requestMonsterSummonFiles @0x16433CC dereferences
        UnitSkillMstList::getObject(id) unchecked: SIGSEGV at 0x48 the moment a
        boss with such a skill (Trial No. 001's Karl, 6140-6143) is loaded.

        In a response this key builds UnitSkillMstResponse(true)
        (GameResponseParser::getResponseObject @0x13928B8), which APPENDS: no
        removeAllObjects, and ToZj4zyn "0" rows go back into the temporary list,
        to be dropped again at the result scene.  (The full-replace variant is
        5hafnym7, never sent.)  UnitSkillMstList::getObject @0x135B398 searches
        the permanent list, then the temporary one.

        Only temporary rows are sent; a permanent row is still in the client's
        list.  Level rows (F_SKILL_LEVEL_MST) default to permanent and carry no
        ToZj4zyn, so they need no re-sending.  Optional: absent when the mission
        has no such skill.
        """
        optional #true
    }

    field ais type="[AIMst]" {
        key "89ausgc4"
        doc "Mission-local AI rows."
    }

    field mission_num type="[MissionNumInfo]::size(1)" {
        key "Kz7qfSs5"
        doc "Mission serial state required by MissionStartScene."
    }

    field start_info type="[MissionStartInfo]::size(1)" {
        key "9Q1Lq5FS"
        doc "Mission-start info consumed by the battle scene."
    }

    field frontier_battle type="[FrontierBattleInfo]" {
        key "eIQ79KO2"
        doc "Frontier Gate battles only: the floors and score the run has reached, which the battle starts from.  FrontierBattleInfoResponse is the only setter of that state, so a first battle gets zeros and every later one the last MissionEnd's values (see FrontierBattleInfo)."
        optional #true
    }
}

json MissionEndReq {
    // AUDIT 2026-08-24: createBody @0x13A78F8 is 5596 bytes over 64 keys; this
    // models 56 of them.  The 8 undeclared ones cost nothing today (our handler
    // reads only zel, karma, unit_rewards and item_rewards) but are recorded in
    // tools/SERVER_COMPONENT_AUDIT.md because a future achievements or Frontier
    // Hunter scoring feature needs exactly them:
    //
    //   ZYSWU9V1  group, emitted only when BattleState::isEp3TrialMode @0x13A82C4
    //             or isPlayNormalChallengeMission @0x13A82D0
    //   57YByKEt  group, only when isPlaySPChallengeMission @0x13A8860
    //             both carry TPR79fyI getNote, 7cev0fzQ getTotalScore,
    //             pG2n1A28 getClearBattleOrder, gUvjqu39 SaveData::getItemSetID
    //   pJqG1B7b  BattleLog string @0x13A7C98
    //   pgY9m2ne  BattleLog::getUnitUBBKoMonsterCntCsv @0x13A8138
    //   0w47scoa  BattleLog::getUBBDefeatMonsterElemCsv @0x13A81D8
    //
    // pG2n1A28 means clearBattleOrder HERE.  It is the Summoner's Journal
    // TARGET on its own class -- same hash, unrelated meanings (Rule Zero).
    //
    // 8 keys in battle_result are byte-identical with UserTeamArchive's trophy
    // counters (hoG2ieT5 6PLsn8xo 5NRJQ1LU XP06YWdT U8uZLA34 rZQJF5G9 TW1Mrtp5
    // e6BKoYy9).  The client reports them every mission; we discard them, which
    // is why those trophies read 0.
    doc "Request payload sent after a mission battle ends."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login/user identity included with mission-end requests."
    }

    field signal_key type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key sent by the client."
    }

    field mission_num type="[MissionNumInfo]::size(1)" {
        key "Kz7qfSs5"
        doc "Mission serial state being completed."
    }

    field battle_result type="[MissionBattleResultInfo]::size(1)" {
        key "rXvA1E5y"
        doc "Client-reported mission reward/result values."
    }

    field party_deck_info type="[UserPartyDeckInfo]" {
        key "0xgIw1Ns"
        doc "Party deck state after the mission."
    }

    field frontier_gate type="[FrontierGateMissionRef]" {
        key "dPM7oJDl"
        doc "Frontier Gate battles only (createBody @0x13A8B98): the gate."
        optional #true
    }

    field frontier_battle type="[FrontierBattleInfo]" {
        key "eIQ79KO2"
        doc "Frontier Gate battles only (createBodyFrontierGateBattle @0x13A8ED4): the run's floors and score after this battle."
        optional #true
    }
}

json MissionEndResp {
    doc "Response payload sent after a mission battle ends."

    field loginInfo type="[LoginInfoResp]::size(1)" {
        key "IKqx1Cn9"
        doc "Updated login/tutorial state after mission end."
    }

    field reward_info type="[MissionRewardInfo]::size(1)" {
        key "F5Vs19mb"
        doc "Mission reward values consumed by the result scenes."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated user team state after applying mission rewards."
    }

    field unit_info type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc "Newly awarded units from this mission."
    }

    field unit_dictionary type="[UserUnitDictionary]" {
        key "GV81ctzR"
        doc "The COMPLETE unit dictionary, sent when this mission awarded units (an empty list otherwise, which readParam never sees).  Never only the new species: this response rebuilds the reference list the summon lineup reads; see UserUnitDictionary."
    }

    field clear_mission_info type="[UserClearMissionInfo]" {
        key "UT1SVg59"
        doc """
        The caller's cleared missions, refreshed after this clear.

        Sent so the map marks the mission cleared IMMEDIATELY.  Without it the
        client only learns on the next UserInfo, so a freshly beaten mission
        kept its uncleared marker. Actual unlocks require the separate full
        PermitPlace replacement emitted alongside this list.

        SAFE as a partial list: UserClearMissionInfoResponse::readParam
        @0x13FD758 does getMissionID + addObject with NO removeAllObjects, so
        entries MERGE into the client's list rather than replacing it (§6.20).
        """
    }

    field permitPlace type="[PermitPlace]" {
        key "yXNM8kL3"
        doc "Full normal PermitPlace replacement after the clear. Filled by the shared current-state builder; see PermitPlace for the discriminated-row contract."
    }

    field permitPlaceSP type="[PermitPlaceSP]" {
        key "Y73tHKS8"
        doc "The SPECIAL half of the same snapshot.  PermitPlaceSpResponse::readParam clears removeSpecialObjects at row 0, and yXNM8kL3's removeNormalObjects deliberately SKIPS special rows -- so anything whose area is AreaMst type 1 or 3 has to come back on this key or it can never be withdrawn.  Same discriminated row shape; built by the shared snapshot builder."
    }

    field permitPlaceML type="[PermitPlaceML]" {
        key "Y73mHKS8"
        doc "The ML half, cleared by removeMLObjects.  AreaMst type 10.  Same contract as permitPlaceSP."
    }

    field warehouse_info type="[UserWarehouseInfo]" {
        key "9wjrh74P"
        doc "Complete positive inventory after crediting drops. APK readParam @0x14060E0 clears before adding; never send only earned stacks."
    }
    field item_favorite type="[ItemFavorite]" {
        key "VSRPkdId"
        doc """
        The complete lock set, whenever this reply carries the warehouse.
        GameResponseParser::parseBodyTag @0x139B3E8 re-derives every row's lock
        from ItemFavoriteList (UserWarehouseInfoList::setFavorite) after BOTH
        VSRPkdId and 9wjrh74P, so the two together settle on the server's set
        in either order.  Without it, a copy the client locked under its craft
        placeholder (INT_MAX - itemId) came back under its real id unlocked
        until the next UserInfo.  A zero-row array never reaches readParam, so
        an empty set changes nothing.
        """
        optional #true
    }
    field item_dictionary_info type="[UserItemDictionaryInfo]" {
        key "bd5Rj6pN"
        doc "Every item species in persisted inventory, including zero-count historical stacks, matching UserInfo."
    }
    field permit_receipes type="[PermitReceipe]" {
        key "51yQrDBR"
        doc "Complete recipe permissions after the clear. APK readParam @0x13E9B70 clears the recipe list; derive from all current facilities and cleared missions."
    }
    field town_location_detail type="[UserTownLocationDetail]" {
        key "s8TCo2MS"
        doc """
        Every town tile's harvest state, re-read after the clear (Town::
        locationState, against the same cleared set as permit_receipes).

        WHY MissionEnd: missions 11 and 12 unlock the Farm and the Mountain
        (TownLocationMst need_mission_id), and the client checks that gate
        itself against UT1SVg59 -- which this reply already updates.  But a
        locked tile is sent with no taps and no loot, and nothing but UserInfo
        ever re-sent this list, so a Farm unlocked mid-session passed its gate
        and still sat there with tap_cnt 0: no sparkle, and collectItem
        @0x18F24A8 returns silently on a tap (reported 2026-10-02 as "Farm says
        unlocked but is not").  Rolling here gives the newly opened tile its
        first period at the moment it opens, and lets the 3-hour refresh reach
        a long session at its next clear instead of its next login.

        Race-free: the client batches every tile tap into one TownUpdate it
        flushes on leaving town (captured "2:9,4:10" with the Home BadgeInfo),
        long before a battle ends.  UserTownLocationDetailResponse::readParam
        @0x1404090 clears the list at row 0, so this is always the full set.
        Omitted on a result that settles nothing.
        """
        optional #true
    }
    field energy_recover type="DefineEnergyRecover" {
        key "VkoZ5t3K"
        doc "The header energy-refill threshold, re-sent because a level-up raises max energy."
    }

    field frontier_battle type="[FrontierBattleInfo]" {
        key "eIQ79KO2"
        doc "Frontier Gate battles only: the run's state after this battle, echoed as the client reported it (see FrontierBattleInfo)."
        optional #true
    }

    field frontier_end type="[FrontierEndInfo]" {
        key "mu0kXAlV"
        doc "Frontier Gate battles only, and only when the battle was LOST: the run is over, and this block is what moves FrontierGateBattleEndScene on to the result scene (see FrontierEndInfo).  One row."
        optional #true
    }

    field frontier_rewards type="[FrontierResRewardInfo]" {
        key "QXFCkE67"
        doc "Sent with frontier_end: the rewards the ended run earned."
        optional #true
    }

    field event_token_info type="[EventTokenInfo]" {
        key "l234vdKs"
        doc "Sent when this battle's Frontier Gate rewards credited an event token (the Rift Token is the gate's own currency): the balances after the payout.  A full replace -- see EventTokenInfo."
        optional #true
    }

    field summon_ticket_v2_user type="[SummonTicketV2UserInfo]" {
        key "a3d5d12i"
        doc "Sent when this battle's Frontier Gate rewards credited a V2 summon ticket: the inventory after the payout.  A full replace -- see SummonTicketV2UserInfo."
        optional #true
    }
    field equip_info type="[UserEquipItemInfo]" {
        key "71U5wzhI"
        doc "The battle-item bar (user_equip_items, every slot, zero counts kept) after this battle's uses were spent.  UserEquipItemInfoResponse::readParam @0x13FE2E0 clears UserEquipItemInfoList at row 0 before adding, so this replaces the client's bar.  Without it the bar kept the used items until a restart, and the client let them be used again for free (ticket #9)."
        optional #true
    }
    field badge type="BadgeAchievementCount" {
        key "h23iRjGN"
        doc "The achievement badges after this battle, the complete set (parseBadgeData replaces it).  A battle can finish a daily Challenge (the Missions > Challenges count, category 2) or a trophy-backed achievement, and the client asks for BadgeInfo only at login and on Home/Randall town entry, so without this the count stayed dark for the rest of the session.  Set on every MissionEnd reply; optional only so that a reply built without it leaves the client's badges alone instead of clearing them."
        optional #true
    }

    field ep3_reward type="[MissionEp3Reward]" {
        key "M4w9LT7t"
        doc "Sent after a Chapter 3 quest (mission_ep3_mst): what it paid the Summoner, one row (see MissionEp3Reward)."
        optional #true
    }
    field summoner_info type="[UserSummonerInfo]" {
        key "n5mdIUqj"
        doc "Sent when the quest paid the Summoner anything: the whole UserSummonerInfo row after it (level, EXP, Summoning Arts, SP).  readParam re-inits the singleton first, so it must be the full row, as UserInfo sends it.  The client never moves these fields itself (only UserSummonerInfoResponse calls setExp/setLevel)."
        optional #true
    }

}


// Frontier Gate — request/response wrappers.  The FrontierGateInfo entry type
// and the full decode evidence live in net/frontier_gate.kdl; the IDA audit is
// tools/ida/audits/dPM7oJDl_audit.txt.
//
// Registration: REGISTER("M17pPotk", FrontierGateInfo, "sochkegz").  Note the
// request GroupId (M17pPotk) is NOT the response key (dPM7oJDl) — handbook 6.1.

json FrontierGateInfoReq {
    doc "FrontierGateInfo (M17pPotk) request.  createBody @0x13BB8C8 emits only the three BaseRequest tags (userInfo/signalKey/version) and ZERO addParam/addGroup/addNode calls, so this carries loginInfo only and the server derives the gate list from the resolved user.  The two trailing setFrogateID(\"\") calls in createBody are client-side resets of the suspended-info singletons, not wire fields."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json FrontierGateInfoResp {
    doc "FrontierGateInfo (M17pPotk) response — the player's per-gate progress list, keyed dPM7oJDl.  is_array=True per readparam_analysis.json, and readParam calls FrontierGateInfoList::addObject once per node, so this is a list even when it holds a single gate.  The legacy handler returned this empty ({\"dPM7oJDl\": []}), which is the safe idle shape."

    field gates type="[FrontierGateInfo]" {
        key "dPM7oJDl"
        doc "One entry per Frontier Gate the player has progress on."
    }
}

// Frontier Gate tier 2 — FrontierGateStart.  Entry types and the decode
// evidence are in net/frontier_gate.kdl.
//
// Registration: REGISTER("l3lkDBSc", FrontierGateStart, "vYPCD34q").

json FrontierGateStartReq {
    doc "FrontierGateStart (l3lkDBSc) request.  createBody @0x13BC3C0 branches on the isFGPlus flag: the normal Frontier Gate path emits group Mg8K8Y1a (gate id + support id) plus the deck/unit snapshot groups MxmCpDRC/52xDBRGr; the FGPlus path emits Che7rAre/cexa3Uwr/cr6qeFUP instead.  Only the normal path is modelled — handbook §11.2 says do not mix FGPlus into this subsystem.  The deck/unit snapshot groups are deliberately NOT declared yet; they belong to tier 3 (see tools/FRONTIER_GATE_STATE_MODEL.md) and the lenient read drops them harmlessly until then."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field frogate type="[FrontierGateStartEntry]::size(1)" {
        key "Mg8K8Y1a"
        doc "addGroup(\"Mg8K8Y1a\") + a single addNode — the gate being entered and the support picked."
    }

    field party_deck type="[FrontierGatePartyDeckInfo]" {
        key "MxmCpDRC"
        doc "The party the client is entering with, from FrontierGateBaseRequest::createBodySaveDataDeck.  Parsed so it can be echoed back — the client rebuilds its FG party list from the response."
    }

    field units type="[FrontierGateUserUnitInfo]" {
        key "52xDBRGr"
        doc "The unit snapshot, from FrontierGateBaseRequest::createBodySaveDataUnit.  MissionStartScene::downloadFiles reads FrontierGateUserUnitInfoList to decide which unit assets to fetch, so this MUST come back or the battle loads with no unit files."
    }
}

json FrontierGateStartResp {
    doc "FrontierGateStart (l3lkDBSc) response — the freshly opened run, keyed Mg8K8Y1a.  A single OBJECT, not an array: FrontierGateNumResponse::readParam writes the FrontierGateNum shared singleton rather than appending to a list (is_array=false in readparam_analysis.json).  Note the request wraps this same key in an array while the response does not."

    field num type="FrontierGateNum" {
        key "Mg8K8Y1a"
        doc "The active run: its handle, gate, support and stat multipliers."
    }

    field party_deck type="[FrontierGatePartyDeckInfo]" {
        key "MxmCpDRC"
        doc "The run's party, echoed back so the client's FG deck list is populated."
    }

    field units type="[FrontierGateUserUnitInfo]" {
        key "52xDBRGr"
        doc "The run's units, echoed back.  Without this FrontierGateUserUnitInfoList is empty and MissionStartScene::downloadFiles fetches no unit assets — the mission then crashes mid-load."
    }
}

json DungeonEventUpdateReq {
    doc "DungeonEventUpdate (BjAt1D6b) request — identity only as far as the server is concerned, but its login envelope carries the 9yVsu21R scene-intro list the client has played, which is the reason this struct exists rather than the handler ignoring the body."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user; also carries special_scenario_info (9yVsu21R)."
    }
}

// Generic shop spend.  CAPTURED FROM: a live Recover tap on the Frontier Gate
// "no Hunter Orbs" prompt, 2026-08-07 —
//   "32ibWjFG":[{"60IsqxDt":"5","03UGMHxF":"1","5gXxT7LZ":"0","rA9jDCP5":"0"}]
json ShopUseEntry {
    doc "One shop action — request group 32ibWjFG, a single node."

    field shop_use_type type="i32::str" {
        key "60IsqxDt"
        doc """
        ShopUseType — WHICH action this is.  Every setShopUseType call site:
          1   = fully restore Energy — the shop (ShopHelActionScene::touchBegan)
                and every "not enough Energy" prompt (MissionSelectShortage-
                StaminaScene, GameScene::confirmAnswerYesEnergy, the campaign,
                trial, raid and guild party screens); DefineMst
                action_point_heal_count gems, ext_cnt 0
          2   = expand the unit box   (ShopUnitBoxExtScene::confirmAnswerYes,
                                       setShopUseType(2) @0x1AD9984)
          3   = expand the item box   (ShopItemBoxExtScene::confirmAnswerYes,
                                       setShopUseType(3) @0x1AD0528)
          4   = fully restore Arena Orbs (ShopHelFightScene, ArenaTopScene);
                fight_point_heal_count gems
          5   = fully restore Hunter Orbs (Frontier Gate / Frontier Hunter)
          6   = buy a stamp set (ShopBuyStampScene; rA9jDCP5 = the set id)
          7   = +5 friend capacity (ShopFriendExtScene); friend_ext_count gems,
                ext_cnt 5
          8   = ColosseumTopScene::shopScene
          9   = UnitDetailVirtuallyInfoScene::resetConnect (edy7fq3L = unit)
          10  = Quest Repeat's Auto Energy Recovery (MissionResultRepeatCheck-
                Scene::recoverStamina); priced and handled like 1
          11  = ShopSummonerItemBuyDetailScene (T1IxCpTF = shop item id)
          12  = SummonerUnitMakeScene (9i2xhMaJ = next summoner sex)
          103 = VortexArenaTopScene (adds group d2b8d79J, n37dK9Xi)
        Types 2 and 3 are also what the Expand button on the Over Unit / Item
        Capacity warning reaches.  The client changes no counter itself after
        any of these (ShopUseConnectScene only checks the reply), so the
        team_info reply is the purchase.  The handler implements 1-5, 7, 9 and
        10 and ignores the rest rather than guess what they spend.
        """
    }

    field cost type="i32::str" {
        key "03UGMHxF"
        doc """
        Gem cost of the action, AS THE CLIENT PRICED IT; 1 for the orb restore.
        For 2/3 it is slots / 5 x DefineMst unit/item_box_ext_count — captured
        1 / 19 / 20 gems for 5 / 95 / 100 slots.  A client-supplied price is a
        claim: ShopUse recomputes it.  Same hash as team_info brave_coin and
        GachaInfoMst need_gems — see handbook §10.3 for the collision.
        """
    }

    field ext_cnt type="i32::str" {
        key "5gXxT7LZ"
        doc """
        Slots to add for types 2/3 (captured 5, 95, 100) and 7 (always 5); 0 on
        the energy and orb restores.
        Always a multiple of 5: both box scenes' ctors load 5.0f as the divisor
        SetNeedDiaNum uses (unit box @0x1AD6ACC -> +0x360, item box @0x1ACD870
        -> +0x338).  Named ExtCnt via UserUnitInfoResponse, which uses the same
        hash.
        """
    }

    field unk_ra9j type="i32::str" {
        key "rA9jDCP5"
        doc "The stamp set bought by type 6: createBody writes ShopUseRequest +0x20, which only setStampSetId @0x13ACBAC sets (its one caller is ShopBuyStampScene::confirmAnswerYes).  0 for every other type."
    }

    field user_unit_id type="str" {
        key "edy7fq3L"
        doc "The owned unit a type-9 use acts on.  ShopUseRequest::createBody @0x13AC8C8 adds it only when set, and its one setter caller is UnitDetailVirtuallyInfoScene::resetConnect @0x1BDEBDC (the Enhancements screen's Reset, priced at DefineMst reset_fe_skill_dia_count).  The client sends it only when the reset can do something: resetBtnSet @0x1BE2C88 disables the button while getFeUsedBP() is 0, and resetDialog @0x1BDF278 shows the shortage dialog instead when its gem count is below the price.  The body says nothing about the unit's state and carries no nonce, so a retry and a later genuine reset look the same.  Empty for every other type."
    }
    field next_summoner_sex type="i32::str" {
        key "9i2xhMaJ"
        doc "ShopUseType 12 only (ShopUseRequest::setNextSummonerSex): the gender SummonerUnitMakeScene is changing the Summoner Avatar to."
        optional #true
    }
}

json ShopUseReq {
    doc "ShopUse (xe8tiSf4) request.  createBody also emits conditional params edy7fq3L / T1IxCpTF / 9i2xhMaJ and a second group d2b8d79J for unit-targeted and Vortex-Arena uses; those are not modelled because no capture exercises them and the lenient read drops them harmlessly."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field shop_use type="[ShopUseEntry]::size(1)" {
        key "32ibWjFG"
        doc "The shop action being performed."
    }
}

json ShopUseResp {
    doc "ShopUse (xe8tiSf4) response.  The binary defines no ShopUseResponse class, so this returns the refreshed team_info the way every other currency-spending handler does (UnitSell/UnitMix) — that is what makes the client's gem and orb counters update without a full UserInfo round trip."

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Refreshed team info: gems after the spend, and the energy, orbs, box or friend capacity the purchase changed.  Sent on a refusal too, so the client falls back to the server's numbers."
    }

    field user_team type="HunterOrbRefresh" {
        key "kN2i7qds"
        doc "HUNTER ORBS AFTER THE PURCHASE.  ShopUse type 5 refills them, and they are NOT in team_info -- they live in the client's ChallengeHeaderInfo, whose only writer is this key.  Without it the player paid the Gem and the counter on screen stayed where it was, so the \"restore orbs\" prompt simply came back.  Sent only for the orb purchase. Uses the partial count/timer shape so buying orbs cannot overwrite HR or Frontier Gate score."
        optional #true
    }

    field unit_refresh type="[UserUnitInfo]" {
        key "4ceMWH6k"
        doc "Type 9 (reset a unit's SP enhancements) only: the COMPLETE roster, full-replace.  The client never clears fe_skill_info or moves SP back itself -- setFeBP / setFeUsedBP / setFeSkillInfo are written only by UserUnitInfoResponse::readParam -- and qC2tJs4E cannot update an owned unit, so this is the one way the reset shows.  Safe here: UnitDetailVirtuallyInfoScene re-resolves its unit by id in every function that reads it.  Optional so every other type omits it (an empty full-replace list would clear the roster)."
        optional #true
    }
    field summoner_info type="[UserSummonerInfo]" {
        key "n5mdIUqj"
        doc "ShopUseType 12: the whole UserSummonerInfo row with the new gender (readParam re-inits the singleton, so the full row)."
        optional #true
    }
}

json FeSkillGetEntry {
    doc """
    The one node of request group bx56032l.  FeSkillGetRequest::createBody
    @0x13CA7F4, filled by FeSkillGetRequest::setParam from
    UnitDetailVirtuallyInfoScene::feSkillGetConnect @0x1BDF7AC — ONE skill per
    request: the player taps a node (touchSkill stores that FESkillMst's id in
    the scene at +0x3C0) and confirms.
    """

    field unit_id type="str" {
        key "pn16CNah"
        doc "The unit's MST id, as the unit's own getter returns it."
    }

    field user_unit_id type="str" {
        key "edy7fq3L"
        doc "The owned unit being enhanced."
    }

    field fe_skill_id type="str" {
        key "ri6D9yBi"
        doc "The FeSkillMst id to acquire — a node of UnitFeSkillMst for this unit."
    }
}

json FeSkillGetReq {
    doc "FeSkillGet (nSQxNOeL / nZ2bVoWu) request: spend SP on one Omni enhancement. Registered by FeSkillGet.cpp on 2026-10-01. Reverified against createBody @0x13CA7F4 and setParam @0x13CA750; see docs/FE_SKILL_PURCHASE_2026-10-01.md in the parent repository."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key request block."
    }

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field fe_skill_get type="[FeSkillGetEntry]::size(1)" {
        key "bx56032l"
        doc "The skill being acquired."
    }
}

json FeSkillGetResp {
    doc """
    FeSkillGet response.  The binary has no FeSkillGetResponse class and the
    scene applies nothing itself: checkConnectResult only runs
    checkResponseMessage, and the unit's SP and skill list have no writer but
    UserUnitInfoResponse::readParam.  So the reply IS the purchase: the whole
    roster under 4ceMWH6k, which the Enhancements screen then redraws from
    (it looks its unit up by id every time, so the full replace leaves it
    nothing stale to hold).
    """

    field signal_key type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key echoed back."
    }

    field unit_refresh type="[UserUnitInfo]" {
        key "4ceMWH6k"
        doc "The COMPLETE roster, full-replace, carrying the unit's new fe_skill_info (Fnxab5CN), fe_bp and fe_used_bp.  Optional so a refusal never serialises an empty list."
        optional #true
    }
}

// Frontier Hunter hub.  "Challenge" is this binary's internal name for Frontier
// Hunter — c5yZnpB4 resolves to setFrohunID (ChallengeMvpResponse,
// ChallengeRankRewardResponse), and the Survey Office's HR / Hunter Orbs header
// is Frontier Hunter chrome that Frontier Gate sits behind.
json ChallengeInfo {
    doc "The currently running Frontier Hunter event — response key cvg8hzp9 (ChallengeInfoResponse), a single field.  The client needs a live event id before the Survey Office will show event state."

    field frohun_id type="i32::str" {
        key "c5yZnpB4"
        doc "setFrohunID — the active F_FROHUN_MST (challenge_mst.json) row id.  CONFIRMED by cross-class reuse: named setFrohunID in ChallengeMvpResponse (nUmaEC41) and ChallengeRankRewardResponse (p73SJiWv)."
    }
}

json ChallengeBaseResp {
    doc "ChallengeBase (nUAW2B0a) response.  The binary defines no ChallengeBaseResponse class, so this emits the response keys the Survey Office needs: cvg8hzp9 (the active event id) and kN2i7qds (the header state carrying Hunter Orbs).  The HR ladder already reaches the client as an MST (challenge_hr_mst.json ships under h09mEvDR via Initialize), so it does not need repeating here.  s7A3bGLe belongs to ChallengeUserInfo (jF3AS4cp), which has its own handler — the hub does not send it."

    field challenge_info type="ChallengeInfo" {
        key "cvg8hzp9"
        doc "The running Frontier Hunter event."
    }

    field user_team type="ChallengeUserTeam" {
        key "kN2i7qds"
        doc "Frontier Hunter header state — this is what feeds ChallengeHeaderInfo, where the Hunter Orb (Aube) counter actually lives."
    }
}

// ChallengeUserInfo (jF3AS4cp / Nst6MK5m) — the per-event state the Frontier
// Hunter lobby runs on.
//
// THIS WAS AN UNREGISTERED GROUPID, and an unregistered GroupId is answered
// "Unsupported request" with a Close command, which ends the session and looks
// exactly like a crash.  It is not hypothetical: deploy/log has the client
// firing it at 2026-09-13 07:28:53 — straight after a DungeonEventUpdate whose
// 9yVsu21R marker list ends in "challenge," (the Frontier Hunter intro) — and
// relaunching thirty seconds later.
//
// ChallengeUserInfoRequest::createBody @0x13A25D4 posts group a7HQ9sEB with the
// event id and the mission being inspected.

json ChallengeUserInfoReq {
    doc "ChallengeUserInfo (jF3AS4cp) request — the event and mission the lobby is asking about."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key request block."
    }

    field challenge type="[ChallengeUserInfoReqEntry]::size(1)" {
        key "a7HQ9sEB"
        doc "The one node createBody adds."
    }
}

json ChallengeUserInfoReqEntry {
    doc "Inner node of the ChallengeUserInfo request group a7HQ9sEB."

    field frohun_id type="str" {
        key "c5yZnpB4"
        doc "setFrohunID — the Frontier Hunter event being opened.  `str` because createBody passes it through the std::string addParam overload."
    }

    field mission_id type="str" {
        key "j28VNcUW"
        doc "setMissionID — the challenge mission the lobby is showing.  Same std::string overload."
    }
}

// ChallengeUserInfoResponse::readParam @0x13D3BEC — eight setters across TWO
// singletons, no list operations on either, so this is a single full row like
// n5mdIUqj rather than a list.
json ChallengeUserInfo {
    doc "Per-event Frontier Hunter state — response key s7A3bGLe.  Six fields land on ChallengeInfo::shared() and two on ChallengeHeaderInfo::shared()."

    field search type="i64::str" {
        key "TPR79fyI"
        doc "ChallengeHeaderInfo::setSearc @0x1258184 (read back as getSearch) — the player's survey SCORE for this event, parsed with StrToLongLong, so 64-bit.  ChallengeResultScene::initialize and updateStateCountUp are the only other writers, which is what a score looks like.  Same hash the Frontier Gate result uses for its score."
    }

    field frohun_flg type="i32::str" {
        key "QG5kcBz6"
        doc "ChallengeInfo::setFrohunFlg.  // UNVERIFIED — no reader found in this build."
    }

    field frohun_id type="str" {
        key "c5yZnpB4"
        doc "ChallengeInfo::setFrohunID — echoes the requested event.  Read by ChallengeBase::getFroMst, the lobby, the ranking/result/reward scenes and MissionStartScene::initConnect, so it has to name a real challenge_mst row."
    }

    field frohun_stat type="i32::str" {
        key "j0Uszek2"
        doc """
        ChallengeInfo::setFrohunStat — THE LOBBY GATE.

        ChallengeLobbyScene::startCheck @0x155CDB8 and
        ChallengeConditionScene::startCheck only proceed when this is exactly
        1; anything else draws CHALLENG_CHECK_TIME ("event not running") and
        refuses.  btnSetSt @0x155B904 pins a second value: 3 draws the blue
        "collect your reward" button, so 3 is the ended-and-payable phase and
        everything else falls through to the red entry button.  strPeriod and
        missionScene branch on it too.

        This server sends 0 on purpose.  A 1 lights the Start button, and the
        request behind it — ChallengeStart, sQfU18kH / m4sdYv9e — is not
        registered, so it would only move the session kill one tap further in.
        Register ChallengeStart before ever raising this.
        """
    }

    field frohun_term type="str" {
        key "s2gM3deu"
        doc "ChallengeInfo::setFrohunTerm — the event PERIOD text, rendered by ChallengeLobbyScene::strPeriod alongside frohun_stat."
    }

    field frohun_try type="i32::str" {
        key "2Cn0bWt9"
        doc "ChallengeInfo::setFrohunTry.  // UNVERIFIED — the getter has no callers in this build, so nothing reads it back."
    }

    field order type="i32::str" {
        key "vV4P53m7"
        doc "ChallengeHeaderInfo::setOrder @0x1258208 — the player's RANK on the event ladder.  Drawn by GameScene::updateHeader and setHeaderControl, and by ChallengeNewRankingScene::strNaveMsg."
    }

    field comment type="str" {
        key "WDUyI85C"
        doc "ChallengeInfo::setComment — the navigator's message on the lobby screen (ChallengeLobbyScene::strNaveMsg @0x155BF20)."
    }
}

json ChallengeUserInfoResp {
    doc "ChallengeUserInfo (jF3AS4cp) response.  Carries the event state the lobby gates on plus the header block, because the same screen reads Hunter Orbs out of ChallengeHeaderInfo in the same breath (ChallengeLobbyScene::startCheck reads getAube and getFrohunStat one after the other)."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key echoed back."
    }

    field challenge_user type="ChallengeUserInfo" {
        key "s7A3bGLe"
        doc "The event state — see ChallengeUserInfo.  A SINGLETON pair of writes, so send the full row."
    }

    field user_team type="ChallengeUserTeam" {
        key "kN2i7qds"
        doc "HR and Hunter Orbs — the same header block ChallengeBase sends, repeated here so the lobby's orb read is current."
    }
}

// Frontier Hunter ranking board.  Every field below is a REAL named setter from
// readparam_analysis.json — this struct contains no guessed names.
json ChallengeRankingEntry {
