}

json CampaignSaveReq {
    doc "CampaignSave (Utzc3oj5 / 6xc3GhQF) — sent by CampaignFieldInterruptScene when the player suspends.  The suspend data itself stays client-side (CampaignSceneBase::campaignEncodeSuspendData); only the mission and the item counts matter here."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field mission type="[CampaignMissionRef]" {
        key "2I9V0o6J"
        doc "The Grand Mission in progress."
    }

    field eqp_items type="[CampaignItemReqEntry]" {
        key "NjZ6ds1S"
        doc "Equipped items as they stand."
    }

    field deck_pos type="[CampaignDeckPosEntry]" {
        key "Yusr3Zg5"
        doc "Where each deck stands at the moment of the suspend -- see CampaignDeckPosEntry.  This is the block that makes a suspended run resume where it stopped."
        optional #true
    }
}

