json GachaActionResp {
    doc "Response payload sent after resolving a summon pull."

    field signal_key type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key echoed back to the client."
    }

    field ope_user_unit type="[OpeUserUnitInfo]" {
        key "Km35HAXv"
        doc """
        Summoned unit ids and animation metadata.

        The client accepts multiple rows here for multi-summon result data.
        However, only the last row controls which unit gets the gate-opening
        animation.
        """
    }

    field unit_info type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc """
        Newly summoned owned-unit rows appended to the client unit list.
        """
    }

    field unit_dictionary type="[UserUnitDictionary]" {
        key "GV81ctzR"
        doc "The COMPLETE unit dictionary after the summon, never just the summoned species.  This response rebuilds the reference list the summon lineup reads; see UserUnitDictionary."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated user team state after spending summon currency."
    }

    field selector_ticket_info type="[UnitSelectorGachaUserInfo]" {
        key "CGHaOZda"
        doc "Sent only by UnitSelectorGachaTicket, which reuses this reply: the selector inventory after the spent ticket, every catalog ticket with its count (0 included), because the list is a full replace and nothing on the client decrements it.  See UnitSelectorGachaUserInfo."
        optional #true
    }

    field summon_ticket_v2_user type="[SummonTicketV2UserInfo]" {
        key "a3d5d12i"
        doc "Sent when the pull was paid with V2 summon tickets: the ticket inventory after the spend.  SummonTicketV2UserInfoResponse::readParam @0x1C6EBB4 clears the list first, so this is a full replace and the spent type keeps reporting itself at 0; without it the gate goes on showing the pre-spend count until the next UserInfo."
        optional #true
    }
}

