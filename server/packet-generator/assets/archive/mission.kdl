json MonsterSkill {
    doc """
    One skill a mission monster can use in battle.

    The wire carries these as MonsterMst.monster_skill_id (F4bQ7r8C), a single
    packed string; this object is the authored form and MissionArchiver packs
    it.  Format decoded from the parser itself,
    BattleUnit::setUnitSkill(MonsterMst*) @0x1120CF0:

        getMonsterSkillID()
          -> CommonUtils::parseList(s, "@")     outer, one entry per skill
          -> CommonUtils::parseList(entry, ":") inner, [0]=skill id, [1]=flag

    The separators are not guessed -- they are SSO std::strings built from
    immediates in that function (mov w8,#0x4002 -> '@' @0x1120CFC;
    mov w8,#0x3a02 -> ':' @0x1120DA8).  An entry with a single element is
    legal: the code guards the second parse with `cmp x8,#2 / b.lo` and
    substitutes 0.
    """

    field skill_id type="u32::int" {
        key "skill_id"
        doc """
        Joins to the ORDINARY skill table, not a monster-specific one.
        setSkillParam @0x1120684 resolves it through UnitSkillMstList (and
        UnitSkillLevelMstList for the level row) -- i.e. deploy/mst/skill_mst.json,
        33 381 rows, the same table player units use.

        A monster-only skill (ToZj4zyn "0" in skill_mst.json) is dropped by the
        client on every Home, so MissionStart re-sends its row
        (MissionStartResp.battle_skills); without it the battle crashes at load
        in GameScene::requestMonsterSummonFiles.  Every authored skill_id must
        therefore exist in skill_mst.json (MissionArchiver refuses the mission
        otherwise).

        ⚠ THERE IS NO MONSTER SKILL TABLE TO FILL.  MonsterSkillMst exists as a
        class (MonsterSkillMstResponse::readParam @0x13E609C, wire block
        m9Ada1PN, 15 keys: F4bQ7r8C skill_id, LC92Js8Z skill_name, 6E2fGPWT
        range, moWQ30GH target_type, IZt73kLG target_area, eyUo6a8c
        effect_frame, qYCx73y2 start_frame, 6Aou5M9r damage_frame, n9h7p02P
        drop_check_cnt, 9pXSKmn1 wait, j5xF8PSy active_turn, 2JYTh84z
        battle_crystal_cost, hjAy9St3 process_id, 2Smu5Mtq process_param,
        qp37xTDh description) -- but MonsterSkillMstList::getObject has exactly
        ONE caller, GameUtils::getMonsterCutinImage @0x117DCC4, and THAT has
        zero callers.  The table is dead in this build.  Do not build an
        m9Ada1PN emitter; nothing would ever read it.
        """
    }

    field show_name type="bool::bool" {
        key "show_name"
        doc """
        Whether the skill's name is announced on screen when it fires.  This is
        inner element [1]: its StrToInt result feeds
        BattleUnitSkill::setSkillNameDispFlg(bool) @0x1120F58 as `!= 0`.
        Absent or 0 means the skill fires unnamed.
        """
    }
}

json AilmentResists {
    doc """
    Per-ailment resistance percentages for a monster, 0-100.

    Packed by MissionArchiver into MonsterMst.bad_state_resists (CEeqs63b) as
    six colon-separated values.

    THE ORDER IS BINARY-CONFIRMED (2026-09-25).  BattleUnit::judgeBadCondition
    @0x1101310 splits the target's resist string on ':' and reads slot
    [ailment id - 1], and BattleUnit::searchAiTarget's ailment search terms
    name the ids: poison 1, weakness 2, sick 3, injury 4, curse 5,
    paralysis 6 (isBadState calls @0x1133190..0x1133380).  The skill tables
    agree -- Lightning Axe's `6,50` is the wiki's 50% paralysis, Light Attack's
    `2,40` its 40% weakness.  So slot N below is ailment id N.
    """

    field poison type="u32::int" {
        key "poison"
        doc "Slot 1."
    }
    field weak type="u32::int" {
        key "weak"
        doc "Slot 2 — defence down."
    }
    field sick type="u32::int" {
        key "sick"
        doc "Slot 3 — recovery down."
    }
    field injury type="u32::int" {
        key "injury"
        doc "Slot 4 — attack down."
    }
    field curse type="u32::int" {
        key "curse"
        doc "Slot 5 — BB gauge frozen."
    }
    field paralysis type="u32::int" {
        key "paralysis"
        doc "Slot 6 — immobility."
    }
}

json TreasureDrop {
    doc "One possible treasure chest reward for a mission-local monster."

    field target_type type="u32::int" {
        key "target_type"
        doc "Client target type: 1=zel, 2=karma, 3=battle/heart crystal, 4=item."
    }

    field weight type="u32::int" {
        key "weight"
        doc "Selection weight for this reward inside the treasure chest table."
    }

    field amount type="u32::int" {
        key "amount"
        doc "Reward amount, item count, or crystal count depending on target_type."
    }

    field amount_max type="u32::int" {
        key "amount_max"
        doc """
        Optional top of a ranged amount: the chest gives `amount` to
        `amount_max` (inclusive), rolled when MissionStart decides the chest
        ("1-3 Rose Bolt").  Absent, or not above `amount`, keeps the fixed
        `amount`.
        """
        optional #true
    }

    field target_id type=str {
        key "target_id"
        doc "Item id for target_type 4; empty for zel, karma, and crystals."
    }
}

json MonsterVisuals {
    doc """
    Everything a NON-OBTAINABLE monster needs in order to be drawn, supplied
    inline instead of borrowed from a unit.

    Presence of this object is the discriminator: an enemy that has it is a
    special monster (a story boss like the Juggernaut), an enemy that omits it
    is an ordinary re-skinned playable unit and takes its visuals from the
    unit.json record named by `unit_id`.

    That mirrors the only test the client makes.  GameScene::requestMonsterFiles
    @0x160F648 (arm64 libgame.so) asks UnitMstList for the MonsterMst row's
    unit_id and picks its asset root from the answer:

      resolves -> /unit/,    filenames DERIVED as unit_anime_<unit_id>.png
      misses   -> /monster/, filenames READ VERBATIM from the MonsterMst row

    So an enemy carrying this object must ALSO leave `unit_id` at 0 (or at any
    id absent from unit_mst).  Give it a real unit id and the client takes the
    first branch, ignores every filename below, and cheerfully draws a Metal
    Ghost with the boss's HP.

    The fields fall into three groups: the two art filenames, the four
    animation csvs, and the visual/movement values that would otherwise have
    come from the unit record.
    """

    field img_a type=str {
        key "img_a"
        doc """
        Sprite-sheet filename under content/monster/img/, e.g.
        "monster_anime_0001.png" (the Juggernaut).  Emitted as MonsterMst
        `2EF0d6ue`; read by GameUtils::getMonsterAnmImage @0x117DB00.
        REQUIRED — an empty value here defeats the whole branch.
        """
    }

    field anm_cgg type=str {
        key "anm_cgg"
        doc """
        Frame-geometry filename under content/monster/cgg/, e.g.
        "monster_cgg_0001.csv".  Emitted as MonsterMst `QqfI9mM4`; read by
        GameUtils::getMonsterCgg @0x1EAFBF8.  REQUIRED.
        """
    }

    field cgs_idle type=str {
        key "cgs_idle"
        doc """
        Idle animation under content/monster/cgs/, e.g.
        "monster_idle_cgs_0001.csv".  Becomes a MonsterCgsMst row with
        cgs_type 1 in the 8hoyIF9Q block.  Leave empty to omit the row.
        """
    }

    field cgs_move type=str {
        key "cgs_move"
        doc """
        Move animation, cgs_type 2.  USUALLY EMPTY: content/monster/cgs holds
        110 idle and 110 attack csvs against only 9 move csvs, so most special
        monsters simply have no move art and the client copes.
        """
    }

    field cgs_atk type=str {
        key "cgs_atk"
        doc """
        Attack animation, cgs_type 3, e.g. "monster_atk_cgs_0001.csv".
        """
    }

    field cgs_skill type=str {
        key "cgs_skill"
        doc """
        Skill animation, cgs_type 4.  The unit-side table reuses the attack csv
        for this slot on every single row ("...|3:unit_atk_cgs_N.csv|
        4:unit_atk_cgs_N.csv"), so setting this to the same file as `cgs_atk`
        is the faithful default.
        """
    }

    field element type="u32::int" {
        key "element"
        doc "1 Fire, 2 Water, 3 Earth, 4 Thunder, 5 Light, 6 Dark.  MonsterMst iNy0ZU5M."
    }

    field effect_frame type=str {
        key "effect_frame"
        doc """
        Attack effect timing, "frame:effect:layer" triples.  MonsterMst
        eyUo6a8c.  MUST describe the chosen atlas, not a unit — this is the
        field most likely to look subtly wrong if copied from a unit record.
        """
    }

    field damage_frame type=str {
        key "damage_frame"
        doc "Damage timing, MonsterMst 6Aou5M9r.  Same caveat as effect_frame."
    }

    field drop_check_count type="u32::int" {
        key "drop_check_count"
        doc "Drop roll count.  MonsterMst n9h7p02P."
    }

    field move_speed type="i32::int" {
        key "move_speed"
        doc "MonsterMst J2hPXGo5."
    }

    field attack_move_type type="i32::int" {
        key "attack_move_type"
        doc "MonsterMst mv4o39Uz."
    }

    field back_move_type type="i32::int" {
        key "back_move_type"
        doc "MonsterMst h2L1YI90."
    }

    field after_image type="i32::int" {
        key "after_image"
        doc "MonsterMst D4Y5bWK7."
    }

    field skill_move_type type="i32::int" {
        key "skill_move_type"
        doc "MonsterMst XE7Yi5c3."
    }

    field cursor_disp_pos type=str {
        key "cursor_disp_pos"
        doc """
        Targeting-cursor offset, "x,y".  MonsterMst Lkh6gYkT.  Every ordinary
        enemy carries "0,0"; a boss sprite is several times unit size and is
        expected to need a real offset.
        """
    }

    field hp_disp_pos type=str {
        key "hp_disp_pos"
        doc """
        HP-bar offset, "x,y".  MonsterMst 3BpHN6VD.  Empty on every captured
        live row, for the same reason cursor_disp_pos is — no live mission we
        captured contained a special monster.
        """
    }
}

json BattleMonster {
    doc """
    Logical monster entry for a mission stage.

    This stores the official monster id used by client monster text/MST lookups.
    Client battle group ids are still transient and generated while formatting
    mission-start responses.
    """

    field id type="u32::int" {
        key "id"
        doc "Official monster id used by the client's monster text/MST lookups."
    }

    field name type=str {
        key "name"
        doc "Human-readable monster name."
    }

    field unit_id type="u32::int" {
        key "unit_id"
        doc """
        Unit archive id backing this monster's visuals and stable MST data.

        Must resolve in unit.json UNLESS `visuals` is present, in which case it
        must deliberately NOT resolve — set it to 0.  See MonsterVisuals.
        """
    }

    field visuals type=MonsterVisuals {
        key "visuals"
        doc """
        Present only for a non-obtainable special monster (a story boss).  When
        set, this enemy supplies its own art and movement data and no unit
        archive lookup is performed; when absent, the enemy is an ordinary
        re-skinned unit and everything visual comes from `unit_id`.

        Optional so that every mission authored before this field existed keeps
        loading unchanged — Glaze leaves a missing key default-initialised.
        """
        optional #true
    }

    field skills type="[MonsterSkill]" {
        key "skills"
        doc """
        Skills this monster can use, packed into MonsterMst.monster_skill_id.
        Optional: a monster with no skills sends an empty string, which is what
        every captured live row carries.

        ⚠ THE SKILL LEVEL IS NOT AUTHORABLE.  setSkillParam is handed
        MonsterMst::getSkillLevel() as its level argument, and
        MonsterMst::setSkillLevel @0x1334D48 has ZERO callers -- no response
        anywhere sets it -- so it stays at the value the constructor left in
        member 0x190 for every monster in the game.  Skills therefore fire at
        whatever level that default resolves to in UnitSkillLevelMstList.
        """
        optional #true
    }

    field ailment_resists type=AilmentResists {
        key "ailment_resists"
        doc """
        Status-ailment immunities, packed into MonsterMst.bad_state_resists.
        Omit it for an ordinary enemy: MissionArchiver then sends
        "0:0:0:0:0:0", which is what every live row carries and what this
        archiver hard-coded before bosses became authorable.
        """
        optional #true
    }

    field passive_procs type=str {
        key "passive_procs"
        doc """
        Passive effects the enemy has from the start of the battle
        (ticket #162): passive proc ids in the leader-skill format,
        joined by '@' ("1@5").  Sent as MonsterMst.passive_process_id
        (hjAy9St3); MonsterUnit::setPassiveList reads it (with
        getPassiveProcessParam) like a unit's own passives, as guild guardians
        use it.  Omit it for none: every live row sends "".
        """
        optional #true
    }

    field passive_params type=str {
        key "passive_params"
        doc """
        The params of passive_procs, one comma list per proc joined by '@'
        ("50,0,0,0,0@1,30").  Sent as MonsterMst.passive_process_param (2Smu5Mtq).
        """
        optional #true
    }

    field position type=str {
        key "position"
        doc "Battlefield position formatted as x:y."
    }

    field hp type="u32::int" {
        key "hp"
        doc "Monster hp for this mission."
    }

    field atk type="u32::int" {
        key "atk"
        doc "Monster atk for this mission."
    }

    field def type="u32::int" {
        key "def"
        doc "Monster def for this mission."
    }

    field ai_id type="u32::int" {
        key "ai_id"
        doc "AI archive id used by this monster."
    }

    field act_min type="u32::int" {
        key "act_min"
        doc "Minimum number of actions this monster may take per turn."
    }

    field act_max type="u32::int" {
        key "act_max"
        doc "Maximum number of actions this monster may take per turn."
    }

    field act_rate type="f32::int" {
        key "act_rate"
        doc """
        Percent chance of each action beyond `act_min`, up to `act_max`.
        MonsterUnit::initTurnChild @0x1159098 starts from min_act_count and
        rolls act_rate once per extra step, so 1/2 at 50 is "one action, half
        the time two".

        Optional: absent sends 100, which every captured live row carried and
        which makes the monster always take `act_max` actions -- the behaviour
        of every mission authored before this field existed.
        """
        optional #true
    }

    field wait type="i32::int" {
        key "wait"
        doc "Monster wait value (Not sure where this comes from yet)."
    }

    field unit_drop_id type="u32::int" {
        key "unit_drop_id"
        doc "Dropped unit id, or 0 when this monster does not drop a unit."
    }

    field unit_drop_level type="u32::int" {
        key "unit_drop_level"
        doc "Dropped unit level, or 0 when this monster does not drop a unit."
    }

    field unit_drop_type type="u32::int" {
        key "unit_drop_type"
        doc "Dropped unit type emitted in MissionNumInfo drop info, or 0 when this monster does not drop a unit."
    }

    field unit_drop_chance type="u32::int" {
        key "unit_drop_chance"
        doc "Dropped unit chance percent, or 0 when this monster does not drop a unit."
    }

    field authored_capture type="bool" {
        key "authored_capture"
        doc """
        Set when `unit_drop_chance` is a DELIBERATE number rather than whatever
        the regenerated archive happened to carry, which stops the 40 percent
        capture floor in MissionArchiver from raising it.

        The floor exists because the regenerated archive left most monsters at
        0 or 5 percent, and it cannot tell a junk 5 from an authored 10.  The
        event dungeons need the difference: Evan's rule for them (2026-09-19) is
        that the boss is the top form of its chain and ONLY its base form is
        capturable, at 10 percent, with the escorts not capturable at all —
        none of which survives a blanket raise to 40.

        Optional so every mission authored before this field existed keeps
        loading unchanged; absent means "not authored", i.e. the floor applies.
        """
        optional #true
    }

    field zel_max_drop type="u32::int" {
        key "zel_max_drop"
        doc "Maximum zel this monster can drop."
    }

    field zel_drop_count type="u32::int" {
        key "zel_drop_count"
        doc "Number of zel drop rolls for this monster."
    }

    field karma_max_drop type="u32::int" {
        key "karma_max_drop"
        doc "Maximum karma this monster can drop."
    }

    field karma_drop_count type="u32::int" {
        key "karma_drop_count"
        doc "Number of karma drop rolls for this monster."
    }

    field treasure_chest_chance type="u32::int" {
        key "treasure_chest_chance"
        doc "Treasure chest chance percent, or 0 when there is no treasure drop."
    }

    field treasure_drops type="[TreasureDrop]" {
        key "treasure_drops"
        doc "Possible rewards when the treasure chest roll succeeds."
    }
}

json MissionStage {
    doc """
    Logical stage inside an archived mission.

    A stage becomes one client BattleGroupMst row and one generated client
    battle monster group id. Its battle_monsters become BattleMonsterGroupMst rows.
    """

    field is_boss type=bool {
        key "is_boss"
        doc "Whether this stage should be marked as the boss battle."
    }

    field first_attack_rate type="u32::int" {
        key "first_attack_rate"
        doc """
        Chance that monsters attack before the player.
        Use 0 to disable preemptive attacks.
        """
    }

    field battle_monsters type="[BattleMonster]" {
        key "battle_monsters"
        doc "Battle monster entries that should appear in this stage."
    }
}

json MissionMimicChest {
    doc """
    Server-authored chest encounter, separate from the ordered mission waves.
    MissionDropInfo::parseTreasureBoxDropInfo @0x1266644 links the chest to a
    zero-based monster order. BattleTreasure::create @0x10E7AAC reads the
    referenced group; MonsterParty::entryMimic @0x10C218C enters its first monster.
    No capture roll emits one group-id token. A successful unit_drop_chance roll
    emits group:0:0:unitId:level:type (six tokens); never emit lengths 2-5.
    Capture must reference the side enemy's own species. Keep treasure_chest_chance
    zero and treasure_drops empty to prevent nested chests.
    Currency combat drops still use the monster's usual MST fields.
    """
    field stage type="u32::int" {
        key "stage"
        doc "One-based host wave, matching MissionDropInfo battle order @0x10C1FB0."
    }
    field monster_order type="u32::int" {
        key "monster_order"
        doc "Zero-based host enemy receiving the chest @0x10C20C4."
    }
    field chance type="u32::int" {
        key "chance"
        doc "Server policy: 0-100 percent chance to emit a Mimic chest. 100 guarantees it. Replaces the host enemy's ordinary treasure roll."
    }
    field monster type=BattleMonster {
        key "monster"
        doc "Single enemy in a generated side group. entryMimic @0x10C218C dereferences member zero; this is not an additional BattleGroupMst wave."
    }
}

json RandomMimicChests {
    doc """
    Server-authored policy for replacing a SUCCESSFUL ordinary chest roll.
    chance is conditional on a chest existing, not a per-enemy spawn rate.
    The 10 percent rollout is Evan's choice (2026-09-09), not recovered MST data.
    The resulting payload follows BattleTreasure::create @0x10E7AAC and
    MonsterParty::entryMimic @0x10C218C; the chest/warning path is APPX-confirmed.
    """
    field chance type="u32::int" {
        key "chance"
        doc "0 disables substitution; 100 replaces every eligible chest. Inclusive percent roll on the server."
    }
    field monsters type="[BattleMonster]" {
        key "monsters"
        doc """
        Equal-weight Mimic candidates; one generated side group per candidate.
        Optional capture/no-nested-chest contract, as for MissionMimicChest.monster.
        In shared mimic.json this is the species catalog: prefer species already
        placed in the mission, using that placement's battle stats; otherwise
        use the first catalog member. Per-mission overrides use their exact list.
        Battle stats and species selection are authored policy, not wire semantics.
        """
    }
}

json MissionRecord {
    doc """
    Server-owned curated mission archive data.

    This stores the stable logical mission layout. Client-specific ids and
    encoded response strings should be produced when the server formats the
    mission-start response.
    """

    field id type="u32::int" {
        key "id"
        doc "Mission archive id."
    }

    field name type=str {
        key "name"
        doc "Human-readable mission name."
    }

    field zel type="u32::int" {
        key "zel"
        doc "Zel awarded for clearing this mission."
    }

    field karma type="u32::int" {
        key "karma"
        doc "Karma awarded for clearing this mission."
    }

    field exp type="u32::int" {
        key "exp"
        doc "Experience awarded for clearing this mission."
    }

    field energy_cost type="u32::int" {
        key "energy_cost"
        doc "Energy consumed when starting this mission."
    }

    field random_mimics type=RandomMimicChests {
        key "random_mimics"
        optional #true
        doc "Optional mission override of archive/mimic.json. Omit to inherit the shared policy; chance 0 explicitly disables it. Fixed mimic_chests hosts take precedence."
    }

    field mimic_chests type="[MissionMimicChest]" {
        key "mimic_chests"
        optional #true
        doc "Optional chest encounters. Side group ids follow all wave group ids in list order. Omit to preserve existing mission behavior."
    }

    field stages type="[MissionStage]" {
        key "stages"
        doc "Ordered stages in this mission."
    }

    field script_monsters type="[BattleMonster]" {
        key "script_monsters"
        doc """
        Monsters the client's own mission script brings into the battle, which
        no wave places.  The script lives client-side in F_MISSION_SCRIPT_MST;
        its command 6 (and 11) calls MonsterParty::changeMonster @0x10C3160,
        which REPLACES the monster that triggered the event with another
        monster id and re-initialises it from MonsterMstList -- so each of
        these needs a MonsterMst row, its AI rows and its art in the
        MissionStart response, and nothing else.  They get no
        BattleMonsterGroupMst row, which is what keeps them off the opening
        field.

        That table's second column names the monsters a script features --
        "1102,54501" for Trial No. 003, the two it swaps in; Trial No. 002
        lists its own opening boss -- and MissionScriptMstResponse::readParam
        never reads it, so it was the original server's list of monsters to
        describe.  Any of them not already in a wave belongs here.

        Ids must not repeat within this list or collide with a wave monster's
        id.  Drops, capture and chests do not apply to them.  Optional: absent
        means the mission has no scripted monsters.
        """
        optional #true
    }
}
