// F_UNIT_EVO_* — unit evolution: the standard evolution recipe table plus the
// three Omni Evolution (7-star+) tables.  Ported in the handbook §8.37 pass;
// wired 2026-08-05.  Wrapper keys are each struct's `hash`.
//
// Value evidence in field docs was captured from the ported deploy/system
// files (1342/18/36/70 rows).
//
// The Omni tables key off the triple (omni_level, evo_type, cost) rather than
// a row id — UnitEvoOmniTypeMst gives the zel/karma price of a step,
// UnitEvoOmniRecipeMst its materials, and UnitEvoOmniMst its stat awards.
//
// ENCODING TRAP: the whole MST corpus ships every scalar as a QUOTED string,
// but these three tables break that rule inconsistently.  The join keys
// `gvT2ds0Q`/`49sa3sld` are raw JSON ints in UnitEvoOmniTypeMst and
// UnitEvoOmniRecipeMst (`"gvT2ds0Q": 45`) yet quoted strings in
// UnitEvoOmniMst (`"gvT2ds0Q": "45"`), and `s049sdck` is a raw int in the
// recipe table but a string in the type table.  Hence the ::int vs ::str
// split below — it is not a typo.  The three Omni files were evidently
// produced by a different exporter path from the rest of the corpus.

json UnitEvoMst {
    doc "Standard unit evolution recipes (wrapper hash yY3Mvp51).  1342 rows — one per evolvable unit."
    hash "yY3Mvp51"

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "Unit being evolved (10011..87602602).  Same hash/name as unit.kdl."
    }

    field evo_unit_id type="i32::str" {
        key "74VFwuTd"
        doc "// UNVERIFIED (named from value): resulting unit (10012..87602603) — the source unit id + 1 on most rows."
    }

    field zel type="i32::str" {
        key "Rs7bCE3t"
        doc "Zel cost (1000..7133700).  This hash is `cost` in unit.kdl; the values here are clearly the evolution fee."
    }

    field karma type="i32::str" {
        key "HTVh8a65"
        doc "Karma cost (0..1500000).  Same hash/name as mission.kdl/raid.kdl."
    }

    field material_1_kind type="i32::str" {
        key "Xyt6rhx2"
        doc "Kind of material_1: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_2_kind type="i32::str" {
        key "0tna4Idu"
        doc "Kind of material_2: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_3_kind type="i32::str" {
        key "6GwnugW3"
        doc "Kind of material_3: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_4_kind type="i32::str" {
        key "hdF8ND2H"
        doc "Kind of material_4: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_5_kind type="i32::str" {
        key "nB7pFdR0"
        doc "Kind of material_5: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_6_kind type="i32::str" {
        key "IZUvR489"
        doc "Kind of material_6: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_7_kind type="i32::str" {
        key "bNRUuatB"
        doc "Kind of material_7: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_8_kind type="i32::str" {
        key "2BFgYLjg"
        doc "Kind of material_8: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field material_9_kind type="i32::str" {
        key "18Oz7z8k"
        doc "Kind of material_9: 1 = a unit id (or an unused slot), 2 = an item id.  Verified on all 1342 rows: every non-zero material slot whose id is an ItemMst id carries 2 and every unit id carries 1 (333 item slots, 7107 unit slots, 0 exceptions); UnitEvoRequest::createBody @0x13AE818 sends the same code as 29MgiJIQ.  Unused slots carry 1 (4578 slots) or 0 (60 slots)."
    }

    field unk10 type="i32::str" {
        key "EK7jR4rB"
        doc "// UNVERIFIED: 0/1 flag.  unk1..unk10 are a block of ten small ints that most likely qualify the nine material slots below, but the counts do not line up 1:1, so the pairing is NOT asserted here."
    }

    field material_1 type="i32::str" {
        key "85X6JHQA"
        doc "// UNVERIFIED (named from value): first evolution material, a unit id (10130..87602602).  All-zero in UnitFeCategoryMst, which shares this hash."
    }

    field material_2 type="i32::str" {
        key "wh3YRU08"
        doc "// UNVERIFIED: second material unit id, 0 where the slot is unused."
    }

    field material_3 type="i32::str" {
        key "7MxucW2J"
        doc "// UNVERIFIED: third material unit id (0..890033)."
    }

    field material_4 type="i32::str" {
        key "j7fTS3ca"
        doc "// UNVERIFIED: fourth material unit id (0..890033)."
    }

    field material_5 type="i32::str" {
        key "Hb8yfmv7"
        doc "// UNVERIFIED: fifth material unit id (0..890033)."
    }

    field material_6 type="i32::str" {
        key "Voht18AP"
        doc "// UNVERIFIED: sixth material unit id (0..880244)."
    }

    field material_7 type="i32::str" {
        key "3g8brFoq"
        doc "// UNVERIFIED: seventh material unit id (0..820034)."
    }

    field material_8 type="i32::str" {
        key "agp4CKEV"
        doc "// UNVERIFIED: eighth material unit id (0..880020)."
    }

    field material_9 type="i32::str" {
        key "eKPWNoLn"
        doc "// UNVERIFIED: ninth material unit id (0..860034)."
    }

    field unk11 type="i32::str" {
        key "MVidsUNV"
        doc "// UNVERIFIED: constant 0 across all 1342 rows."
    }
}

json UnitEvoOmniMst {
    doc "Omni Evolution stat awards (wrapper hash K4d9sl4s).  18 rows — keyed by (cost, omni_level)."
    hash "K4d9sl4s"

    field cost type="i32::str" {
        key "gvT2ds0Q"
        doc "Unit cost bracket this row applies to (45..60).  Same hash/name as unit.kdl."
    }

    field omni_level type="i32::str" {
        key "49sa3sld"
        doc "Omni level 1..3."
    }

    field stat_award type="[i32::str]::sep(colon)" {
        key "js95kdsL"
        doc "// UNVERIFIED (named from shape): colon quad of stat gains, e.g. \"150:60:60:60\" .. \"450:180:180:180\" — HP first, then three smaller equal values (ATK/DEF/REC)."
    }

    field unk1 type="i32::str" {
        key "ddD4lsc1"
        doc "// UNVERIFIED: 5 or 10."
    }
}

json UnitEvoOmniTypeMst {
    doc "Omni Evolution step prices (wrapper hash 34d0Slkf).  36 rows."
    hash "34d0Slkf"

    field evo_type type="i32::str" {
        key "s049sdck"
        doc "// UNVERIFIED (named from context): evolution branch, 1 or 2."
    }

    field zel type="i32::str" {
        key "Najhr8m6"
        doc "Zel cost (0..7000000).  Same hash mission.kdl/raid.kdl use for zel amounts."
    }

    field karma type="i32::str" {
        key "HTVh8a65"
        doc "Karma cost (0..3500000).  Same hash/name as mission.kdl."
    }

    field cost type="i32::int" {
        key "gvT2ds0Q"
        doc "Unit cost bracket (45..60).  RAW JSON INT here (`45`, not `\"45\"`) — see the file header.  Same hash/name as unit.kdl."
    }

    field omni_level type="i32::int" {
        key "49sa3sld"
        doc "Omni level 1..3.  RAW JSON INT here."
    }
}

json UnitEvoOmniRecipeMst {
    doc "Omni Evolution material recipes (wrapper hash Odks40sl).  70 rows.  Field names follow mst/dbb.kdl, which uses the same three material hashes."
    hash "Odks40sl"

    field material_type type="str" {
        key "48sldkcm"
        doc "Material kind — \"ITEM\" or \"DUPLICATE\".  A COLON LIST in dbb.kdl; a single token here."
    }

    field material_id type="[i32::str]::sep(comma)" {
        key "0dk4sldr"
        doc "Material ids — comma list (0..800908).  COMMA-separated here; the same hash is colon-separated in dbb.kdl."
    }

    field material_count type="i32::str" {
        key "H6k1LIxC"
        doc "Material count (1..500).  A colon list in dbb.kdl; a plain int here."
    }

    field cost type="i32::int" {
        key "gvT2ds0Q"
        doc "Unit cost bracket (45..60).  RAW JSON INT here — see the file header."
    }

    field omni_level type="i32::int" {
        key "49sa3sld"
        doc "Omni level 1..3.  RAW JSON INT here."
    }

    field evo_type type="i32::int" {
        key "s049sdck"
        doc "// UNVERIFIED: evolution branch 1 or 2 — pairs with UnitEvoOmniTypeMst.evo_type.  RAW JSON INT here, but a STRING in UnitEvoOmniTypeMst."
    }
}
